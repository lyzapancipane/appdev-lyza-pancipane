	<script>
		try
		{
			document.body.classList.add("js");

			const themeButton = document.getElementById("themeButton");
			const themeIcon = document.getElementById("themeIcon");
			const hero = document.querySelector(".hero");
			const heroImage = document.querySelector(".hero-image");
			const navbar = document.querySelector(".navbar");
			const menuButton = document.getElementById("menuButton");
			const backToTop = document.getElementById("backToTop");

			function updateThemeIcon()
			{
				if (document.body.classList.contains("dark-mode"))
				{
					themeIcon.innerHTML = `
						<path d="M21 12.8A9 9 0 0 1 11.2 3 7 7 0 1 0 21 12.8z">
						</path>
					`;
				}
				else
				{
					themeIcon.innerHTML = `
						<path d="M12 3V1m0 22v-2M4.22 4.22 2.81 2.81m18.38 18.38-1.41-1.41M3 12H1m22 0h-2M4.22 19.78l-1.41 1.41M21.19 2.81l-1.41 1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z">
						</path>
					`;
				}
			}

			const savedTheme = localStorage.getItem("edubridge-theme");

			if (savedTheme === "dark")
			{
				document.body.classList.add("dark-mode");
			}

			updateThemeIcon();


			themeButton.addEventListener("click", function()
			{

				const rect = themeButton.getBoundingClientRect();

				document.body.style.setProperty(
					"--theme-x",
					rect.left + rect.width / 2 + "px"
				);

				document.body.style.setProperty(
					"--theme-y",
					rect.top + rect.height / 2 + "px"
				);

				const isCurrentlyDark =
					document.body.classList.contains("dark-mode");

				document.body.style.setProperty(
					"--theme-circle",
					isCurrentlyDark ? "#f3f3f3" : "#090817"
				);

				document.body.classList.add("theme-changing");

				setTimeout(function()
				{

					document.body.classList.toggle("dark-mode");

					const isDark =
						document.body.classList.contains("dark-mode");

					localStorage.setItem(
						"edubridge-theme",
						isDark ? "dark" : "light"
					);

					updateThemeIcon();

				}, 100);

				setTimeout(function()
				{
					document.body.classList.remove("theme-changing");
				}, 750);

			});


			menuButton.addEventListener("click", function()
			{
				const isOpen = navbar.classList.toggle("menu-open");

				menuButton.setAttribute("aria-expanded", String(isOpen));
				menuButton.setAttribute(
					"aria-label",
					isOpen ? "Close navigation menu" : "Open navigation menu"
				);
			});

			function closeMenu()
			{
				navbar.classList.remove("menu-open");
				menuButton.setAttribute("aria-expanded", "false");
				menuButton.setAttribute("aria-label", "Open navigation menu");
			}

			document.querySelectorAll(".nav-links a").forEach(function(link)
			{
				link.addEventListener("click", closeMenu);
			});

			document.addEventListener("keydown", function(event)
			{
				if (event.key === "Escape")
				{
					closeMenu();
				}
			});

			document.addEventListener("click", function(event)
			{
				if (!navbar.contains(event.target))
				{
					closeMenu();
				}
			});

			
			const accountMenu = document.getElementById("accountMenu");

			function createMenuItem(item)
			{
				let el;

				if (item.href)
				{
					el = document.createElement("a");
					el.setAttribute("href", item.href);
				}
				else
				{
					el = document.createElement("button");
					el.setAttribute("type", "button");
				}

				el.className = "account-menu-item";
				el.setAttribute("role", "menuitem");
				el.textContent = item.label;

				if (item.action === "logout")
				{
					el.addEventListener("click", function(event)
					{
						event.preventDefault();
						logOut();
					});
				}
				else if (item.href)
				{
					el.addEventListener("click", closeMenu);
				}

				return el;
			}

			function logOut()
			{
				localStorage.removeItem("edubridge-role");
				window.location.href = "logout.html";
			}

			function buildAccountMenu()
			{
				const role = (localStorage.getItem("edubridge-role") || "").toLowerCase();
				const items = [];

				const announcementChildren = [
					{ label: "All Announcements", href: "announcements.html" },
					{ label: "Create Announcement", href: "createannounce.html" },
					{ label: "Categories", href: "categories.html" }
				];

				if (role !== "teacher" && role !== "student")
				{
					items.push({ label: "Announcement Management", children: announcementChildren });
					items.push({ label: "FAQs Management", href: "faqmanagement.html" });
					items.push({ label: "Inquiries Management", href: "inquirymanagement.html" });
					items.push({ label: "User Management", href: "usermanagement.html" });
					items.push({ label: "Dashboard Analytics", href: "dashboard.html" });
					items.push({ label: "Activity Logs", href: "activitylogs.html" });
					items.push({ label: "Report a Problem", href: "reportproblem.html" });
					items.push({ label: "Log Out", action: "logout" });
				}
				else if (role === "teacher")
				{
					items.push({ label: "Announcement Management", children: announcementChildren });
					items.push({ label: "FAQs Management", href: "faqmanagement.html" });
					items.push({ label: "Inquiries Management", href: "inquirymanagement.html" });
					items.push({ label: "Report a Problem", href: "reportproblem.html" });
					items.push({ label: "Log Out", action: "logout" });
				}
				else if (role === "student")
				{
					items.push({ label: "Profile", href: "profile.html" });
					items.push({ label: "Settings", href: "settings.html" });
					items.push({ label: "Log Out", action: "logout" });
				}

				accountMenu.innerHTML = "";

				const label = document.createElement("div");
				label.className = "account-menu-label";
				label.textContent = role === "teacher" ? "Teacher" : (role === "student" ? "Student" : "Administrator");
				accountMenu.appendChild(label);

				items.forEach(function(item)
				{
					if (item.action === "logout")
					{
						const divider = document.createElement("div");
						divider.className = "account-menu-divider";
						accountMenu.appendChild(divider);
					}

					if (item.children)
					{
						const toggle = document.createElement("button");
						toggle.className = "account-menu-item submenu-parent";
						toggle.type = "button";
						toggle.setAttribute("role", "menuitem");
						toggle.setAttribute("aria-expanded", "false");
						toggle.setAttribute("aria-controls", "announcementSubmenu");
						toggle.textContent = item.label;

						const caret = document.createElement("span");
						caret.className = "submenu-caret";
						caret.setAttribute("aria-hidden", "true");
						caret.innerHTML = '<svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"></path></svg>';
						toggle.appendChild(caret);

						const submenu = document.createElement("div");
						submenu.className = "account-submenu";
						submenu.id = "announcementSubmenu";
						submenu.setAttribute("role", "group");
						submenu.setAttribute("aria-label", item.label);
						submenu.hidden = true;

						item.children.forEach(function(child)
						{
							submenu.appendChild(createMenuItem(child));
						});

						toggle.addEventListener("click", function()
						{
							const isExpanded = toggle.getAttribute("aria-expanded") === "true";
							toggle.setAttribute("aria-expanded", String(!isExpanded));
							submenu.hidden = isExpanded;
						});

						accountMenu.appendChild(toggle);
						accountMenu.appendChild(submenu);
					}
					else
					{
						accountMenu.appendChild(createMenuItem(item));
					}
				});
			}

			function applyNavProfile()
			{
				const profile = document.querySelector(".nav-profile");

				if (!profile)
				{
					return;
				}

				const role = (localStorage.getItem("edubridge-role") || "").toLowerCase();
				const img = profile.querySelector("img");
				const name = profile.querySelector(".nav-profile-text strong");
				const roleText = profile.querySelector(".nav-profile-text small");

				if (role === "student" || role === "teacher")
				{
					img.src = "junior.jpg";
					img.alt = "Junior Slickback";
					name.textContent = "Junior Slickback";
					roleText.textContent = "Student";
					profile.setAttribute("href", "inquiries.html");
				}
				else
				{
					img.src = "resume.jpg";
					img.alt = "Resume Dizon";
					name.textContent = "Resume Dizon";
					roleText.textContent = "Administrator";
					profile.setAttribute("href", "profile.html");
				}
			}

			buildAccountMenu();
			applyNavProfile();

			function updateNavbar()
			{

				if (window.scrollY > 40)
				{
					navbar.classList.add("scrolled");
				}
				else
				{
					navbar.classList.remove("scrolled");
				}

			}

			updateNavbar();

			window.addEventListener("scroll", updateNavbar);


			let targetX = 50;
			let targetY = 50;

			let cursorX = 50;
			let cursorY = 50;

			let purpleX = 4;
			let purpleY = 5;

			let blueX = 93;
			let blueY = 8;

			let pinkX = 15;
			let pinkY = 57;

			let violetX = 55;
			let violetY = 38;

			let orangeX = 94;
			let orangeY = 88;

			let cyanX = 5;
			let cyanY = 93;

			let pinkSmallX = 78;
			let pinkSmallY = 67;


			hero.addEventListener("mousemove", function(event)
			{

				const rect = hero.getBoundingClientRect();

				targetX =
					((event.clientX - rect.left) / rect.width) * 100;

				targetY =
					((event.clientY - rect.top) / rect.height) * 100;

				const moveX =
					(event.clientX - rect.left) / rect.width - 0.5;

				const moveY =
					(event.clientY - rect.top) / rect.height - 0.5;

				heroImage.style.transform =
					`scale(1.04) translate(${moveX * -10}px, ${moveY * -7}px)`;

			});


			hero.addEventListener("mouseleave", function()
			{

				targetX = 50;
				targetY = 50;

				heroImage.style.transform =
					"scale(1.04) translate(0, 0)";

			});


			function animateGradient()
			{

				cursorX +=
					(targetX - cursorX) * 0.04;

				cursorY +=
					(targetY - cursorY) * 0.04;


				const purpleTargetX =
					4 + (cursorX - 50) * 0.35;

				const purpleTargetY =
					5 + (cursorY - 50) * 0.25;


				const blueTargetX =
					93 + (cursorX - 50) * 0.3;

				const blueTargetY =
					8 + (cursorY - 50) * 0.25;


				const pinkTargetX =
					15 + (cursorX - 50) * 0.5;

				const pinkTargetY =
					57 + (cursorY - 50) * 0.45;


				const violetTargetX =
					55 + (cursorX - 50) * 0.65;

				const violetTargetY =
					38 + (cursorY - 50) * 0.55;


				const orangeTargetX =
					94 + (cursorX - 50) * 0.3;

				const orangeTargetY =
					88 + (cursorY - 50) * 0.35;


				const cyanTargetX =
					5 + (cursorX - 50) * 0.28;

				const cyanTargetY =
					93 + (cursorY - 50) * 0.25;


				const pinkSmallTargetX =
					78 + (cursorX - 50) * 0.48;

				const pinkSmallTargetY =
					67 + (cursorY - 50) * 0.42;


				purpleX +=
					(purpleTargetX - purpleX) * 0.025;

				purpleY +=
					(purpleTargetY - purpleY) * 0.025;


				blueX +=
					(blueTargetX - blueX) * 0.02;

				blueY +=
					(blueTargetY - blueY) * 0.02;


				pinkX +=
					(pinkTargetX - pinkX) * 0.022;

				pinkY +=
					(pinkTargetY - pinkY) * 0.022;


				violetX +=
					(violetTargetX - violetX) * 0.018;

				violetY +=
					(violetTargetY - violetY) * 0.018;


				orangeX +=
					(orangeTargetX - orangeX) * 0.021;

				orangeY +=
					(orangeTargetY - orangeY) * 0.021;


				cyanX +=
					(cyanTargetX - cyanX) * 0.019;

				cyanY +=
					(cyanTargetY - cyanY) * 0.019;


				pinkSmallX +=
					(pinkSmallTargetX - pinkSmallX) * 0.023;

				pinkSmallY +=
					(pinkSmallTargetY - pinkSmallY) * 0.023;


				hero.style.setProperty(
					"--purple-x",
					purpleX + "%"
				);

				hero.style.setProperty(
					"--purple-y",
					purpleY + "%"
				);

				hero.style.setProperty(
					"--blue-x",
					blueX + "%"
				);

				hero.style.setProperty(
					"--blue-y",
					blueY + "%"
				);

				hero.style.setProperty(
					"--pink-x",
					pinkX + "%"
				);

				hero.style.setProperty(
					"--pink-y",
					pinkY + "%"
				);

				hero.style.setProperty(
					"--violet-x",
					violetX + "%"
				);

				hero.style.setProperty(
					"--violet-y",
					violetY + "%"
				);

				hero.style.setProperty(
					"--orange-x",
					orangeX + "%"
				);

				hero.style.setProperty(
					"--orange-y",
					orangeY + "%"
				);

				hero.style.setProperty(
					"--cyan-x",
					cyanX + "%"
				);

				hero.style.setProperty(
					"--cyan-y",
					cyanY + "%"
				);

				hero.style.setProperty(
					"--pink-small-x",
					pinkSmallX + "%"
				);

				hero.style.setProperty(
					"--pink-small-y",
					pinkSmallY + "%"
				);

				requestAnimationFrame(animateGradient);

			}

			animateGradient();


			let audioContext;

			function playClickSound()
			{

				try
				{

					if (!audioContext)
					{
						audioContext =
							new (
								window.AudioContext ||
								window.webkitAudioContext
							)();
					}

					if (audioContext.state === "suspended")
					{
						audioContext.resume();
					}

					const oscillator =
						audioContext.createOscillator();

					const gain =
						audioContext.createGain();

					oscillator.type = "sine";

					oscillator.frequency.setValueAtTime(
						520,
						audioContext.currentTime
					);

					oscillator.frequency.exponentialRampToValueAtTime(
						300,
						audioContext.currentTime + 0.045
					);

					gain.gain.setValueAtTime(
						0.045,
						audioContext.currentTime
					);

					gain.gain.exponentialRampToValueAtTime(
						0.001,
						audioContext.currentTime + 0.06
					);

					oscillator.connect(gain);
					gain.connect(audioContext.destination);

					oscillator.start();

					oscillator.stop(
						audioContext.currentTime + 0.06
					);

				}
				catch (error)
				{
				}

			}


			document.addEventListener("click", function(event)
			{

				const clickable =
					event.target.closest(
						"button, a, .mission-item"
					);

				if (clickable)
				{
					playClickSound();
				}

			});


			const revealItems =
				document.querySelectorAll(".reveal");

			const revealObserver =
				new IntersectionObserver(
					function(entries)
					{

						entries.forEach(function(entry)
						{

							if (entry.isIntersecting)
							{

								entry.target.classList.add("visible");

								revealObserver.unobserve(
									entry.target
								);

							}

						});

					},
					{
						threshold: 0.12
					}
				);


			revealItems.forEach(function(item)
			{
				revealObserver.observe(item);
			});


			const cursorGradient =
				document.querySelector(".cursor-gradient");

			let cursorMouseX =
				window.innerWidth / 2;

			let cursorMouseY =
				window.innerHeight / 2;

			let gradientX =
				cursorMouseX;

			let gradientY =
				cursorMouseY;


			document.addEventListener("mousemove", function(event)
			{

				cursorMouseX =
					event.clientX;

				cursorMouseY =
					event.clientY;

				document.body.classList.add(
					"cursor-ready"
				);

			});


			function moveCursorGradient()
			{

				gradientX +=
					(cursorMouseX - gradientX) * 0.12;

				gradientY +=
					(cursorMouseY - gradientY) * 0.12;

				cursorGradient.style.left =
					gradientX + "px";

				cursorGradient.style.top =
					gradientY + "px";

				requestAnimationFrame(
					moveCursorGradient
				);

			}

			moveCursorGradient();


			window.addEventListener("scroll", function()
			{

				if (window.scrollY > 450)
				{
					backToTop.classList.add("show");
				}
				else
				{
					backToTop.classList.remove("show");
				}

			});


			backToTop.addEventListener("click", function()
			{

				window.scrollTo({
					top: 0,
					behavior: "smooth"
				});

			});

			const themeLight = document.getElementById("themeLight");
			const themeDark = document.getElementById("themeDark");
			const themeSystem = document.getElementById("themeSystem");
			const themeMedia = window.matchMedia("(prefers-color-scheme: dark)");

			let themeMode = localStorage.getItem("edubridge-theme-mode");

			if (themeMode !== "light" && themeMode !== "dark" && themeMode !== "system")
			{
				themeMode = "light";
			}

			function resolveThemeMode()
			{
				if (themeMode === "system")
				{
					return themeMedia.matches ? "dark" : "light";
				}

				return themeMode;
			}

			function applyThemeMode()
			{
				const resolved = resolveThemeMode();

				document.body.classList.toggle("dark-mode", resolved === "dark");

				localStorage.setItem("edubridge-theme", resolved);

				themeLight.setAttribute("aria-pressed", themeMode === "light" ? "true" : "false");
				themeDark.setAttribute("aria-pressed", themeMode === "dark" ? "true" : "false");
				themeSystem.setAttribute("aria-pressed", themeMode === "system" ? "true" : "false");

				updateThemeIcon();
			}

			function setThemeMode(next)
			{
				themeMode = next;

				try
				{
					localStorage.setItem("edubridge-theme-mode", themeMode);
				}
				catch (error)
				{
					showSettingsToast("This browser could not store that preference.");
				}

				applyThemeMode();
			}

			themeLight.addEventListener("click", function()
			{
				setThemeMode("light");
			});

			themeDark.addEventListener("click", function()
			{
				setThemeMode("dark");
			});

			themeSystem.addEventListener("click", function()
			{
				setThemeMode("system");
			});

			if (typeof themeMedia.addEventListener === "function")
			{
				themeMedia.addEventListener("change", function()
				{
					if (themeMode === "system")
					{
						applyThemeMode();
					}
				});
			}

			themeButton.addEventListener("click", function()
			{
				setTimeout(function()
				{
					setThemeMode(document.body.classList.contains("dark-mode") ? "dark" : "light");
				}, 150);
			});

			applyThemeMode();

			const settingsTabs = Array.from(document.querySelectorAll(".settings-tab"));
			const settingsPanels = Array.from(document.querySelectorAll(".settings-panel"));
			const settingsRole = (localStorage.getItem("edubridge-role") || "").toLowerCase();
			const settingsStudentLike = settingsRole === "student" || settingsRole === "teacher";
			const officialName = settingsStudentLike ? "Junior Slickback" : "Resume Dizon";
			const officialRole = settingsStudentLike ? "Student" : "Administrator";
			const defaultAvatar = settingsStudentLike ? "junior.jpg" : "resume.jpg";
			const MAX_IMAGE_BYTES = 2 * 1024 * 1024;

			function activateSettingsPanel(name)
			{
				settingsTabs.forEach(function(tab)
				{
					const isActive = tab.dataset.panel === name;

					tab.setAttribute("aria-selected", isActive ? "true" : "false");
					tab.tabIndex = isActive ? 0 : -1;
				});

				settingsPanels.forEach(function(panel)
				{
					panel.hidden = panel.id !== "panel-" + name;
				});
			}

			settingsTabs.forEach(function(tab, index)
			{
				tab.addEventListener("click", function()
				{
					activateSettingsPanel(tab.dataset.panel);
				});

				tab.addEventListener("keydown", function(event)
				{
					let next = index;

					if (event.key === "ArrowRight")
					{
						next = (index + 1) % settingsTabs.length;
					}
					else if (event.key === "ArrowLeft")
					{
						next = (index - 1 + settingsTabs.length) % settingsTabs.length;
					}
					else if (event.key === "Home")
					{
						next = 0;
					}
					else if (event.key === "End")
					{
						next = settingsTabs.length - 1;
					}
					else
					{
						return;
					}

					event.preventDefault();
					settingsTabs[next].focus();
					activateSettingsPanel(settingsTabs[next].dataset.panel);
				});
			});

			const pageToast = document.getElementById("pageToast");
			let pageToastTimer = null;

			function showSettingsToast(message)
			{
				pageToast.textContent = message;
				pageToast.hidden = false;

				clearTimeout(pageToastTimer);

				pageToastTimer = setTimeout(function()
				{
					pageToast.hidden = true;
				}, 4200);
			}

			document.getElementById("accountName").textContent = officialName;
			document.getElementById("accountRole").textContent = officialRole;
			document.getElementById("profileOfficialName").textContent = officialName;
			document.getElementById("profileOfficialRole").textContent = officialRole;

			const displayAvatar = document.getElementById("displayAvatar");
			const avatarPreview = document.getElementById("avatarPreview");

			displayAvatar.src = defaultAvatar;
			displayAvatar.alt = officialName;
			avatarPreview.src = defaultAvatar;
			avatarPreview.alt = officialName;

			const notifToggles = Array.from(document.querySelectorAll(".pref-toggle input"));

			function loadNotifPreferences()
			{
				try
				{
					return JSON.parse(localStorage.getItem("edubridge-notifications")) || {};
				}
				catch (error)
				{
					return {};
				}
			}

			const savedNotif = loadNotifPreferences();

			notifToggles.forEach(function(toggle)
			{
				if (typeof savedNotif[toggle.id] === "boolean")
				{
					toggle.checked = savedNotif[toggle.id];
				}

				toggle.addEventListener("change", function()
				{
					const prefs = {};

					notifToggles.forEach(function(item)
					{
						prefs[item.id] = item.checked;
					});

					try
					{
						localStorage.setItem("edubridge-notifications", JSON.stringify(prefs));
					}
					catch (error)
					{
						showSettingsToast("This browser could not store the notification preferences.");
					}
				});
			});

			const defaultVisibility = document.getElementById("defaultVisibility");
			const defaultAudience = document.getElementById("defaultAudience");
			const defaultYearField = document.getElementById("defaultYearField");
			const defaultYear = document.getElementById("defaultYear");
			const defaultProgramField = document.getElementById("defaultProgramField");
			const defaultProgram = document.getElementById("defaultProgram");
			const defaultTiming = document.getElementById("defaultTiming");
			const defaultScheduleField = document.getElementById("defaultScheduleField");
			const defaultDate = document.getElementById("defaultDate");
			const defaultTime = document.getElementById("defaultTime");
			const saveDefaults = document.getElementById("saveDefaults");

			function updateDefaultsFields()
			{
				defaultYearField.hidden = defaultAudience.value !== "year";
				defaultProgramField.hidden = defaultAudience.value !== "program";
				defaultScheduleField.hidden = defaultTiming.value !== "scheduled";
			}

			function loadAnnouncementDefaults()
			{
				try
				{
					return JSON.parse(localStorage.getItem("edubridge-announce-defaults")) || {};
				}
				catch (error)
				{
					return {};
				}
			}

			const savedDefaults = loadAnnouncementDefaults();

			if (savedDefaults.visibility === "Public" || savedDefaults.visibility === "Private")
			{
				defaultVisibility.value = savedDefaults.visibility;
			}

			if (savedDefaults.audience === "all" || savedDefaults.audience === "year" || savedDefaults.audience === "program")
			{
				defaultAudience.value = savedDefaults.audience;
			}

			if (typeof savedDefaults.year === "string")
			{
				defaultYear.value = savedDefaults.year;
			}

			if (typeof savedDefaults.program === "string")
			{
				defaultProgram.value = savedDefaults.program.slice(0, 40);
			}

			if (savedDefaults.timing === "scheduled")
			{
				defaultTiming.value = "scheduled";
			}

			defaultDate.value = typeof savedDefaults.date === "string" ? savedDefaults.date : "";
			defaultTime.value = typeof savedDefaults.time === "string" ? savedDefaults.time : "";
			defaultDate.min = new Date().toISOString().slice(0, 10);

			updateDefaultsFields();

			defaultAudience.addEventListener("change", updateDefaultsFields);
			defaultTiming.addEventListener("change", updateDefaultsFields);

			saveDefaults.addEventListener("click", function()
			{
				const payload =
				{
					visibility: defaultVisibility.value,
					audience: defaultAudience.value,
					year: defaultYear.value,
					program: defaultProgram.value.trim().slice(0, 40),
					timing: defaultTiming.value,
					date: defaultTiming.value === "scheduled" ? defaultDate.value : "",
					time: defaultTiming.value === "scheduled" ? defaultTime.value : ""
				};

				try
				{
					localStorage.setItem("edubridge-announce-defaults", JSON.stringify(payload));
				}
				catch (error)
				{
					showSettingsToast("This browser could not store the announcement defaults.");
					return;
				}

				showSettingsToast("Defaults saved.");
			});

			const nicknameInput = document.getElementById("nicknameInput");
			const bioInput = document.getElementById("bioInput");
			const bioCounter = document.getElementById("bioCounter");
			const displayName = document.getElementById("displayName");
			const avatarInput = document.getElementById("avatarInput");
			const avatarUploadBtn = document.getElementById("avatarUploadBtn");
			const avatarRemoveBtn = document.getElementById("avatarRemoveBtn");
			const coverImage = document.getElementById("coverImage");
			const coverInput = document.getElementById("coverInput");
			const coverUploadBtn = document.getElementById("coverUploadBtn");
			const coverRemoveBtn = document.getElementById("coverRemoveBtn");
			const savePersonalization = document.getElementById("savePersonalization");

			let pendingAvatar = null;
			let pendingCover = null;

			function renderNickname(value)
			{
				const trimmed = value.trim();

				displayName.textContent = trimmed || officialName;
			}

			function renderAvatar(value)
			{
				const src = value || defaultAvatar;

				avatarPreview.src = src;
				displayAvatar.src = src;
				avatarRemoveBtn.hidden = !value;
			}

			function renderCover(value)
			{
				coverImage.hidden = !value;

				if (value)
				{
					coverImage.src = value;
				}
				else
				{
					coverImage.removeAttribute("src");
				}

				coverRemoveBtn.hidden = !value;
			}

			function renderBioCounter()
			{
				bioCounter.textContent = bioInput.value.length + " / 160 characters";
			}

			nicknameInput.value = localStorage.getItem("edubridge-nickname") || "";
			bioInput.value = localStorage.getItem("edubridge-bio") || "";

			renderNickname(nicknameInput.value);
			renderAvatar(localStorage.getItem("edubridge-avatar") || "");
			renderCover(localStorage.getItem("edubridge-cover") || "");
			renderBioCounter();

			nicknameInput.addEventListener("input", function()
			{
				renderNickname(nicknameInput.value);
			});

			bioInput.addEventListener("input", renderBioCounter);

			function readImageFile(input, onLoaded)
			{
				const file = input.files && input.files[0];

				if (!file)
				{
					return;
				}

				if (file.type !== "image/jpeg" && file.type !== "image/png")
				{
					showSettingsToast("Only JPG and PNG images are supported.");
					input.value = "";
					return;
				}

				if (file.size > MAX_IMAGE_BYTES)
				{
					showSettingsToast("That image is too large. The maximum size is 2MB.");
					input.value = "";
					return;
				}

				const reader = new FileReader();

				reader.onload = function()
				{
					onLoaded(reader.result);
				};

				reader.readAsDataURL(file);
			}

			avatarUploadBtn.addEventListener("click", function()
			{
				avatarInput.click();
			});

			avatarInput.addEventListener("change", function()
			{
				readImageFile(avatarInput, function(dataUrl)
				{
					pendingAvatar = dataUrl;
					renderAvatar(dataUrl);
				});
			});

			avatarRemoveBtn.addEventListener("click", function()
			{
				pendingAvatar = "";
				renderAvatar("");
			});

			coverUploadBtn.addEventListener("click", function()
			{
				coverInput.click();
			});

			coverInput.addEventListener("change", function()
			{
				readImageFile(coverInput, function(dataUrl)
				{
					pendingCover = dataUrl;
					renderCover(dataUrl);
				});
			});

			coverRemoveBtn.addEventListener("click", function()
			{
				pendingCover = "";
				renderCover("");
			});

			savePersonalization.addEventListener("click", function()
			{
				const nickname = nicknameInput.value.trim().slice(0, 30);
				const bio = bioInput.value.slice(0, 160);

				try
				{
					localStorage.setItem("edubridge-nickname", nickname);
					localStorage.setItem("edubridge-bio", bio);

					if (pendingAvatar !== null)
					{
						if (pendingAvatar)
						{
							localStorage.setItem("edubridge-avatar", pendingAvatar);
						}
						else
						{
							localStorage.removeItem("edubridge-avatar");
						}
					}

					if (pendingCover !== null)
					{
						if (pendingCover)
						{
							localStorage.setItem("edubridge-cover", pendingCover);
						}
						else
						{
							localStorage.removeItem("edubridge-cover");
						}
					}
				}
				catch (error)
				{
					showSettingsToast("This browser could not store those images. Try smaller JPG or PNG files under 2MB.");
					return;
				}

				pendingAvatar = null;
				pendingCover = null;

				nicknameInput.value = nickname;
				bioInput.value = bio;

				renderNickname(nickname);
				renderBioCounter();

				showSettingsToast("Changes saved.");
			});

		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>

</body>
