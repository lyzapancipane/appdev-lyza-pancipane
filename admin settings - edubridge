					width: 100%;
					height: 100%;
					object-fit: cover;
					display: block;
			}

			.display-preview
			{
					display: flex;
					align-items: center;
					gap: 14px;
					padding: 14px 16px;
					border: 1px solid var(--border);
					border-radius: 12px;
					background: var(--surface-soft);
					margin-bottom: 20px;
			}

			.display-preview img
			{
					width: 46px;
					height: 46px;
					border-radius: 50%;
					object-fit: cover;
					border: 2px solid var(--purple-light);
			}

			.display-preview small
			{
					display: block;
					font-size: 11.5px;
					color: var(--text-muted);
					margin-bottom: 2px;
			}

			.display-preview strong
			{
					font-size: 15px;
					color: var(--text);
			}

			.avatar-row
			{
					display: flex;
					align-items: center;
					gap: 16px;
					flex-wrap: wrap;
			}

			.avatar-preview
