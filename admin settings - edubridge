					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
					gap: 14px;
			}

			.cover-preview
			{
					position: relative;
					height: 170px;
					border-radius: 12px;
					overflow: hidden;
					border: 1px solid var(--border);
					background:
							radial-gradient(circle at 22% 28%, rgba(113, 56, 200, 0.4), transparent 55%),
