			let selectedGroup = "all";

			function createAnnouncementCard(announcement)
			{
				const card = document.createElement("a");
				card.className = "announcement-card";
				card.href = "announcedetails.html?id=" + encodeURIComponent(announcement.id);
				card.dataset.category = announcement.category;

				const top = document.createElement("span");
				top.className = "card-top";

				const icon = document.createElement("span");
				icon.className = "announcement-icon";
				icon.dataset.tone = announcement.tone;
				icon.innerHTML = icons[announcement.icon];

				const category = document.createElement("span");
				category.className = "card-category";
				category.textContent = announcement.category;

				top.append(icon, category);

				const title = document.createElement("h3");
				title.textContent = announcement.title;

				const description = document.createElement("p");
				description.textContent = announcement.description;

				const footer = document.createElement("span");
				footer.className = "card-footer";

				const meta = document.createElement("time");
				meta.className = "card-meta";
				meta.dateTime = announcement.dateTime;
				meta.textContent = announcement.date + " · " + announcement.time;

				const link = document.createElement("span");
				link.className = "card-link";
				link.append(document.createTextNode("Read Announcement "));

				const arrow = document.createElement("span");
				arrow.innerHTML = icons.arrow;
				arrow.style.display = "contents";
				link.append(arrow);

				footer.append(meta, link);
				card.append(top, title, description, footer);

				return card;
			}

			function matchesAnnouncement(announcement)
			{
				const query = announcementSearch.value.trim().toLowerCase();

				const searchText = [
					announcement.title,
					announcement.description,
					announcement.category
				].join(" ").toLowerCase();

				const matchesSearch = !query || searchText.includes(query);
				const matchesGroup = selectedGroup === "all" || announcement.groups.includes(selectedGroup);
				const matchesType = typeFilter.value === "all" || announcement.category === typeFilter.value;

				return matchesSearch && matchesGroup && matchesType;
			}

			function renderAnnouncements()
			{
				const filteredAnnouncements = announcements.filter(matchesAnnouncement);

				announcementList.replaceChildren();

				filteredAnnouncements.forEach(function(announcement)
				{
					announcementList.append(createAnnouncementCard(announcement));
				});

				emptyState.hidden = filteredAnnouncements.length > 0;

				resultsSummary.textContent = filteredAnnouncements.length +
					(filteredAnnouncements.length === 1 ? " announcement" : " announcements");
			}

			function createEventCard(eventItem)
			{
				const card = document.createElement("a");
				card.className = "event-card";
				card.href = "announcedetails.html?id=" + encodeURIComponent(eventItem.id);

				const badge = document.createElement("span");
				badge.className = "event-date-badge";

				const day = document.createElement("strong");
				day.textContent = eventItem.day;

				const month = document.createElement("span");
				month.textContent = eventItem.month;

				badge.append(day, month);

				const copy = document.createElement("span");
				copy.className = "event-copy";

				const title = document.createElement("strong");
				title.textContent = eventItem.title;

				const date = document.createElement("time");
				date.textContent = eventItem.date;

				const eventTime = document.createElement("span");
				eventTime.className = "event-time";

				const clock = document.createElement("span");
				clock.className = "clock-icon";
				clock.setAttribute("aria-hidden", "true");

				eventTime.append(clock, document.createTextNode(eventItem.time));
				copy.append(title, date, eventTime);
				card.append(badge, copy);

				return card;
			}

			function renderEvents()
			{
				eventsList.replaceChildren();

				upcomingEvents.forEach(function(eventItem)
				{
					eventsList.append(createEventCard(eventItem));
				});
			}

			function updateCategorySelection(group)
			{
				selectedGroup = group;

				document.querySelectorAll("[data-filter-group]").forEach(function(button)
				{
					const active = button.dataset.filterGroup === group;
					button.classList.toggle("active", active);
					button.setAttribute("aria-pressed", String(active));
				});

				renderAnnouncements();
			}

			function clearAllFilters()
			{
				announcementSearch.value = "";
				typeFilter.value = "all";
				updateCategorySelection("all");
				filterPanel.hidden = true;
				filterButton.setAttribute("aria-expanded", "false");
			}

			document.querySelectorAll("[data-filter-group]").forEach(function(button)
			{
				button.addEventListener("click", function()
				{
					updateCategorySelection(button.dataset.filterGroup);
				});
			});

			announcementSearch.addEventListener("input", renderAnnouncements);
			typeFilter.addEventListener("change", renderAnnouncements);

