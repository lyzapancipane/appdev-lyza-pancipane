<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>
		Announcements | EduBridge
	</title>
	<style>
		*
		{
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		:root
		{
			--background: #f3f3f3;
			--surface: #ffffff;
			--surface-soft: #faf9fc;
			--text: #17152d;
			--text-soft: #696774;
			--text-muted: #77737e;
			--border: #e1e1e1;
			--purple: #7138c8;
			--purple-light: #eee5ff;
			--purple-soft: #eadcff;
			--shadow: rgba(40, 24, 75, 0.08);
			--mission-text: #eee8f6;
		}

		body.dark-mode
		{
			--background: #090817;
			--surface: #131124;
			--surface-soft: #18162b;
			--text: #f7f3ff;
			--text-soft: #c4bfd2;
			--text-muted: #9e99ae;
			--border: #2d2941;
			--purple: #a970ff;
			--purple-light: #251b3b;
			--purple-soft: #241934;
			--shadow: rgba(0, 0, 0, 0.35);
		}

		html
		{
			scroll-behavior: smooth;
		}

		body
		{
			font-family: Poppins, Arial, sans-serif;
			color: var(--text);
			background: var(--background);
			overflow-x: hidden;
			transition: background 0.45s ease, color 0.45s ease;
		}

		body.dark-mode
		{
			background:
				radial-gradient(
					circle at 12% 10%,
					rgba(113, 56, 200, 0.12),
					transparent 28%
				),
				radial-gradient(
					circle at 88% 45%,
					rgba(68, 72, 190, 0.08),
					transparent 30%
				),
				#090817;
		}

		a
		{
			color: inherit;
			text-decoration: none;
		}

		button,
		input,
		select
		{
			font: inherit;
		}

		button
		{
			font-family: inherit;
			cursor: pointer;
		}

		button:focus-visible,
		a:focus-visible,
		input:focus-visible,
		select:focus-visible
		{
			outline: 2px solid #a970ff;
			outline-offset: 2px;
		}

		[hidden]
		{
			display: none !important;
		}

		body.theme-changing::before
		{
			content: "";
			position: fixed;
			width: 30px;
			height: 30px;
			left: var(--theme-x);
			top: var(--theme-y);
			transform: translate(-50%, -50%) scale(0);
			border-radius: 50%;
			background: var(--theme-circle);
			z-index: 9999;
			pointer-events: none;
			animation: themeReveal 0.65s ease-out forwards;
		}

		@keyframes themeReveal
		{
			0%
			{
				transform: translate(-50%, -50%) scale(0);
				opacity: 0.35;
			}

			100%
			{
				transform: translate(-50%, -50%) scale(100);
				opacity: 0;
			}
		}

		.cursor-gradient
		{
			position: fixed;
			width: 500px;
			height: 500px;
			left: 0;
			top: 0;
			transform: translate(-50%, -50%);
			border-radius: 50%;
			pointer-events: none;
			z-index: 9998;
			opacity: 0;
			background:
				radial-gradient(
					circle,
					rgba(185, 120, 255, 0.16) 0%,
					rgba(86, 105, 255, 0.10) 28%,
					rgba(225, 80, 160, 0.06) 48%,
					transparent 72%
				);
			filter: blur(32px);
			transition: opacity 0.35s ease;
		}

		body.cursor-ready .cursor-gradient
		{
			opacity: 1;
		}

		body.dark-mode .cursor-gradient
		{
			background:
				radial-gradient(
					circle,
					rgba(174, 112, 255, 0.23) 0%,
					rgba(88, 103, 255, 0.14) 30%,
					rgba(228, 78, 173, 0.08) 50%,
					transparent 73%
				);
		}

		.navbar
		{
			height: 88px;
			padding: 0 36px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 20;
			color: white;
			transition:
				height 0.3s ease,
				background 0.3s ease,
				box-shadow 0.3s ease,
				backdrop-filter 0.3s ease;
		}

		.navbar.scrolled
		{
			height: 72px;
			background: rgba(8, 5, 29, 0.82);
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
			backdrop-filter: blur(14px);
		}

		.logo
		{
			display: flex;
			align-items: center;
			gap: 2px;
			font-size: 18px;
			font-weight: 600;
			white-space: nowrap;
		}

		.logo img
		{
			width: 90px;
			height: 90px;
			object-fit: contain;
			flex-shrink: 0;
			transition: transform 0.3s ease;
		}

		.logo:hover img
		{
			transform: rotate(-4deg) scale(1.04);
		}

		.brand-name
		{
			display: flex;
			align-items: center;
			margin-left: -3px;
			letter-spacing: -0.4px;
		}

		.brand-edu
		{
			color: white;
		}

		.brand-bridge
		{
			color: #7339c2;
		}

		.nav-links
		{
			display: flex;
			align-items: center;
			gap: 28px;
			font-size: 13px;
		}

		.nav-links a
		{
			position: relative;
			color: #ffffffdd;
			transition: 0.2s;
		}

		.nav-links a::after
		{
			content: "";
			position: absolute;
			left: 50%;
			bottom: -7px;
			width: 0;
			height: 2px;
			border-radius: 10px;
			background: #b77aff;
			transform: translateX(-50%);
			transition: width 0.25s ease;
		}

		.nav-links a:hover,
		.nav-links .active
		{
			color: #c58cff;
		}

		.nav-links a:hover::after,
		.nav-links .active::after
		{
			width: 100%;
		}

		.nav-buttons
		{
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.theme-button,
		.login-button
		{
			height: 34px;
			border: 1px solid #ffffff55;
			border-radius: 5px;
			background: #ffffff12;
			color: white;
			transition: 0.25s ease;
		}

		.menu-button
		{
			display: none;
			width: 34px;
			height: 34px;
			align-items: center;
			justify-content: center;
			border: 1px solid #ffffff55;
			border-radius: 5px;
			background: #ffffff12;
			color: white;
			transition: 0.25s ease;
		}

		.theme-button
		{
			width: 34px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.theme-button:hover,
		.menu-button:hover
		{
			background: #ffffff20;
			border-color: #ffffff88;
			transform: translateY(-2px) rotate(8deg);
		}

		.theme-button:active
		{
			transform: scale(0.88);
		}

		.menu-button:active
		{
			transform: scale(0.88);
		}

		.theme-button svg,
		.menu-button svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
		}

		.login-button
		{
			display: inline-flex;
			padding: 0 15px;
			align-items: center;
			justify-content: center;
			font-size: 12px;
		}

		.login-button:hover
		{
			background: #7138c8;
			border-color: #a970ff;
			transform: translateY(-2px);
		}

		.login-button:active
		{
			transform: scale(0.96);
		}

		.nav-profile
		{
			display: flex;
			align-items: center;
			gap: 8px;
			color: #ffffffdd;
			font-size: 12px;
			white-space: nowrap;
		}

		.nav-profile img
		{
			width: 34px;
			height: 34px;
			border: 1px solid #ffffff55;
			border-radius: 50%;
			object-fit: cover;
		}

		.hero
		{
			min-height: 470px;
			padding: 130px 36px 70px;
			display: flex;
			align-items: center;
			position: relative;
			overflow: hidden;
			isolation: isolate;
			background: #08051d;
		}

		.hero-image
		{
			position: absolute;
			inset: 0;
			z-index: -10;
			background-image: url("Edubridge-Hero-About.png");
			background-size: cover;
			background-position: center;
			opacity: 0.62;
			transform: scale(1.04);
			transition: transform 0.25s ease-out;
		}

		.hero-base
		{
			position: absolute;
			inset: 0;
			z-index: -9;
			background:
				linear-gradient(
					135deg,
					rgba(5, 5, 35, 0.7),
					rgba(14, 4, 40, 0.32),
					rgba(5, 5, 30, 0.65)
				);
		}

		.gradient-layer
		{
			position: absolute;
			inset: 0;
			z-index: -8;
			overflow: hidden;
			pointer-events: none;
		}

		.gradient
		{
			position: absolute;
			border-radius: 50%;
			filter: blur(65px);
			mix-blend-mode: screen;
			opacity: 0.72;
		}

		.gradient-purple
		{
			width: 430px;
			height: 430px;
			background: #7138c8;
			left: var(--purple-x, 4%);
			top: var(--purple-y, 5%);
			animation: purpleFloat 12s ease-in-out infinite alternate;
		}

		.gradient-blue
		{
			width: 390px;
			height: 390px;
			background: #315ee8;
			left: var(--blue-x, 93%);
			top: var(--blue-y, 8%);
			animation: blueFloat 14s ease-in-out infinite alternate;
		}

		.gradient-pink
		{
			width: 360px;
			height: 360px;
			background: #d94f91;
			left: var(--pink-x, 15%);
			top: var(--pink-y, 57%);
			animation: pinkFloat 13s ease-in-out infinite alternate;
		}

		.gradient-violet
		{
			width: 430px;
			height: 430px;
			background: #933cff;
			left: var(--violet-x, 55%);
			top: var(--violet-y, 38%);
			animation: violetFloat 15s ease-in-out infinite alternate;
		}

		.gradient-orange
		{
			width: 400px;
			height: 400px;
			background: #e69a42;
			left: var(--orange-x, 94%);
			top: var(--orange-y, 88%);
			animation: orangeFloat 11s ease-in-out infinite alternate;
		}

		.gradient-cyan
		{
			width: 340px;
			height: 340px;
			background: #387ee8;
			left: var(--cyan-x, 5%);
			top: var(--cyan-y, 93%);
			animation: cyanFloat 16s ease-in-out infinite alternate;
		}

		.gradient-pink-small
		{
			width: 270px;
			height: 270px;
			background: #b73fbd;
			left: var(--pink-small-x, 78%);
			top: var(--pink-small-y, 67%);
			animation: smallPinkFloat 12s ease-in-out infinite alternate;
		}

		.hero-overlay
		{
			position: absolute;
			inset: 0;
			z-index: -6;
			pointer-events: none;
			background:
				linear-gradient(
					90deg,
					rgba(5, 5, 35, 0.58),
					rgba(10, 5, 35, 0.12),
					rgba(5, 5, 35, 0.52)
				);
		}

		.hero-content
		{
			width: 100%;
			max-width: 1180px;
			margin: 0 auto;
			position: relative;
			z-index: 5;
		}

		.hero-label
		{
			color: #c18cff;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 1px;
			margin-bottom: 12px;
		}

		.hero h1
		{
			color: white;
			font-size: 52px;
			line-height: 1.1;
			font-weight: 600;
			margin-bottom: 18px;
		}

		.hero h1 span
		{
			color: #b77aff;
		}

		.hero p
		{
			max-width: 650px;
			color: #d5d1df;
			font-size: 15px;
			line-height: 1.8;
		}

		.hero-actions
		{
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 10px;
			margin-top: 24px;
		}

		.question-button
		{
			display: inline-flex;
			height: 32px;
			align-items: center;
			justify-content: center;
			padding: 0 14px;
			border: none;
			border-radius: 5px;
			background: #7138c8;
			color: white;
			font-size: 10px;
			transition: 0.2s ease;
		}

		.question-button:hover
		{
			background: #8c50df;
			transform: translateY(-1px);
		}

		.question-button:active
		{
			transform: scale(0.95);
		}

		.content-section
		{
			width: 100%;
			max-width: 1180px;
			margin-left: auto;
			margin-right: auto;
			padding: 45px 0;
		}

		.announcements-section
		{
			scroll-margin-top: 100px;
		}

		.section-heading
		{
			text-align: center;
			margin-bottom: 30px;
		}

		.section-label
		{
			color: var(--purple);
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 1px;
			margin-bottom: 6px;
		}

		.section-heading h2
		{
			font-size: 32px;
			font-weight: 600;
			color: var(--text);
			margin-bottom: 10px;
		}

		.section-heading p
		{
			max-width: 650px;
			margin: 0 auto;
			color: var(--text-muted);
			font-size: 13px;
			line-height: 1.7;
		}

		.toolbar
		{
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			gap: 9px;
			margin-bottom: 28px;
		}

		.search-field
		{
			display: flex;
			width: clamp(220px, 30vw, 320px);
			height: 34px;
			align-items: center;
			gap: 8px;
			padding: 0 10px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			color: var(--text-muted);
			transition: border-color 0.2s ease, box-shadow 0.2s ease;
		}

		.search-field:focus-within
		{
			border-color: var(--purple);
			box-shadow: 0 0 0 3px var(--purple-light);
		}

		.search-field svg
		{
			width: 15px;
			height: 15px;
			flex: 0 0 15px;
			fill: currentColor;
		}

		.search-field input
		{
			width: 100%;
			min-width: 0;
			border: 0;
			outline: 0;
			background: transparent;
			color: var(--text);
			font-size: 12px;
		}

		.search-field input::placeholder
		{
			color: var(--text-muted);
		}

		.filter-wrap
		{
			position: relative;
		}

		.filter-button
		{
			display: inline-flex;
			min-width: 84px;
			height: 34px;
			align-items: center;
			justify-content: center;
			gap: 6px;
			padding: 0 12px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			color: var(--text);
			font-size: 12px;
			transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
		}

		.filter-button svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
			color: var(--purple);
		}

		.filter-button:hover,
		.filter-button[aria-expanded="true"]
		{
			border-color: #c5a4ef;
			background: var(--purple-light);
		}

		.filter-panel
		{
			position: absolute;
			z-index: 25;
			top: calc(100% + 8px);
			right: 0;
			width: 230px;
			padding: 14px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			box-shadow: 0 14px 35px rgba(20, 13, 44, 0.15);
		}

		.filter-panel h3
		{
			margin: 0 0 12px;
			color: var(--text);
			font-size: 13px;
			font-weight: 600;
		}

		.filter-panel label
		{
			display: block;
			margin-bottom: 5px;
			color: var(--text-soft);
			font-size: 11px;
		}

		.filter-panel select
		{
			width: 100%;
			height: 34px;
			margin-bottom: 12px;
			padding: 0 9px;
			border: 1px solid var(--border);
			border-radius: 4px;
			background: var(--surface);
			color: var(--text);
			font-size: 11px;
		}

		.filter-actions
		{
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
		}

		.clear-filter,
		.apply-filter
		{
			min-height: 30px;
			padding: 0 11px;
			border: 1px solid var(--border);
			border-radius: 4px;
			background: var(--surface);
			color: var(--text-soft);
			font-size: 11px;
			transition: 0.2s ease;
		}

		.apply-filter
		{
			border-color: var(--purple);
			background: var(--purple);
			color: #ffffff;
		}

		.clear-filter:hover,
		.apply-filter:hover
		{
			transform: translateY(-1px);
		}

		.clear-filter:hover
		{
			border-color: var(--purple);
			color: var(--purple);
		}

		.apply-filter:hover
		{
			background: #8c50df;
		}

		.chips-heading
		{
			margin-bottom: 12px;
			color: var(--text-muted);
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 1px;
			text-align: center;
			text-transform: uppercase;
		}

		.chips
		{
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 8px;
			margin-bottom: 26px;
		}

		.chip
		{
			display: inline-flex;
			height: 34px;
			align-items: center;
			padding: 0 13px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			color: var(--text-soft);
			font-size: 11px;
			transition: 0.2s ease;
		}

		.chip:hover
		{
			transform: translateY(-1px);
			border-color: #c5a4ef;
			background: var(--purple-light);
			color: var(--purple);
		}

		.chip.active
		{
			border-color: var(--purple);
			background: var(--purple);
			color: #ffffff;
		}

		.chip.active:hover
		{
			border-color: #8c50df;
			background: #8c50df;
			color: #ffffff;
		}

		.results-row
		{
			display: flex;
			min-height: 22px;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
			margin-bottom: 12px;
		}

		.results-summary
		{
			color: var(--text-muted);
			font-size: 11px;
		}

		.results-clear
		{
			border: 0;
			background: transparent;
			color: var(--purple);
			font-size: 11px;
			transition: 0.2s;
		}

		.results-clear:hover
		{
			color: #8c50df;
			transform: translateX(2px);
		}

		.announcements-grid
		{
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 18px;
		}

		.announcement-card
		{
			display: flex;
			min-height: 185px;
			flex-direction: column;
			gap: 9px;
			padding: 22px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			box-shadow: 0 5px 20px var(--shadow);
			transition: 0.3s ease;
		}

		.announcement-card:hover,
		.announcement-card:focus-visible
		{
			transform: translateY(-5px);
			border-color: #a970ff;
			box-shadow:
				0 15px 35px var(--shadow),
				0 0 22px rgba(113, 56, 200, 0.08);
		}

		.card-top
		{
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.announcement-icon
		{
			display: flex;
			width: 45px;
			height: 45px;
			min-width: 45px;
			align-items: center;
			justify-content: center;
			border-radius: 5px;
			background: var(--purple-light);
			color: var(--purple);
			transition: 0.3s ease;
		}

		.announcement-icon svg
		{
			width: 22px;
