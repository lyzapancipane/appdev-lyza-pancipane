    <script>

        document.body.classList.add("js");

        const hero =
            document.querySelector(".hero");

        const themeButton =
            document.getElementById("themeButton");

        const themeIcon =
            document.getElementById("themeIcon");

        const backToTop =
            document.getElementById("backToTop");

        const contactForm =
            document.getElementById("contactForm");

        const successMessage =
            document.getElementById("successMessage");

        const contactNavButton =
            document.getElementById("contactNavButton");

        const contactModal =
            document.getElementById("contactModal");

        const contactModalClose =
            document.getElementById("contactModalClose");

        const contactModalDone =
            document.getElementById("contactModalDone");


        function openContactModal() {

            contactModal.classList.add("show");

            document.body.classList.add("modal-open");

        }


        function closeContactModal() {

            contactModal.classList.remove("show");

            document.body.classList.remove("modal-open");

        }


        contactNavButton.addEventListener(
            "click",
            function(event) {

                event.preventDefault();

                openContactModal();

            }
        );


        contactModalClose.addEventListener(
            "click",
            function() {

                closeContactModal();

            }
        );


        contactModalDone.addEventListener(
            "click",
            function() {

                closeContactModal();

            }
        );


        contactModal.addEventListener(
            "click",
            function(event) {

                if (
                    event.target ===
                    contactModal
                ) {

                    closeContactModal();

                }

            }
        );


        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape" &&
                    contactModal.classList.contains("show")
                ) {

                    closeContactModal();

                }

            }
        );


        function updateThemeIcon() {

            if (
                document.body.classList.contains(
                    "dark-mode"
                )
            ) {

                themeIcon.innerHTML =
                    `
                        <path d="M20.7 15.3A8.7 8.7 0 0 1 8.7 3.3 9.5 9.5 0 1 0 20.7 15.3z">
                        </path>
                    `;

            } else {

                themeIcon.innerHTML =
                    `
                        <circle
                            cx="12"
                            cy="12"
                            r="4"
                        >
                        </circle>

                        <path d="M12 2v2">
                        </path>

                        <path d="M12 20v2">
                        </path>

                        <path d="M4.93 4.93l1.42 1.42">
                        </path>

                        <path d="M17.65 17.65l1.42 1.42">
                        </path>

                        <path d="M2 12h2">
                        </path>

                        <path d="M20 12h2">
                        </path>

                        <path d="M4.93 19.07l1.42-1.42">
                        </path>

                        <path d="M17.65 6.35l1.42-1.42">
                        </path>
                    `;

            }

        }


        const savedTheme =
            localStorage.getItem(
                "edubridge-theme"
            );


        if (
            savedTheme === "dark"
        ) {

            document.body.classList.add(
                "dark-mode"
            );

        }


        updateThemeIcon();


        themeButton.addEventListener(
            "click",
            function() {

                const rect =
                    themeButton.getBoundingClientRect();

                document.body.style.setProperty(
                    "--theme-x",
                    rect.left +
                    rect.width / 2 +
                    "px"
                );

                document.body.style.setProperty(
                    "--theme-y",
                    rect.top +
                    rect.height / 2 +
                    "px"
                );

                const isDark =
                    !document.body.classList.contains(
                        "dark-mode"
                    );

                document.body.style.setProperty(
                    "--theme-circle",
                    isDark
                        ? "#090817"
                        : "#f3f3f3"
                );

                document.body.classList.add(
                    "theme-changing"
                );

                setTimeout(
                    function() {

                        document.body.classList.toggle(
                            "dark-mode"
                        );

                        localStorage.setItem(
                            "edubridge-theme",
                            isDark
                                ? "dark"
                                : "light"
                        );

                        updateThemeIcon();

                    },
                    100
                );

                setTimeout(
                    function() {

                        document.body.classList.remove(
                            "theme-changing"
                        );

                    },
                    700
                );

            }
        );


        window.addEventListener(
            "scroll",
            function() {

                const navbar =
                    document.querySelector(
                        ".navbar"
                    );

                if (
                    window.scrollY > 50
                ) {

                    navbar.classList.add(
                        "scrolled"
                    );

                } else {

                    navbar.classList.remove(
                        "scrolled"
                    );

                }

                if (
                    window.scrollY > 450
                ) {

                    backToTop.classList.add(
                        "show"
                    );

                } else {

                    backToTop.classList.remove(
                        "show"
                    );

                }

            }
        );


        backToTop.addEventListener(
            "click",
            function() {

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            }
        );


        const revealItems =
            document.querySelectorAll(
                ".reveal"
            );


        const revealObserver =
            new IntersectionObserver(
                function(entries) {

                    entries.forEach(
                        function(entry) {

                            if (
                                entry.isIntersecting
                            ) {

                                entry.target.classList.add(
                                    "visible"
                                );

                                revealObserver.unobserve(
                                    entry.target
                                );

                            }

                        }
                    );

                },
                {
                    threshold: 0.12
                }
            );


        revealItems.forEach(
            function(item) {

                revealObserver.observe(
                    item
                );

            }
        );


        contactForm.addEventListener(
            "submit",
            function(event) {

                event.preventDefault();

                successMessage.classList.add(
                    "show"
                );

                contactForm.reset();

                setTimeout(
                    function() {

                        successMessage.classList.remove(
                            "show"
                        );

                    },
                    5000
                );

            }
        );


        let cursorMouseX =
            window.innerWidth / 2;

        let cursorMouseY =
            window.innerHeight / 2;

        let gradientX =
            cursorMouseX;

        let gradientY =
            cursorMouseY;


        const cursorGradient =
            document.querySelector(
                ".cursor-gradient"
            );


        document.addEventListener(
            "mousemove",
            function(event) {

                cursorMouseX =
                    event.clientX;

                cursorMouseY =
                    event.clientY;

                document.body.classList.add(
                    "cursor-ready"
                );

            }
        );


        function moveCursorGradient() {

            gradientX +=
                (
                    cursorMouseX -
                    gradientX
                ) * 0.12;

            gradientY +=
                (
                    cursorMouseY -
                    gradientY
                ) * 0.12;

            cursorGradient.style.left =
                gradientX + "px";

            cursorGradient.style.top =
                gradientY + "px";

            requestAnimationFrame(
                moveCursorGradient
            );

        }


        moveCursorGradient();


        let audioContext;


        function playClickSound() {

            try {

                if (!audioContext) {

                    audioContext =
                        new (
                            window.AudioContext ||
                            window.webkitAudioContext
                        )();

                }

                if (
                    audioContext.state ===
                    "suspended"
                ) {

                    audioContext.resume();

                }

                const oscillator =
                    audioContext.createOscillator();

                const gain =
                    audioContext.createGain();

                oscillator.type =
                    "sine";

                oscillator.frequency.setValueAtTime(
                    520,
                    audioContext.currentTime
                );

                oscillator.frequency.exponentialRampToValueAtTime(
                    300,
                    audioContext.currentTime + 0.045
                );

                gain.gain.setValueAtTime(
                    0.045,
                    audioContext.currentTime
                );

                gain.gain.exponentialRampToValueAtTime(
                    0.001,
                    audioContext.currentTime + 0.06
                );

                oscillator.connect(gain);

                gain.connect(
                    audioContext.destination
                );

                oscillator.start();

                oscillator.stop(
                    audioContext.currentTime + 0.06
                );

            } catch (error) {
            }

        }


        document.addEventListener(
            "click",
            function(event) {

                const clickable =
                    event.target.closest(
                        "button, a"
                    );

                if (clickable) {

                    playClickSound();

                }

            }
        );


        let purpleX = 4;
        let purpleY = 5;

        let blueX = 93;
        let blueY = 8;

        let pinkX = 15;
        let pinkY = 57;

        let violetX = 55;
        let violetY = 38;

        let orangeX = 94;
        let orangeY = 88;

        let cyanX = 5;
        let cyanY = 93;

        let pinkSmallX = 78;
        let pinkSmallY = 67;


        let targetPurpleX = purpleX;
        let targetPurpleY = purpleY;

        let targetBlueX = blueX;
        let targetBlueY = blueY;

        let targetPinkX = pinkX;
        let targetPinkY = pinkY;

        let targetVioletX = violetX;
        let targetVioletY = violetY;

        let targetOrangeX = orangeX;
        let targetOrangeY = orangeY;

        let targetCyanX = cyanX;
        let targetCyanY = cyanY;

        let targetPinkSmallX = pinkSmallX;
        let targetPinkSmallY = pinkSmallY;


        document.addEventListener(
            "mousemove",
            function(event) {

                if (!hero) {
                    return;
                }

                const rect =
                    hero.getBoundingClientRect();

                const moveX =
                    event.clientX /
                    window.innerWidth;

                const moveY =
                    (
                        event.clientY -
                        rect.top
                    ) /
                    rect.height;


                targetPurpleX =
                    4 + moveX * 8;

                targetPurpleY =
                    5 + moveY * 8;


                targetBlueX =
                    93 - moveX * 7;

                targetBlueY =
                    8 + moveY * 7;


                targetPinkX =
                    15 + moveX * 6;

                targetPinkY =
                    57 - moveY * 5;


                targetVioletX =
                    55 - moveX * 5;

                targetVioletY =
                    38 + moveY * 6;


                targetOrangeX =
                    94 - moveX * 6;

                targetOrangeY =
                    88 - moveY * 5;


                targetCyanX =
                    5 + moveX * 5;

                targetCyanY =
                    93 - moveY * 5;


                targetPinkSmallX =
                    78 - moveX * 5;

                targetPinkSmallY =
                    67 + moveY * 5;

            }
        );


        function animateGradient() {

            if (!hero) {
                return;
            }


            purpleX +=
                (
                    targetPurpleX -
                    purpleX
                ) * 0.025;

            purpleY +=
                (
                    targetPurpleY -
                    purpleY
                ) * 0.025;


            blueX +=
                (
                    targetBlueX -
                    blueX
                ) * 0.025;

            blueY +=
                (
                    targetBlueY -
                    blueY
                ) * 0.025;


            pinkX +=
                (
                    targetPinkX -
                    pinkX
                ) * 0.025;

            pinkY +=
                (
                    targetPinkY -
                    pinkY
                ) * 0.025;


            violetX +=
                (
                    targetVioletX -
                    violetX
                ) * 0.025;

            violetY +=
                (
                    targetVioletY -
                    violetY
                ) * 0.025;


            orangeX +=
                (
                    targetOrangeX -
                    orangeX
                ) * 0.025;

            orangeY +=
                (
                    targetOrangeY -
                    orangeY
                ) * 0.025;


            cyanX +=
                (
                    targetCyanX -
                    cyanX
                ) * 0.025;

            cyanY +=
                (
                    targetCyanY -
                    cyanY
                ) * 0.025;


            pinkSmallX +=
                (
                    targetPinkSmallX -
                    pinkSmallX
                ) * 0.025;

            pinkSmallY +=
                (
                    targetPinkSmallY -
                    pinkSmallY
                ) * 0.025;


            hero.style.setProperty(
                "--purple-x",
                purpleX + "%"
            );

            hero.style.setProperty(
                "--purple-y",
                purpleY + "%"
            );

            hero.style.setProperty(
                "--blue-x",
                blueX + "%"
            );

            hero.style.setProperty(
                "--blue-y",
                blueY + "%"
            );

            hero.style.setProperty(
                "--pink-x",
                pinkX + "%"
            );

            hero.style.setProperty(
                "--pink-y",
                pinkY + "%"
            );

            hero.style.setProperty(
                "--violet-x",
                violetX + "%"
            );

            hero.style.setProperty(
                "--violet-y",
                violetY + "%"
            );

            hero.style.setProperty(
                "--orange-x",
                orangeX + "%"
            );

            hero.style.setProperty(
                "--orange-y",
                orangeY + "%"
            );

            hero.style.setProperty(
                "--cyan-x",
                cyanX + "%"
            );

            hero.style.setProperty(
                "--cyan-y",
                cyanY + "%"
            );

            hero.style.setProperty(
                "--pink-small-x",
                pinkSmallX + "%"
            );

            hero.style.setProperty(
                "--pink-small-y",
                pinkSmallY + "%"
            );


            requestAnimationFrame(
                animateGradient
            );

        }


        animateGradient();

    </script>

