			function formatInquiryDate(isoValue)
			{

				const date = new Date(isoValue);

				if (isNaN(date.getTime()))
				{
					return "—";
				}

				return date.toLocaleString(undefined,
				{
					month: "short",
					day: "numeric",
					year: "numeric",
					hour: "numeric",
					minute: "2-digit"
				});

			}

			function formatFileSize(bytes)
			{

				if (bytes >= 1024 * 1024)
				{
					return (bytes / (1024 * 1024)).toFixed(1) + " MB";
				}

				return Math.max(1, Math.round(bytes / 1024)) + " KB";

			}

			function generateInquiryId(records)
			{

				let maxSequence = 0;
				const currentYear = String(new Date().getFullYear());

				records.forEach(function(entry)
				{
					const match = /^#INQ-(\d{4})-(\d{4,})$/.exec(entry.id || "");

					if (match)
					{
						maxSequence = Math.max(maxSequence, Number(match[2]));
					}
				});

				const nextSequence = String(maxSequence + 1).padStart(4, "0");

				return "#INQ-" + currentYear + "-" + nextSequence;

			}

			function readInquiryRecords()
			{

				let saved = null;

				try
				{
					saved = JSON.parse(localStorage.getItem(inquiriesStorageKey) || "[]");
				}
				catch (error)
				{
					return { ok: false, records: [] };
				}

				if (!Array.isArray(saved))
				{
					return { ok: false, records: [] };
				}


				let changed = false;

				const migrated = saved.map(function(record)
				{

					const entry = Object.assign({}, record || {});

					if (!entry.id)
					{
						entry.id = generateInquiryId(saved);
						changed = true;
					}

					if (!entry.createdAt)
					{
						entry.createdAt = entry.savedAt || new Date().toISOString();
						changed = true;
					}

					if (!entry.updatedAt)
					{
						entry.updatedAt = entry.createdAt;
						changed = true;
					}

					if (!entry.status)
					{
						entry.status = "In Progress";
						changed = true;
					}

					if (!entry.category)
					{
						entry.category = "General";
						changed = true;
					}

					if (!entry.student)
					{
						entry.student = studentName;
						changed = true;
					}

					if (!Array.isArray(entry.followUps))
					{
						entry.followUps = [];
						changed = true;
					}

					return entry;

				});


				if (changed)
				{

					try
					{
						localStorage.setItem(inquiriesStorageKey, JSON.stringify(migrated));
					}
					catch (error)
					{
					}

				}


				return { ok: true, records: migrated };

			}

			function getOwnInquiries(records)
