			function updateTabCounts(records)
			{

				const counts =
				{
					"all": records.length,
					"In Progress": 0,
					"Answered": 0,
					"Closed": 0
				};

				records.forEach(function(entry)
				{
					if (counts[entry.status] !== undefined)
					{
						counts[entry.status] += 1;
					}
				});

				statusTabs.querySelectorAll("[data-status]").forEach(function(tab)
				{
					const count = counts[tab.dataset.status];

					if (typeof count === "number")
					{
						tab.querySelector(".tab-count").textContent = count;
					}
				});

			}

			function renderInquiries()
			{

				const result = readInquiryRecords();

				if (!result.ok)
				{
					inquiriesLoading.hidden = true;
					inquiriesTableWrap.hidden = true;
					myInquiriesEmpty.hidden = true;
					inquiriesNoMatches.hidden = true;
					inquiriesPagination.hidden = true;
					inquiriesError.hidden = false;
					resultsSummary.textContent = "";
					return;
				}

				inquiriesError.hidden = true;


				const allRecords = getOwnInquiries(result.records).sort(function(a, b)
				{
					return new Date(b.updatedAt) - new Date(a.updatedAt);
				});

				updateTabCounts(allRecords);


				if (allRecords.length === 0)
				{
					inquiriesLoading.hidden = true;
					inquiriesTableWrap.hidden = true;
					inquiriesNoMatches.hidden = true;
					inquiriesPagination.hidden = true;
					resultsSummary.textContent = "";
					myInquiriesEmpty.hidden = false;
					return;
				}

				myInquiriesEmpty.hidden = true;


				const query = activeQuery.trim().toLowerCase();

				const filtered = allRecords.filter(function(entry)
				{

					const matchesStatus =
						activeStatus === "all" || entry.status === activeStatus;

					const matchesCategory =
						activeCategory === "all" || entry.category === activeCategory;

					const haystack = [
						entry.id,
						entry.subject,
						entry.message,
						entry.category
					].join(" ").toLowerCase();

					const matchesQuery = !query || haystack.indexOf(query) !== -1;

					return matchesStatus && matchesCategory && matchesQuery;

				});


				if (filtered.length === 0)
				{
					inquiriesLoading.hidden = true;
					inquiriesTableWrap.hidden = true;
					inquiriesPagination.hidden = true;
					resultsSummary.textContent = "0 inquiries";
					inquiriesNoMatches.hidden = false;
					return;
				}

				inquiriesNoMatches.hidden = true;


				const pageCount = Math.max(1, Math.ceil(filtered.length / inquiryPageSize));

				if (currentPage > pageCount)
				{
					currentPage = pageCount;
				}


				const startIndex = (currentPage - 1) * inquiryPageSize;
				const pageRecords = filtered.slice(startIndex, startIndex + inquiryPageSize);


				inquiriesBody.replaceChildren();

				pageRecords.forEach(function(entry)
				{
					inquiriesBody.append(createInquiryRow(entry));
				});


				inquiriesLoading.hidden = true;
				inquiriesTableWrap.hidden = false;
				inquiriesPagination.hidden = pageCount <= 1;

				pageInfo.textContent = "Page " + currentPage + " of " + pageCount;

				prevPageButton.disabled = currentPage <= 1;
				nextPageButton.disabled = currentPage >= pageCount;

				resultsSummary.textContent = filtered.length +
					(filtered.length === 1 ? " inquiry" : " inquiries");

			}

