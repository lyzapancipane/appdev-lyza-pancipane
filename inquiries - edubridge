				field.append(
					buildElement("span", "detail-label", label),
					buildElement("span", "detail-value", value)
				);

				return field;

			}

			function createConversationItem(author, date, text)
			{

				const item = buildElement("div", "conversation-item");

				const meta = buildElement("div", "conversation-meta");

				const authorLabel = buildElement("span", "conversation-author", author);
				const time = document.createElement("time");
				time.dateTime = date;
				time.textContent = formatInquiryDate(date);

				meta.append(authorLabel, time);

				item.append(meta, buildElement("p", null, text));

				return item;

			}

			function renderDetails()
			{

				const entry = selectedInquiryId ? findInquiryRecord(selectedInquiryId) : null;

				if (!entry || entry.student !== studentName)
				{
					closeInquiryDetails();
					return;
				}

				detailsPanel.replaceChildren();
				inquiryDetailsSection.hidden = false;


				const header = buildElement("div", "details-header");

				header.append(
					buildElement("span", "details-id", entry.id),
					createStatusBadge(entry.status)
				);

				const closeButton = buildElement("button", "details-close", "Close Details");
				closeButton.type = "button";
				closeButton.addEventListener("click", closeInquiryDetails);

				header.append(closeButton);


				const grid = buildElement("div", "details-grid");

				grid.append(createDetailField("Submitted", formatInquiryDate(entry.createdAt)));
				grid.append(createDetailField("Last Updated", formatInquiryDate(entry.updatedAt)));
				grid.append(createDetailField("Category", entry.category, true));
				grid.append(createDetailField("Subject", entry.subject, true));
				grid.append(createDetailField("Inquiry Details", entry.message, true));


				const attachmentField = buildElement("div", "detail-field detail-field--wide");
				attachmentField.append(buildElement("span", "detail-label", "Attachment"));

				if (entry.attachment && entry.attachment.data)
				{

					const attachmentRow = buildElement("div", "attachment-row");

					const attachmentLink = buildElement("a", "attachment-link", "Open Attachment");
					attachmentLink.href = entry.attachment.data;
					attachmentLink.target = "_blank";
					attachmentLink.rel = "noopener";
					attachmentLink.setAttribute("download", entry.attachment.name || "attachment");

					attachmentRow.append(
						buildElement("span", "detail-value", entry.attachment.name || "Attachment"),
						attachmentLink
					);

					attachmentField.append(attachmentRow);

					attachmentField.append(buildElement(
						"span",
						"file-hint",
						"Stored in this browser and visible only to you."
					));

				}
				else
				{

					attachmentField.append(buildElement(
						"span",
						"detail-value",
						"No attachment was included with this inquiry."
					));

				}

				grid.append(attachmentField);

				detailsPanel.append(header, grid);


				const hasResponse = Boolean(entry.response && entry.response.text);

				if (hasResponse || entry.followUps.length > 0)
				{

					detailsPanel.append(buildElement("h3", "details-subheading", "Conversation"));

					const conversation = buildElement("div", "conversation");

					const events = [];

					entry.followUps.forEach(function(followUp)
					{
						events.push(
						{
							author: studentName,
							text: followUp.text,
							date: followUp.date
						});
					});

					if (hasResponse)
					{
						events.push(
						{
							author: "EduBridge Team",
							text: entry.response.text,
							date: entry.response.date || entry.updatedAt
						});
					}

					events.sort(function(a, b)
					{
						return new Date(a.date) - new Date(b.date);
					});

					events.forEach(function(item)
					{
						conversation.append(createConversationItem(item.author, item.date, item.text));
					});

					detailsPanel.append(conversation);

				}


				if (!hasResponse)
				{

					const pendingBox = buildElement(
						"div",
						"pending-box",
						"No response has been received yet. You can ask a follow-up " +
						"question below or check this page again later."
					);

					detailsPanel.append(pendingBox);

				}


				const followupArea = buildElement("div", "followup-area");

				if (entry.status !== "Closed")
				{

					followupArea.innerHTML =
						'<button class="view-button" id="askFollowupButton" type="button">' +
							'Ask Follow-up Question' +
						'</button>' +
						'<form class="followup-form" id="followupForm" novalidate hidden>' +
							'<div class="form-group">' +
								'<label for="followupText">' +
									'Your Follow-up Question' +
								'</label>' +
								'<textarea id="followupText" placeholder="Add more details or ask a follow-up question..."></textarea>' +
								'<span class="form-error" id="followupError" role="alert" hidden></span>' +
							'</div>' +
							'<div class="followup-actions">' +
								'<button class="state-button" id="followupSubmitButton" type="submit">' +
									'Submit Follow-up' +
								'</button>' +
								'<button class="page-button" id="followupCancelButton" type="button">' +
									'Cancel' +
								'</button>' +
							'</div>' +
						'</form>';

					const askButton = followupArea.querySelector("#askFollowupButton");
					const followupForm = followupArea.querySelector("#followupForm");
					const followupText = followupArea.querySelector("#followupText");
					const followupError = followupArea.querySelector("#followupError");
					const followupSubmitButton = followupArea.querySelector("#followupSubmitButton");
					const followupCancelButton = followupArea.querySelector("#followupCancelButton");

					askButton.addEventListener("click", function()
					{
						followupForm.hidden = false;
						followupText.focus();
					});

					followupCancelButton.addEventListener("click", function()
					{
						followupError.hidden = true;
						followupForm.hidden = true;
					});

					followupForm.addEventListener("submit", function(event)
					{

						event.preventDefault();

						const text = followupText.value.trim();

						if (text.length < 5)
						{
							showFieldError(followupError,
								"Please enter your follow-up question with at least 5 characters.");
							showToast("Please enter at least 5 characters for your follow-up.", "info");
							return;
						}

						followupError.hidden = true;


						const result = readInquiryRecords();

						if (!result.ok)
						{
							showFieldError(followupError,
								"Your follow-up could not be saved. Please try again.");
							showToast("Failed to submit follow-up. Please try again.", "error");
							return;
						}


						const stored = result.records.filter(function(item)
						{
							return item.id === entry.id;
						})[0];

						if (!stored)
						{
							showFieldError(followupError,
								"This inquiry could not be found anymore.");
							showToast("This inquiry could not be found anymore.", "error");
							return;
						}


						stored.followUps.push(
						{
							text: text,
							date: new Date().toISOString()
						});

						stored.updatedAt = new Date().toISOString();


						try
						{
							writeInquiryRecords(result.records);
						}
						catch (error)
						{
							showFieldError(followupError,
								"Your follow-up could not be saved. Please try again.");
							showToast("Failed to submit follow-up. Please try again.", "error");
							return;
						}


						followupForm.hidden = true;

						showToast("Follow-up submitted successfully.", "success");

						renderDetails();
						renderInquiries();

					});

				}
				else
				{

					followupArea.append(buildElement(
						"p",
						"pending-box",
						"Follow-up questions are not available for closed inquiries."
					));

				}

				detailsPanel.append(followupArea);

			}

			function showFieldError(element, message)
			{
				element.textContent = message;
				element.hidden = false;
			}

			function clearSelectedAttachment()
			{

				selectedAttachmentData = null;
				selectedAttachmentName = "";
				selectedAttachmentType = "";

				fileInput.value = "";
				fileName.textContent = "";
				fileSelection.hidden = true;

			}

			function setActiveTab(status)
			{

				activeStatus = status;
				currentPage = 1;

				statusTabs.querySelectorAll("[data-status]").forEach(function(tab)
				{
					const isActive = tab.dataset.status === status;

					tab.classList.toggle("active", isActive);
					tab.setAttribute("aria-pressed", String(isActive));
				});

				renderInquiries();

			}

			fileInput.addEventListener("change", function()
			{

				fileError.hidden = true;
				fileSelection.hidden = true;

				const file = fileInput.files && fileInput.files[0];

				if (!file)
				{
					clearSelectedAttachment();
					return;
				}


				if (allowedAttachmentTypes.indexOf(file.type) === -1)
				{
					showFieldError(fileError,
						"Unsupported file type. Allowed: JPG, PNG, WEBP, or PDF.");
					showToast("File upload failed. Please choose another file.", "error");
					clearSelectedAttachment();
					return;
				}

				if (file.size > maxAttachmentSize)
				{
					showFieldError(fileError,
						"The file is too large. The maximum size is 5 MB.");
					showToast("File upload failed. The maximum size is 5 MB.", "error");
					clearSelectedAttachment();
					return;
				}


				const reader = new FileReader();

				reader.onload = function()
				{

					selectedAttachmentData = reader.result;
					selectedAttachmentName = file.name;
					selectedAttachmentType = file.type;

					fileName.textContent = file.name + " · " + formatFileSize(file.size);
					fileSelection.hidden = false;

				};

				reader.onerror = function()
				{
					showFieldError(fileError,
						"The file could not be read. Please try another file.");
					showToast("File upload failed. Please choose another file.", "error");
					clearSelectedAttachment();
				};

				reader.readAsDataURL(file);

			});

			removeFileButton.addEventListener("click", function()
			{
				fileError.hidden = true;
				clearSelectedAttachment();
			});

			inquiryForm.addEventListener("submit", function(event)
			{

				event.preventDefault();

				if (isSubmittingInquiry)
				{
					return;
				}

				categoryError.hidden = true;
				subjectError.hidden = true;
				detailsError.hidden = true;


				let valid = true;

				if (!categorySelect.value)
				{
					showFieldError(categoryError, "Please choose a category.");
					valid = false;
				}

				if (subjectInput.value.trim().length < 3)
				{
					showFieldError(subjectError,
						"Please enter a subject with at least 3 characters.");
					valid = false;
				}

				if (detailsInput.value.trim().length < 10)
				{
					showFieldError(detailsError,
						"Please provide at least 10 characters of details.");
					valid = false;
				}

				if (!valid)
				{
					showToast("Please complete all required fields.", "info");
					return;
				}


				isSubmittingInquiry = true;
				submitButton.disabled = true;
				submitLabel.textContent = "Submitting...";


				const result = readInquiryRecords();

				if (!result.ok)
				{

					isSubmittingInquiry = false;
					submitButton.disabled = false;
					submitLabel.textContent = "Submit Inquiry";

					showToast("Failed to submit inquiry. Please try again.", "error");
					return;

				}


				const now = new Date().toISOString();

				const entry =
				{
					id: generateInquiryId(result.records),
					student: studentName,
					category: categorySelect.value,
					subject: subjectInput.value.trim(),
					message: detailsInput.value.trim(),
					status: "In Progress",
					createdAt: now,
					updatedAt: now,
					savedAt: now,
					followUps: [],
					response: null,
					attachment: selectedAttachmentData
						? {
							name: selectedAttachmentName,
							type: selectedAttachmentType,
							data: selectedAttachmentData
						}
						: null
				};


				result.records.unshift(entry);


				try
				{
					writeInquiryRecords(result.records);
				}
				catch (error)
				{

					isSubmittingInquiry = false;
					submitButton.disabled = false;
					submitLabel.textContent = "Submit Inquiry";

					showToast(selectedAttachmentData
						? "Browser storage is full. Try removing the attachment or using a smaller file."
						: "Failed to submit inquiry. Please try again.", "error");
					return;

				}


				inquiryForm.reset();
				clearSelectedAttachment();

				activeStatus = "all";
				activeCategory = "all";
				activeQuery = "";
				currentPage = 1;

				inquirySearch.value = "";
				inquiryCategoryFilter.value = "all";

				statusTabs.querySelectorAll("[data-status]").forEach(function(tab)
				{
					const isActive = tab.dataset.status === "all";

					tab.classList.toggle("active", isActive);
					tab.setAttribute("aria-pressed", String(isActive));
				});

				renderInquiries();

				showToast("Inquiry submitted successfully!", "success");

				isSubmittingInquiry = false;
				submitButton.disabled = false;
				submitLabel.textContent = "Submit Inquiry";

			});

			statusTabs.addEventListener("click", function(event)
			{

				const tab = event.target.closest("[data-status]");

				if (!tab)
				{
					return;
				}

				setActiveTab(tab.dataset.status);

			});

			inquirySearch.addEventListener("input", function()
			{
				activeQuery = inquirySearch.value;
				currentPage = 1;
				renderInquiries();
			});

			inquiryCategoryFilter.addEventListener("change", function()
			{
				activeCategory = inquiryCategoryFilter.value;
				currentPage = 1;
				renderInquiries();
			});

			prevPageButton.addEventListener("click", function()
			{

				if (currentPage > 1)
				{
					currentPage -= 1;
					renderInquiries();
				}

			});

			nextPageButton.addEventListener("click", function()
			{
				currentPage += 1;
				renderInquiries();
			});

			clearFiltersButton.addEventListener("click", function()
			{

				activeStatus = "all";
				activeCategory = "all";
				activeQuery = "";
				currentPage = 1;

				inquirySearch.value = "";
				inquiryCategoryFilter.value = "all";

				statusTabs.querySelectorAll("[data-status]").forEach(function(tab)
				{
					const isActive = tab.dataset.status === "all";

					tab.classList.toggle("active", isActive);
					tab.setAttribute("aria-pressed", String(isActive));
				});

				renderInquiries();

			});

			retryListButton.addEventListener("click", function()
			{
				renderInquiries();
			});

			renderInquiries();
		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>
</body>
</html>
