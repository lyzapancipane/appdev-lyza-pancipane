.admin-profile-page
{
	--profile-max: 1120px;
}

.admin-profile-page .profile-card,
.admin-profile-page .profile-header,
.admin-profile-page .profile-details,
.admin-profile-page .profile-actions
{
	border-color: var(--border);
	background: var(--surface);
	box-shadow: 0 12px 32px var(--shadow);
}

.admin-profile-page .profile-header
{
	display: grid;
	grid-template-columns: 112px minmax(0, 1fr) auto;
	gap: 20px;
	align-items: center;
	padding: 24px;
	border: 1px solid var(--border);
	border-radius: 14px;
}

.admin-profile-page .profile-avatar
{
	width: 112px;
	height: 112px;
	border: 3px solid var(--purple-light);
	border-radius: 50%;
	object-fit: cover;
}

.admin-profile-page .profile-name-row
{
	align-items: center;
}

.admin-profile-page .profile-details
{
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14px;
	padding: 20px;
	border: 1px solid var(--border);
	border-radius: 14px;
}

.admin-profile-page .profile-info
{
	margin: 0;
	padding: 14px;
	border: 1px solid var(--border);
	border-radius: 10px;
	background: var(--surface-soft);
}

.admin-profile-page .profile-actions
{
	padding: 12px;
	border: 1px solid var(--border);
	border-radius: 12px;
	box-shadow: none;
}

@media (max-width: 900px)
{
	.admin-profile-page .profile-header
	{
		grid-template-columns: 88px minmax(0, 1fr);
	}

	.admin-profile-page .profile-actions
	{
		grid-column: 1 / -1;
	}

	.admin-profile-page .profile-avatar
	{
		width: 88px;
		height: 88px;
	}

	.admin-profile-page .profile-details
	{
		grid-template-columns: 1fr;
	}
}

@media (max-width: 640px)
{
	.admin-profile-page .profile-header
	{
		grid-template-columns: 1fr;
		text-align: center;
	}

	.admin-profile-page .profile-avatar
	{
		margin: 0 auto;
	}

	.admin-profile-page .profile-name-row
	{
		justify-content: center;
	}
}
