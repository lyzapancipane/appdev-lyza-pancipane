							}

							if (activeStatus !== "all" && entry.status !== activeStatus)
							{
									return false;
							}

							if (query)
							{
									const haystack = [
											entry.id,
											entry.subject,
											entry.message,
											entry.student,
											entry.category
									].join(" ").toLowerCase();

									if (haystack.indexOf(query) === -1)
									{
											return false;
									}
							}

							return true;

					});

