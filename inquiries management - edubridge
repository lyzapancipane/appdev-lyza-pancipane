			function renderTable()
			{

					const result = readInquiryRecords();
					const records = result.ok ? result.records : [];

					renderStats(records);


					if (!result.ok)
					{
							mgSummary.textContent = "Inquiry records could not be read from this browser.";
							mgPanel.hidden = true;
							mgEmpty.hidden = true;
							mgNoMatches.hidden = true;
							mgPagination.hidden = true;
							return;
					}


					const filtered = getFilteredRecords(records);

					filtered.sort(function(a, b)
					{
							return String(b.updatedAt).localeCompare(String(a.updatedAt));
					});


					const totalPages = Math.max(1, Math.ceil(filtered.length / inquiryPageSize));

					if (currentPage > totalPages)
					{
							currentPage = totalPages;
					}

					if (currentPage < 1)
					{
							currentPage = 1;
					}


					const startIndex = (currentPage - 1) * inquiryPageSize;
					const pageRecords = filtered.slice(startIndex, startIndex + inquiryPageSize);

					mgBody.replaceChildren();

					pageRecords.forEach(function(entry)
					{
							mgBody.append(createInquiryRow(entry));
					});


					mgPanel.hidden = filtered.length === 0;
					mgEmpty.hidden = records.length !== 0;
					mgNoMatches.hidden = !(records.length > 0 && filtered.length === 0);
					mgPagination.hidden = filtered.length <= inquiryPageSize;

					mgPrevPage.disabled = currentPage <= 1;
					mgNextPage.disabled = currentPage >= totalPages;
					mgPageInfo.textContent = "Page " + currentPage + " of " + totalPages;


					if (records.length === 0)
					{
							mgSummary.textContent = "No inquiries yet.";
					}
					else if (filtered.length === 0)
					{
							mgSummary.textContent = "No inquiries match the current filters.";
					}
					else
					{

							const shownFrom = startIndex + 1;
							const shownTo = startIndex + pageRecords.length;

							mgSummary.textContent = "Showing " + shownFrom + "-" + shownTo + " of " + filtered.length +
									(filtered.length === records.length
											? " inquiries"
											: " inquiries (" + records.length + " total)");

					}

			}

