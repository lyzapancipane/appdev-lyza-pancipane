					inquiryModalBody.append(buildElement("h4", "mg-response-heading", "Conversation"));

					const conversation = [];

					(entry.followUps || []).forEach(function(item)
					{
							conversation.push(
							{
									author: entry.student || "Student",
									date: item.date,
									text: item.text
							});
					});

					if (entry.response && entry.response.text)
					{
							conversation.push(
							{
									author: "EduBridge Team",
									date: entry.response.date,
									text: entry.response.text
							});
					}

					conversation.sort(function(a, b)
					{
							return String(a.date).localeCompare(String(b.date));
					});

					if (conversation.length === 0)
					{
							inquiryModalBody.append(buildElement("p", "mg-empty-note",
									"No response has been provided yet."));
					}
					else
					{
							conversation.forEach(function(item)
							{
									inquiryModalBody.append(createConversationItem(item.author, item.date, item.text));
							});
					}


					if (entry.response && entry.response.text)
					{
							inquiryModalBody.append(buildElement("h4", "mg-response-heading", "Response Receipt"));

							const receiptGrid = buildElement("div", "mg-detail-grid");

							receiptGrid.append(createDetailField("Receipt Reference",
									entry.response.receipt || getReceiptReference(entry.id)));
							receiptGrid.append(createDetailField("Date Answered", formatInquiryDate(entry.response.date)));
							receiptGrid.append(createDetailField("Responded By", entry.response.by || "Not available"));

							inquiryModalBody.append(receiptGrid);
					}


					const actions = buildElement("div", "modal-actions");

					if (entry.status === "Closed")
					{

							const reopenButton = buildElement("button", "modal-save", "Reopen Inquiry");
							reopenButton.type = "button";
							reopenButton.addEventListener("click", function()
							{
									reopenInquiry(entry.id);
							});
							actions.append(reopenButton);

					}
					else if (entry.status === "Pending")
					{
							const respondLink = buildElement("a", "modal-save", "Respond");
							respondLink.href = "response.html?id=" + encodeURIComponent(entry.id);
							actions.append(respondLink);
					}

					if (entry.response && entry.response.text)
					{
							const addFaqButton = buildElement("button", "cancel-button", "Add to FAQs");
							addFaqButton.type = "button";
							addFaqButton.addEventListener("click", function()
							{
									openFaqDraftModal(entry.id);
							});
							actions.append(addFaqButton);
					}

					const editButton = buildElement("button", "cancel-button", "Edit Inquiry");
					editButton.type = "button";
					editButton.addEventListener("click", function()
					{
							openEditModal(entry.id);
					});
					actions.append(editButton);

					if (entry.status === "Answered")
					{

							const closeButton = buildElement("button", "cancel-button", "Close Inquiry");
							closeButton.type = "button";
							closeButton.addEventListener("click", function()
							{
									applyStatusChange(entry.id, "Closed", "Inquiry closed.");
							});
							actions.append(closeButton);

					}

					const deleteButton = buildElement("button", "btn btn-danger btn-small", "Delete Inquiry");
					deleteButton.type = "button";
					deleteButton.addEventListener("click", function()
					{
							openDeleteModal(entry.id);
					});
					actions.append(deleteButton);

					inquiryModalBody.append(actions);


					if (inquiryModal.hidden)
					{
							openBackdrop(inquiryModal);
					}

			}

			function getReceiptReference(inquiryId)
			{

					return "RSP-" + String(inquiryId).replace(/^#?INQ-/, "");

			}

			function openFaqDraftModal(inquiryId)
			{

					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}

					const entry = findInquiryRecord(result.records, inquiryId);

					if (!entry || !entry.response || !entry.response.text)
					{
							showToast("That inquiry is no longer available.");
							faqDraftInquiryId = null;
							closeBackdrop(faqDraftModal);
							renderTable();
							return;
					}

					faqDraftInquiryId = entry.id;
					faqDraftQuestion.value = entry.subject || "";
					faqDraftAnswer.value = entry.response.text;
					faqDraftCategory.value = faqCategoryOptions.indexOf(entry.category) !== -1 ? entry.category : "General";
					faqDraftQuestionError.hidden = true;
					faqDraftAnswerError.hidden = true;
					faqDraftQuestion.classList.remove("is-invalid");
					faqDraftAnswer.classList.remove("is-invalid");

					openBackdrop(faqDraftModal);
					faqDraftQuestion.focus();

			}

			faqDraftClose.addEventListener("click", function()
			{
					faqDraftInquiryId = null;
					closeBackdrop(faqDraftModal);
			});

			faqDraftCancel.addEventListener("click", function()
			{
					faqDraftInquiryId = null;
					closeBackdrop(faqDraftModal);
			});

			faqDraftForm.addEventListener("submit", function(event)
			{

					event.preventDefault();

					const question = faqDraftQuestion.value.trim();
					const answer = faqDraftAnswer.value.trim();

					let valid = true;


					if (question.length < 5)
					{
							faqDraftQuestionError.hidden = false;
							faqDraftQuestionError.textContent = "Please enter a question with at least 5 characters.";
							faqDraftQuestion.classList.add("is-invalid");
							valid = false;
					}
					else
					{
							faqDraftQuestionError.hidden = true;
							faqDraftQuestion.classList.remove("is-invalid");
					}


					if (answer.length < 10)
					{
							faqDraftAnswerError.hidden = false;
							faqDraftAnswerError.textContent = "Please provide an answer with at least 10 characters.";
							faqDraftAnswer.classList.add("is-invalid");
							valid = false;
					}
					else
					{
							faqDraftAnswerError.hidden = true;
							faqDraftAnswer.classList.remove("is-invalid");
					}


					if (!valid)
					{
							showToast("Please complete all required fields.");
							return;
					}


					if (!faqDraftInquiryId)
					{
							showToast("That inquiry is no longer available.");
							closeBackdrop(faqDraftModal);
							return;
					}


					let drafts = [];

					try
					{
							const saved = JSON.parse(localStorage.getItem(faqDraftsStorageKey) || "[]");

							if (Array.isArray(saved))
							{
									drafts = saved;
							}
					}
					catch (error)
					{
							drafts = [];
					}


					drafts = drafts.filter(function(draft)
					{
							return draft.fromInquiry !== faqDraftInquiryId;
					});

					drafts.push(
					{
							id: "FAQDRAFT-" + String(Date.now()),
							question: question,
							answer: answer,
							category: faqDraftCategory.value,
							status: "unpublished",
							fromInquiry: faqDraftInquiryId,
							created: new Date().toISOString()
					});


					try
					{
							localStorage.setItem(faqDraftsStorageKey, JSON.stringify(drafts));
					}
					catch (error)
					{
							showToast("This browser could not save the FAQ draft.");
							return;
					}


					faqDraftInquiryId = null;
					closeBackdrop(faqDraftModal);
					showToast("FAQ draft saved. Review it in FAQs Management.");

			});

			function applyStatusChange(inquiryId, nextStatus, confirmation)
			{

					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}

					const entry = findInquiryRecord(result.records, inquiryId);

					if (!entry)
					{
							showToast("That inquiry is no longer available.");
							selectedInquiryId = null;
							closeBackdrop(inquiryModal);
							renderTable();
							return;
					}

					entry.status = nextStatus;
					entry.updatedAt = new Date().toISOString();


					try
					{
							writeInquiryRecords(result.records);
					}
					catch (error)
					{
							showToast("This browser could not save that change.");
							return;
					}

					showToast(confirmation);
					renderTable();

					if (!inquiryModal.hidden && selectedInquiryId === inquiryId)
					{
							openInquiryModal(inquiryId);
					}

			}

			function reopenInquiry(inquiryId)
			{

					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}

					const entry = findInquiryRecord(result.records, inquiryId);

					if (!entry)
					{
							showToast("That inquiry is no longer available.");
							renderTable();
							return;
					}

					const nextStatus = entry.response && entry.response.text ? "Answered" : "Pending";

					applyStatusChange(inquiryId, nextStatus, "Inquiry reopened.");

			}

			function openEditModal(inquiryId)
			{

					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}

					const entry = findInquiryRecord(result.records, inquiryId);

					if (!entry)
					{
							showToast("That inquiry is no longer available.");
							renderTable();
							return;
					}

					editInquiryId = entry.id;
					editSubject.value = entry.subject || "";
					editCategory.value = entry.category || "General";

					if (editCategory.selectedIndex === -1)
					{
							editCategory.selectedIndex = 0;
					}

					editMessage.value = entry.message || "";

					editSubjectError.hidden = true;
					editMessageError.hidden = true;
					editSubject.classList.remove("is-invalid");
					editMessage.classList.remove("is-invalid");

					openBackdrop(editModal);
					editSubject.focus();

			}

			function openDeleteModal(inquiryId)
			{

					pendingDeleteId = inquiryId;
					deleteModalText.textContent = "Are you sure you want to delete inquiry " + inquiryId +
							"? This action cannot be undone.";

					openBackdrop(deleteModal);

			}

			inquiryModalClose.addEventListener("click", function()
			{
					closeBackdrop(inquiryModal);
			});

			editModalClose.addEventListener("click", function()
			{
					closeBackdrop(editModal);
			});

			editCancel.addEventListener("click", function()
			{
					closeBackdrop(editModal);
			});

			deleteModalClose.addEventListener("click", function()
			{
					pendingDeleteId = null;
					closeBackdrop(deleteModal);
			});

			deleteCancel.addEventListener("click", function()
			{
					pendingDeleteId = null;
					closeBackdrop(deleteModal);
			});

			deleteConfirm.addEventListener("click", function()
			{

					if (!pendingDeleteId)
					{
							return;
					}


					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}


					const remaining = result.records.filter(function(entry)
					{
							return entry.id !== pendingDeleteId;
					});

					if (remaining.length === result.records.length)
					{
							showToast("That inquiry is no longer available.");
					}
					else
					{

							try
							{
									writeInquiryRecords(remaining);
							}
							catch (error)
							{
									showToast("This browser could not save that change.");
									return;
							}

							showToast("Inquiry deleted.");

					}


					const wasSelected = selectedInquiryId === pendingDeleteId;

					pendingDeleteId = null;
					closeBackdrop(deleteModal);

					if (wasSelected)
					{
							selectedInquiryId = null;
							closeBackdrop(inquiryModal);
					}

					renderTable();

			});

			[inquiryModal, editModal, deleteModal, faqDraftModal].forEach(function(backdrop)
			{
					backdrop.addEventListener("click", function(event)
					{

							if (event.target !== backdrop)
							{
									return;
							}

							if (backdrop === deleteModal)
							{
									pendingDeleteId = null;
							}

							if (backdrop === faqDraftModal)
							{
									faqDraftInquiryId = null;
							}

							closeBackdrop(backdrop);

					});
			});

			document.addEventListener("keydown", function(event)
			{

					if (event.key !== "Escape")
					{
							return;
					}

					if (!faqDraftModal.hidden)
					{
							faqDraftInquiryId = null;
							closeBackdrop(faqDraftModal);
					}
					else if (!deleteModal.hidden)
					{
							pendingDeleteId = null;
							closeBackdrop(deleteModal);
					}
					else if (!editModal.hidden)
					{
							closeBackdrop(editModal);
					}
					else if (!inquiryModal.hidden)
					{
							closeBackdrop(inquiryModal);
					}

			});

			editForm.addEventListener("submit", function(event)
			{

					event.preventDefault();


					const subject = editSubject.value.trim();
					const message = editMessage.value.trim();

					let valid = true;


					if (subject.length < 3)
					{
							editSubjectError.hidden = false;
							editSubjectError.textContent = "Please enter a subject with at least 3 characters.";
							editSubject.classList.add("is-invalid");
							valid = false;
					}
					else
					{
							editSubjectError.hidden = true;
							editSubject.classList.remove("is-invalid");
					}


					if (message.length < 10)
					{
							editMessageError.hidden = false;
							editMessageError.textContent = "Please provide at least 10 characters of details.";
							editMessage.classList.add("is-invalid");
							valid = false;
					}
					else
					{
							editMessageError.hidden = true;
							editMessage.classList.remove("is-invalid");
					}


					if (!valid)
					{
							showToast("Please complete all required fields.");
							return;
					}


					const result = readInquiryRecords();

					if (!result.ok)
					{
							showToast("Inquiry records could not be read from this browser.");
							return;
					}

					const entry = findInquiryRecord(result.records, editInquiryId);

					if (!entry)
					{
							showToast("That inquiry is no longer available.");
							closeBackdrop(editModal);
							renderTable();
							return;
					}

					entry.subject = subject;
					entry.category = editCategory.value;
					entry.message = message;
					entry.updatedAt = new Date().toISOString();


					try
					{
							writeInquiryRecords(result.records);
					}
					catch (error)
					{
							showToast("This browser could not save that change.");
							return;
					}

					showToast("Inquiry updated.");
					closeBackdrop(editModal);
					renderTable();

					if (!inquiryModal.hidden && selectedInquiryId === entry.id)
					{
							openInquiryModal(entry.id);
					}

			});

			mgSearch.addEventListener("input", function()
			{
					activeQuery = mgSearch.value.trim();
					currentPage = 1;
					renderTable();
			});

			mgCategoryFilter.addEventListener("change", function()
			{
					activeCategory = mgCategoryFilter.value;
					currentPage = 1;
					renderTable();
			});

			mgStatusFilter.addEventListener("change", function()
			{
					activeStatus = mgStatusFilter.value;
					currentPage = 1;
					renderTable();
			});

			function resetFilters()
			{

					activeQuery = "";
					activeCategory = "all";
					activeStatus = "all";
					currentPage = 1;

					mgSearch.value = "";
					mgCategoryFilter.value = "all";
					mgStatusFilter.value = "all";

					renderTable();

			}

			mgClearFilters.addEventListener("click", resetFilters);
			mgClearFiltersEmpty.addEventListener("click", resetFilters);

			mgPrevPage.addEventListener("click", function()
			{
					if (currentPage > 1)
					{
							currentPage -= 1;
							renderTable();
					}
			});

			mgNextPage.addEventListener("click", function()
			{
					currentPage += 1;
					renderTable();
			});

			seedSampleRecords();
			renderTable();

		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>

</body>
