			function formatInquiryDate(value)
			{

					if (!value)
					{
							return "Date not available";
					}

					const parsed = new Date(value);

					if (Number.isNaN(parsed.getTime()))
					{
							return "Date not available";
					}

					return parsed.toLocaleString("en-US",
					{
							month: "long",
							day: "numeric",
							year: "numeric",
							hour: "numeric",
							minute: "2-digit"
					});

			}

			function formatInquiryDay(value)
			{

					if (!value)
					{
							return "—";
					}

					const parsed = new Date(value);

					if (Number.isNaN(parsed.getTime()))
					{
							return "—";
					}

					return parsed.toLocaleDateString("en-US",
					{
							month: "long",
							day: "numeric",
							year: "numeric"
					});

			}

			function generateInquiryId(records)
			{

					let maxSequence = 0;
					const currentYear = String(new Date().getFullYear());

					records.forEach(function(entry)
					{
							const match = /^#INQ-(\d{4})-(\d{4,})$/.exec(entry.id || "");

							if (match)
							{
									maxSequence = Math.max(maxSequence, Number(match[2]));
							}
					});

					const nextSequence = String(maxSequence + 1).padStart(4, "0");

					return "#INQ-" + currentYear + "-" + nextSequence;

			}

			function readInquiryRecords()
			{

					let saved = null;

					try
					{
							saved = JSON.parse(localStorage.getItem(inquiriesStorageKey) || "[]");
					}
					catch (error)
					{
							return { ok: false, records: [] };
					}

					if (!Array.isArray(saved))
					{
							return { ok: false, records: [] };
					}


					let changed = false;

					const migrated = saved.map(function(record)
					{

							const entry = Object.assign({}, record || {});

							if (!entry.createdAt)
							{
									entry.createdAt = entry.updatedAt || new Date().toISOString();
									changed = true;
							}

							if (!entry.updatedAt)
							{
									entry.updatedAt = entry.createdAt;
									changed = true;
							}

							if (!entry.status)
							{
									entry.status = "Pending";
									changed = true;
							}

							if (entry.status === "In Progress")
							{
									entry.status = "Pending";
									changed = true;
							}

							if (entry.status === "Resolved")
							{
									entry.status = "Closed";
									changed = true;
							}

							if (!entry.category)
							{
									entry.category = "General";
									changed = true;
							}

							if (!entry.student)
							{
									entry.student = "";
									changed = true;
							}

							if (!Array.isArray(entry.followUps))
							{
									entry.followUps = [];
									changed = true;
							}

							if (entry.response && !entry.response.text)
							{
									entry.response = null;
									changed = true;
							}

							return entry;

					});


					migrated.forEach(function(entry)
					{
							if (!entry.id)
							{
									entry.id = generateInquiryId(migrated);
									changed = true;
							}
					});

					if (changed)
					{

							try
							{
									localStorage.setItem(inquiriesStorageKey, JSON.stringify(migrated));
							}
							catch (error)
							{
							}

					}

					return { ok: true, records: migrated };

			}

