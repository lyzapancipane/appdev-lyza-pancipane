<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>
		EduBridge | Student Portal
	</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="EduBridge is the student portal for school announcements, upcoming events, frequently asked questions, and direct inquiries, all in one place.">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

	<style>
		*
		{
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		:root
		{
			--background: #f3f3f3;
			--surface: #ffffff;
			--surface-soft: #faf9fc;
			--text: #17152d;
			--text-soft: #696774;
			--text-muted: #77737e;
			--border: #e1e1e1;
			--purple: #7138c8;
			--purple-light: #eee5ff;
			--purple-soft: #eadcff;
			--shadow: rgba(40, 24, 75, 0.08);
		}

		body.dark-mode
		{
			--background: #090817;
			--surface: #131124;
			--surface-soft: #18162b;
			--text: #f7f3ff;
			--text-soft: #c4bfd2;
			--text-muted: #9e99ae;
			--border: #2d2941;
			--purple: #a970ff;
			--purple-light: #251b3b;
			--purple-soft: #241934;
			--shadow: rgba(0, 0, 0, 0.35);
		}

		html
		{
			scroll-behavior: smooth;
			scroll-padding-top: 78px;
		}

		body
		{
			overflow-x: hidden;
			background: var(--background);
			color: var(--text);
			font-family: Poppins, Arial, sans-serif;
			transition: background 0.45s ease, color 0.45s ease;
		}

		body.dark-mode
		{
			background:
				radial-gradient(circle at 12% 10%, rgba(113, 56, 200, 0.12), transparent 28%),
				radial-gradient(circle at 88% 45%, rgba(68, 72, 190, 0.08), transparent 30%),
				#090817;
		}

		a
		{
			color: inherit;
			text-decoration: none;
		}

		button
		{
			font: inherit;
			cursor: pointer;
		}

		img
		{
			max-width: 100%;
		}

		.cursor-gradient
		{
			position: fixed;
			z-index: 9998;
			top: 0;
			left: 0;
			width: 500px;
			height: 500px;
			border-radius: 50%;
			transform: translate(-50%, -50%);
			pointer-events: none;
			opacity: 0;
			background: radial-gradient(circle, rgba(185, 120, 255, 0.16) 0%, rgba(86, 105, 255, 0.10) 28%, rgba(225, 80, 160, 0.06) 48%, transparent 72%);
			filter: blur(32px);
			transition: opacity 0.35s ease;
		}

		body.cursor-ready .cursor-gradient
		{
			opacity: 1;
		}

		body.dark-mode .cursor-gradient
		{
			background: radial-gradient(circle, rgba(174, 112, 255, 0.23) 0%, rgba(88, 103, 255, 0.14) 30%, rgba(228, 78, 173, 0.08) 50%, transparent 73%);
		}

		body.theme-changing::before
		{
			position: fixed;
			z-index: 9999;
			top: var(--theme-y);
			left: var(--theme-x);
			width: 30px;
			height: 30px;
			border-radius: 50%;
			background: var(--theme-circle);
			content: "";
			pointer-events: none;
			transform: translate(-50%, -50%) scale(0);
			animation: themeReveal 0.65s ease-out forwards;
		}

		@keyframes themeReveal
		{
			0%
			{
				opacity: 0.35;
				transform: translate(-50%, -50%) scale(0);
			}

			100%
			{
				opacity: 0;
				transform: translate(-50%, -50%) scale(100);
			}
		}

		/* ------------------------------------------------------------------
		   NAVBAR
		------------------------------------------------------------------ */

		.navbar
		{
			position: fixed;
			z-index: 1000;
			top: 0;
			left: 0;
			display: flex;
			width: 100%;
			height: 88px;
			align-items: center;
			justify-content: space-between;
			padding: 0 36px;
			background: linear-gradient(180deg, rgba(24, 8, 58, 0.92), rgba(24, 8, 58, 0.55) 70%, transparent);
			color: white;
			transition: height 0.35s ease, background 0.35s ease, box-shadow 0.35s ease, backdrop-filter 0.35s ease;
		}

		.navbar.scrolled
		{
			height: 72px;
			background: rgba(20, 7, 51, 0.88);
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.22);
			backdrop-filter: blur(14px);
		}

		.logo
		{
			display: flex;
			align-items: center;
			gap: 4px;
			font-size: 18px;
			font-weight: 700;
			white-space: nowrap;
		}

		.logo img
		{
			width: 76px;
			height: 76px;
			flex-shrink: 0;
			object-fit: contain;
			transition: transform 0.3s ease;
		}

		.logo:hover img
		{
			transform: rotate(-4deg) scale(1.04);
		}

		.brand-bridge
		{
			color: #b77aff;
		}

		.brand-name
		{
			display: flex;
			align-items: center;
			margin-left: -3px;
			letter-spacing: -0.4px;
		}

		.brand-edu
		{
			color: white;
		}

		.nav-links
		{
			display: flex;
			align-items: center;
			gap: 26px;
			font-size: 13px;
		}

		.nav-links a
		{
			position: relative;
			color: #ffffffdd;
			transition: color 0.2s ease;
		}

		.nav-links a::after
		{
			position: absolute;
			right: 50%;
			bottom: -7px;
			left: 50%;
			height: 2px;
			border-radius: 10px;
			background: #b77aff;
			content: "";
			transition: left 0.25s ease, right 0.25s ease;
		}

		.nav-links a:hover,
		.nav-links a:focus-visible,
		.nav-links .active
		{
			color: #c58cff;
		}

		.nav-links a:hover::after,
		.nav-links a:focus-visible::after,
		.nav-links .active::after
		{
			right: 0;
			left: 0;
		}

		.nav-actions
		{
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.theme-button,
		.menu-button
		{
			display: inline-flex;
			width: 34px;
			height: 34px;
			align-items: center;
			justify-content: center;
			border: 1px solid #ffffff55;
			border-radius: 6px;
			background: #ffffff12;
			color: white;
			transition: 0.25s ease;
		}

		.theme-button:hover,
		.menu-button:hover
		{
			transform: translateY(-2px);
			border-color: #ffffff88;
			background: #ffffff20;
		}

		.theme-button svg,
		.menu-button svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
		}

		.nav-bell
		{
			display: flex;
			width: 34px;
			height: 34px;
			align-items: center;
			justify-content: center;
			border: 1px solid #ffffff55;
			border-radius: 6px;
			background: #ffffff12;
			color: white;
			transition: 0.25s ease;
		}

		.nav-bell:hover,
		.nav-bell:focus-visible
		{
			background: var(--purple);
			border-color: #a970ff;
			transform: translateY(-2px);
		}

		.nav-bell:active
		{
			transform: scale(0.88);
		}

		.nav-bell svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
		}

		.nav-login
		{
			display: inline-flex;
			height: 34px;
			align-items: center;
			gap: 7px;
			padding: 0 18px;
			border: 1px solid transparent;
			border-radius: 6px;
			background: linear-gradient(135deg, #8b5cf6, #6d3fe0);
			color: white;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 0.3px;
			box-shadow: 0 6px 16px rgba(109, 63, 224, 0.35);
			transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
		}

		.nav-login:hover,
		.nav-login:focus-visible
		{
			transform: translateY(-2px);
			filter: brightness(1.08);
			box-shadow: 0 10px 22px rgba(109, 63, 224, 0.45);
		}

		.nav-login:active
		{
			transform: scale(0.96);
		}

		.nav-login svg
		{
			width: 14px;
			height: 14px;
			fill: currentColor;
		}

		.menu-button
		{
			display: none;
		}

		/* ------------------------------------------------------------------
		   HERO
		------------------------------------------------------------------ */

		.hero
		{
			position: relative;
			display: flex;
			min-height: 560px;
			align-items: center;
			overflow: hidden;
			isolation: isolate;
			padding: 140px 36px 90px;
			background: #08051d;
		}

		.hero-image,
		.hero-base,
		.gradient-layer,
		.hero-overlay,
		.hero-watermark
		{
			position: absolute;
			inset: 0;
			pointer-events: none;
		}

		.hero-image
		{
			z-index: -10;
			background-image: url("Edubridge-Hero-About.png");
			background-position: center 45%;
			background-size: cover;
			opacity: 0.62;
			transform: scale(1.04);
			transition: transform 0.8s ease, opacity 0.8s ease;
		}

		.hero-base
		{
			z-index: -9;
			background: linear-gradient(135deg, rgba(5, 5, 35, 0.76), rgba(14, 4, 40, 0.34), rgba(5, 5, 30, 0.68));
		}

		.hero-watermark
		{
			z-index: -8;
			background-image: url("Edubridge-Logo.png");
			background-position: right -40px center;
			background-repeat: no-repeat;
			background-size: 460px auto;
			opacity: 0.16;
		}

		.gradient-layer
		{
			z-index: -7;
			overflow: hidden;
		}

		.gradient
		{
			position: absolute;
			border-radius: 50%;
			mix-blend-mode: screen;
			opacity: 0.72;
			filter: blur(65px);
			transform: translate(-50%, -50%);
		}

		.gradient-purple
		{
			top: var(--purple-y, 5%);
			left: var(--purple-x, 4%);
			width: 430px;
			height: 430px;
			background: #7138c8;
			animation: purpleFloat 12s ease-in-out infinite alternate;
		}

		.gradient-blue
		{
			top: var(--blue-y, 8%);
			left: var(--blue-x, 93%);
			width: 390px;
			height: 390px;
			background: #315ee8;
			animation: blueFloat 14s ease-in-out infinite alternate;
		}

		.gradient-pink
		{
			top: var(--pink-y, 57%);
			left: var(--pink-x, 15%);
			width: 360px;
			height: 360px;
			background: #d94f91;
			animation: pinkFloat 13s ease-in-out infinite alternate;
		}

		.gradient-violet
		{
			top: var(--violet-y, 38%);
			left: var(--violet-x, 55%);
			width: 430px;
			height: 430px;
			background: #933cff;
			animation: violetFloat 15s ease-in-out infinite alternate;
		}

		.gradient-orange
		{
			top: var(--orange-y, 88%);
			left: var(--orange-x, 94%);
			width: 400px;
			height: 400px;
			background: #e69a42;
			animation: orangeFloat 11s ease-in-out infinite alternate;
		}

		.gradient-cyan
		{
			top: var(--cyan-y, 93%);
			left: var(--cyan-x, 5%);
			width: 340px;
			height: 340px;
			background: #387ee8;
			animation: cyanFloat 16s ease-in-out infinite alternate;
		}

		.gradient-pink-small
		{
			top: var(--pink-small-y, 67%);
			left: var(--pink-small-x, 78%);
			width: 270px;
			height: 270px;
			background: #b73fbd;
			animation: smallPinkFloat 12s ease-in-out infinite alternate;
		}

		.hero-overlay
		{
			z-index: -6;
			background: linear-gradient(90deg, rgba(5, 5, 35, 0.62), rgba(10, 5, 35, 0.16), rgba(5, 5, 35, 0.46));
		}

		.hero-content
		{
			position: relative;
			z-index: 2;
			display: flex;
			width: 100%;
			max-width: 1180px;
			margin: 0 auto;
		}

		.hero-copy
		{
			max-width: 660px;
		}

		.hero-label
		{
			margin-bottom: 14px;
			color: #c18cff;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 2.5px;
			text-transform: uppercase;
		}

		.hero h1
		{
			margin-bottom: 18px;
			color: white;
			font-weight: 700;
			line-height: 1.08;
		}

		.hero h1 .hero-welcome
		{
			display: block;
			font-size: 38px;
			font-weight: 600;
		}

		.hero h1 .hero-name
		{
			display: block;
			font-size: 68px;
			letter-spacing: -1px;
		}

		.hero h1 .hero-name span
		{
			color: #b77aff;
			background: linear-gradient(100deg, #c58cff 0%, #9a6bff 55%, #6f8dff 100%);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.hero-lead
		{
			margin-bottom: 6px;
			color: #ffffff;
			font-size: 17px;
			font-weight: 600;
		}

		.hero-lead span
		{
			color: #b77aff;
		}

		.hero-copy > p:not(.hero-lead)
		{
			max-width: 560px;
			color: #d5d1df;
			font-size: 15px;
			line-height: 1.8;
		}

		.hero-actions
		{
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 28px;
		}

		.button-primary,
		.button-secondary
		{
			display: inline-flex;
			min-height: 44px;
			align-items: center;
			justify-content: center;
			gap: 8px;
			padding: 0 24px;
			border: 1px solid transparent;
			border-radius: 8px;
			font-size: 13px;
			font-weight: 600;
			transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.button-primary
		{
			background: linear-gradient(135deg, #7c3aed, #6431d4);
			color: white;
			box-shadow: 0 10px 22px rgba(109, 63, 224, 0.3);
		}

		.button-primary:hover
		{
			transform: translateY(-3px);
			background: linear-gradient(135deg, #8c50df, #7138c8);
			box-shadow: 0 14px 28px rgba(113, 56, 200, 0.4);
		}

		.button-primary:active,
		.button-secondary:active
		{
			transform: scale(0.97);
		}

		.button-secondary
		{
			border-color: #ffffff66;
			background: #ffffff12;
			color: white;
		}

		.button-secondary:hover
		{
			transform: translateY(-3px);
			border-color: #c18cff;
			background: #ffffff1e;
		}

		.button-arrow
		{
			display: inline-flex;
			transition: transform 0.25s ease;
		}

		.button-primary:hover .button-arrow,
		.button-secondary:hover .button-arrow,
		.nav-login:hover .button-arrow
		{
			transform: translateX(4px);
		}

		.button-arrow svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
		}

		/* ------------------------------------------------------------------
		   SHARED SECTION STYLES
		------------------------------------------------------------------ */

		.container
		{
			width: 100%;
			max-width: 1180px;
			margin: 0 auto;
			padding: 0 20px;
		}

		.section-heading
		{
			margin-bottom: 36px;
			text-align: center;
		}

		.section-label
		{
			margin-bottom: 8px;
			color: var(--purple);
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 2.5px;
			text-transform: uppercase;
		}

		.section-heading h2
		{
			margin-bottom: 8px;
			color: var(--text);
			font-size: 34px;
			font-weight: 700;
			letter-spacing: -0.5px;
		}

		.section-heading p
		{
			max-width: 640px;
			margin: 0 auto;
			color: var(--text-muted);
			font-size: 14px;
			line-height: 1.7;
		}

		.light-section
		{
			background: var(--surface);
		}

		/* ------------------------------------------------------------------
		   B. EVERYTHING YOU NEED, ALL IN ONE PLACE
		------------------------------------------------------------------ */

		.features-section
		{
			padding: 75px 0 85px;
		}

		.feature-grid
		{
			display: grid;
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 18px;
		}

		.feature-card
		{
			display: flex;
			flex-direction: column;
			padding: 26px 20px 22px;
			border: 1px solid var(--border);
			border-radius: 14px;
			background: var(--surface);
			box-shadow: 0 6px 22px var(--shadow);
			transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
		}

		.feature-card:hover,
		.feature-card:focus-visible
		{
			transform: translateY(-8px);
			border-color: #b77aff;
			box-shadow: 0 18px 34px var(--shadow), 0 0 24px rgba(113, 56, 200, 0.12);
		}

		.feature-icon
		{
			display: flex;
			width: 54px;
			height: 54px;
			align-items: center;
			justify-content: center;
			margin-bottom: 18px;
			border-radius: 50%;
			background: linear-gradient(135deg, #9061f9, #6d3fe0);
			color: white;
			box-shadow: 0 10px 20px rgba(113, 56, 200, 0.28);
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		.feature-card:nth-child(even) .feature-icon
		{
			background: linear-gradient(135deg, #6d8ffc, #3f63e8);
			box-shadow: 0 10px 20px rgba(63, 99, 232, 0.28);
		}

		.feature-card:hover .feature-icon
		{
			transform: rotate(-6deg) scale(1.1);
			box-shadow: 0 14px 26px rgba(113, 56, 200, 0.38);
		}

		.feature-icon svg
		{
			width: 24px;
			height: 24px;
			fill: currentColor;
		}

		.feature-card strong
		{
			display: block;
			margin-bottom: 8px;
			color: var(--text);
			font-size: 15px;
			font-weight: 600;
		}

		.feature-card p
		{
			color: var(--text-muted);
			font-size: 12.5px;
			line-height: 1.7;
		}

		.feature-action
		{
			display: inline-flex;
			align-items: center;
			gap: 4px;
			margin-top: auto;
			padding-top: 14px;
			color: var(--purple);
			font-size: 11px;
			font-weight: 600;
			transition: gap 0.25s ease;
		}

		.feature-card:hover .feature-action
		{
			gap: 8px;
		}

		/* ------------------------------------------------------------------
		   C. HOW EDUBRIDGE HELPS
		------------------------------------------------------------------ */

		.helps-section
		{
			position: relative;
			overflow: hidden;
			padding: 80px 0 90px;
			background:
				radial-gradient(circle at 85% 20%, rgba(120, 70, 220, 0.45), transparent 42%),
				radial-gradient(circle at 10% 90%, rgba(60, 60, 200, 0.3), transparent 45%),
				linear-gradient(120deg, #0a0724 0%, #1a1140 45%, #33196e 100%);
			color: white;
		}

		.helps-section .gradient
		{
			opacity: 0.4;
		}

		.helps-heading
		{
			margin-bottom: 48px;
			text-align: center;
		}

		.helps-heading h2
		{
			margin-bottom: 10px;
			color: white;
			font-size: 34px;
			font-weight: 700;
			letter-spacing: -0.5px;
		}

		.helps-heading p
		{
			max-width: 620px;
			margin: 0 auto;
			color: #cfc7e8;
			font-size: 14px;
			line-height: 1.7;
		}

		.helps-grid
		{
			display: grid;
			grid-template-columns: 320px minmax(0, 1fr);
			gap: 50px;
			align-items: center;
		}

		.helps-visual
		{
			position: relative;
			display: flex;
			min-height: 300px;
			align-items: center;
			justify-content: center;
		}

		.helps-orbit
		{
			position: absolute;
			width: 250px;
			height: 250px;
			border: 1px solid #ffffff2e;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(174, 112, 255, 0.32), rgba(174, 112, 255, 0.04) 68%, transparent 70%);
		}

		.helps-orbit.orbit-small
		{
			width: 180px;
			height: 180px;
			border-style: dashed;
			border-color: #ffffff24;
			background: transparent;
			animation: orbitSpin 26s linear infinite;
		}

		.helps-icon
		{
			position: relative;
