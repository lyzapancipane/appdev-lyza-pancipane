			height: 17px;
			fill: currentColor;
		}

		.reveal
		{
			opacity: 1;
			transform: translateY(0);
		}

		body.js .reveal
		{
			opacity: 0;
			transform: translateY(28px);
			transition: opacity 0.7s ease, transform 0.7s ease;
		}

		body.js .reveal.visible
