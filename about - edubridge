<!DOCTYPE html>
<head>
    <title>About EduBridge</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --background: #f3f3f3;
            --surface: #ffffff;
            --surface-soft: #faf9fc;
            --text: #17152d;
            --text-soft: #696774;
            --text-muted: #77737e;
            --border: #e1e1e1;
            --purple: #7138c8;
            --purple-light: #eee5ff;
            --purple-soft: #eadcff;
            --shadow: rgba(40, 24, 75, 0.08);
            --mission-text: #eee8f6;
        }

        body.dark-mode {
            --background: #090817;
            --surface: #131124;
            --surface-soft: #18162b;
            --text: #f7f3ff;
            --text-soft: #c4bfd2;
            --text-muted: #9e99ae;
            --border: #2d2941;
            --purple: #a970ff;
            --purple-light: #251b3b;
            --purple-soft: #241934;
            --shadow: rgba(0, 0, 0, 0.35);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Poppins, Arial, sans-serif;
            color: var(--text);
            background: var(--background);
            overflow-x: hidden;
            transition: background 0.45s ease, color 0.45s ease;
        }

        body.dark-mode {
            background:
                radial-gradient(
                    circle at 12% 10%,
                    rgba(113, 56, 200, 0.12),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 88% 45%,
                    rgba(68, 72, 190, 0.08),
                    transparent 30%
                ),
                #090817;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        body.theme-changing::before {
            content: "";
            position: fixed;
            width: 30px;
            height: 30px;
            left: var(--theme-x);
            top: var(--theme-y);
            transform: translate(-50%, -50%) scale(0);
            border-radius: 50%;
            background: var(--theme-circle);
            z-index: 9999;
            pointer-events: none;
            animation: themeReveal 0.65s ease-out forwards;
        }

        @keyframes themeReveal {
            0% {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0.35;
            }

            100% {
                transform: translate(-50%, -50%) scale(100);
                opacity: 0;
            }
        }

        .cursor-gradient {
            position: fixed;
            width: 500px;
            height: 500px;
            left: 0;
            top: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9998;
            opacity: 0;
            background:
                radial-gradient(
                    circle,
                    rgba(185, 120, 255, 0.16) 0%,
                    rgba(86, 105, 255, 0.10) 28%,
                    rgba(225, 80, 160, 0.06) 48%,
                    transparent 72%
                );
            filter: blur(32px);
            transition: opacity 0.35s ease;
        }

        body.cursor-ready .cursor-gradient {
            opacity: 1;
        }

        body.dark-mode .cursor-gradient {
            background:
                radial-gradient(
                    circle,
                    rgba(174, 112, 255, 0.23) 0%,
                    rgba(88, 103, 255, 0.14) 30%,
                    rgba(228, 78, 173, 0.08) 50%,
                    transparent 73%
                );
        }

        .navbar {
            height: 88px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 20;
            color: white;
            transition:
                height 0.3s ease,
                background 0.3s ease,
                box-shadow 0.3s ease,
                backdrop-filter 0.3s ease;
        }

        .navbar.scrolled {
            height: 72px;
            background: rgba(8, 5, 29, 0.82);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
            backdrop-filter: blur(14px);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 2px;
            font-size: 18px;
            font-weight: 600;
            white-space: nowrap;
        }

        .logo img {
            width: 90px;
            height: 90px;
            object-fit: contain;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .logo:hover img {
            transform: rotate(-4deg) scale(1.04);
        }

        .brand-name {
            display: flex;
            align-items: center;
            margin-left: -3px;
            letter-spacing: -0.4px;
        }

        .brand-edu {
            color: white;
        }

        .brand-bridge {
            color: #7339c2;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 13px;
        }

        .nav-links a {
            position: relative;
            color: #ffffffdd;
            transition: 0.2s;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: -7px;
            width: 0;
            height: 2px;
            border-radius: 10px;
            background: #b77aff;
            transform: translateX(-50%);
            transition: width 0.25s ease;
        }

        .nav-links a:hover,
        .nav-links .active {
            color: #c58cff;
        }

        .nav-links a:hover::after,
        .nav-links .active::after {
            width: 100%;
        }

        .nav-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .theme-button,
        .login-button {
            height: 34px;
            border: 1px solid #ffffff55;
            border-radius: 5px;
            background: #ffffff12;
            color: white;
            transition: 0.25s ease;
        }

        .menu-button
        {
            display: none;
            width: 34px;
            height: 34px;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff55;
            border-radius: 5px;
            background: #ffffff12;
            color: white;
            transition: 0.25s ease;
        }

        .theme-button {
            width: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-button:hover,
        .menu-button:hover
        {
            background: #ffffff20;
            border-color: #ffffff88;
            transform: translateY(-2px) rotate(8deg);
        }

        .theme-button:active {
            transform: scale(0.88);
        }

        .menu-button:active
        {
            transform: scale(0.88);
        }

        .theme-button svg,
        .menu-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .login-button
        {
            display: inline-flex;
            padding: 0 15px;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .login-button:hover {
            background: #7138c8;
            border-color: #a970ff;
            transform: translateY(-2px);
        }

        .login-button:active {
            transform: scale(0.96);
        }

        .hero {
            min-height: 470px;
            padding: 130px 36px 70px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background: #08051d;
        }

        .hero-image {
            position: absolute;
            inset: 0;
            z-index: -10;
            background-image: url("Edubridge-Hero-About.png");
            background-size: cover;
            background-position: center;
            opacity: 0.62;
            transform: scale(1.04);
            transition: transform 0.25s ease-out;
        }

        .hero-base {
            position: absolute;
            inset: 0;
            z-index: -9;
            background:
                linear-gradient(
                    135deg,
                    rgba(5, 5, 35, 0.7),
                    rgba(14, 4, 40, 0.32),
                    rgba(5, 5, 30, 0.65)
                );
        }

        .gradient-layer {
            position: absolute;
            inset: 0;
            z-index: -8;
            overflow: hidden;
            pointer-events: none;
        }

        .gradient {
            position: absolute;
            border-radius: 50%;
            filter: blur(65px);
            mix-blend-mode: screen;
            opacity: 0.72;
        }

        .gradient-purple {
            width: 430px;
            height: 430px;
            background: #7138c8;
            left: var(--purple-x, 4%);
            top: var(--purple-y, 5%);
            animation: purpleFloat 12s ease-in-out infinite alternate;
        }

        .gradient-blue {
            width: 390px;
            height: 390px;
            background: #315ee8;
            left: var(--blue-x, 93%);
            top: var(--blue-y, 8%);
            animation: blueFloat 14s ease-in-out infinite alternate;
        }

        .gradient-pink {
            width: 360px;
            height: 360px;
            background: #d94f91;
            left: var(--pink-x, 15%);
            top: var(--pink-y, 57%);
            animation: pinkFloat 13s ease-in-out infinite alternate;
        }

        .gradient-violet {
            width: 430px;
            height: 430px;
            background: #933cff;
            left: var(--violet-x, 55%);
            top: var(--violet-y, 38%);
            animation: violetFloat 15s ease-in-out infinite alternate;
        }

        .gradient-orange {
            width: 400px;
            height: 400px;
            background: #e69a42;
            left: var(--orange-x, 94%);
            top: var(--orange-y, 88%);
            animation: orangeFloat 11s ease-in-out infinite alternate;
        }

        .gradient-cyan {
            width: 340px;
            height: 340px;
            background: #387ee8;
            left: var(--cyan-x, 5%);
            top: var(--cyan-y, 93%);
            animation: cyanFloat 16s ease-in-out infinite alternate;
        }

        .gradient-pink-small {
            width: 270px;
            height: 270px;
            background: #b73fbd;
            left: var(--pink-small-x, 78%);
            top: var(--pink-small-y, 67%);
            animation: smallPinkFloat 12s ease-in-out infinite alternate;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: -6;
            pointer-events: none;
            background:
                linear-gradient(
                    90deg,
                    rgba(5, 5, 35, 0.58),
                    rgba(10, 5, 35, 0.12),
                    rgba(5, 5, 35, 0.52)
                );
        }

        .hero-content {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            position: relative;
            z-index: 5;
        }

        .hero-label {
            color: #c18cff;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .hero h1 {
            color: white;
            font-size: 52px;
            line-height: 1.1;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .hero h1 span {
            color: #b77aff;
        }

        .hero p {
            max-width: 650px;
            color: #d5d1df;
            font-size: 15px;
            line-height: 1.8;
        }

        .about-section,
        .team-section,
        .mission-section {
            width: 100%;
            max-width: 1180px;
            margin-left: auto;
            margin-right: auto;
        }

        .about-section {
            padding: 45px 0;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1.15fr;
            gap: 18px;
        }

        .about-card {
            min-height: 185px;
            padding: 22px;
            display: flex;
            gap: 15px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface);
            box-shadow: 0 5px 20px var(--shadow);
            transition: 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .about-card:hover {
            transform: translateY(-5px);
            border-color: #a970ff;
            box-shadow:
                0 15px 35px var(--shadow),
                0 0 22px rgba(113, 56, 200, 0.08);
        }

        .about-card.highlight {
            background: var(--purple-soft);
            border-color: #cda9ef;
        }

        .about-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--purple);
            font-size: 20px;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .about-card:hover .about-icon {
            transform: rotate(-5deg) scale(1.08);
        }

        .highlight .about-icon {
            background: #7138c8;
            color: white;
        }

        .about-card h3 {
            color: var(--purple);
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .about-card p {
            color: var(--text-soft);
            font-size: 13px;
            line-height: 1.7;
        }

        .difference-list {
            padding-left: 18px;
            color: var(--text-soft);
            font-size: 13px;
            line-height: 1.9;
        }

        .team-section {
            padding: 10px 0 55px;
            text-align: center;
        }

        .team-label {
            color: var(--purple);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 6px;
        }

        .team-section h2 {
            font-size: 32px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 10px;
        }

        .team-description {
            max-width: 650px;
            margin: 0 auto 30px;
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .team-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface);
            text-align: left;
            box-shadow: 0 5px 20px var(--shadow);
            transition: 0.3s ease;
        }

        .team-card:hover {
            transform: translateY(-6px);
            border-color: #b77aff;
            box-shadow:
                0 15px 35px var(--shadow),
                0 0 25px rgba(183, 122, 255, 0.1);
        }

        .team-card:hover .team-info {
            background:
                linear-gradient(
                    180deg,
                    var(--surface),
                    var(--purple-light)
                );
        }

        .team-card:hover .team-name-row h3 {
            color: var(--purple);
        }

        .team-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            position: relative;
            background: #17152d;
        }

        .team-image::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            background:
                linear-gradient(
                    135deg,
                    rgba(113, 56, 200, 0.18),
                    transparent 45%,
                    rgba(0, 0, 0, 0.12)
                );
            pointer-events: none;
        }

        .team-image::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 35%;
            z-index: 3;
            background:
                linear-gradient(
                    transparent,
                    rgba(10, 7, 25, 0.3)
                );
            pointer-events: none;
        }

        .team-card img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .team-card:hover img {
            transform: scale(1.06);
        }

        .team-info {
            padding: 16px 16px 17px;
            background: var(--surface);
            transition: 0.3s ease;
        }

        .team-name-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .team-info h3 {
            color: var(--text);
            font-size: 15px;
            font-weight: 600;
        }

        .team-role-icon {
            width: 27px;
            height: 27px;
            min-width: 27px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--purple);
            transition: 0.3s ease;
        }

        .team-card:hover .team-role-icon {
            transform: rotate(8deg);
        }

        .team-role-icon svg,
        .team-role svg {
            fill: currentColor;
        }

        .team-role-icon svg {
            width: 14px;
            height: 14px;
        }

        .team-role {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--purple);
            font-size: 10px;
            font-weight: 600;
            line-height: 1.5;
        }

        .team-role svg {
            width: 13px;
            height: 13px;
            flex-shrink: 0;
        }

        .team-role + .team-role {
            margin-top: 4px;
        }

        .mission-section {
            margin-bottom: 55px;
            padding: 35px 40px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            border-radius: 5px;
            background:
                radial-gradient(
                    circle at 15% 20%,
                    rgba(196, 126, 255, 0.25),
                    transparent 35%
                ),
                linear-gradient(135deg, #7138c8, #54259c);
            color: white;
            box-shadow: 0 15px 35px rgba(80, 36, 145, 0.18);
        }

        .mission-item {
            display: flex;
            align-items: center;
            gap: 18px;
            cursor: pointer;
            transition: transform 0.25s ease;
        }

        .mission-item:hover {
            transform: translateY(-3px);
        }

        .mission-icon {
            width: 58px;
            height: 58px;
            min-width: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff88;
            border-radius: 8px;
            background: #ffffff12;
            color: white;
            transition: 0.3s ease;
        }

        .mission-item:hover .mission-icon {
            transform: rotate(-5deg) scale(1.05);
            background: #ffffff20;
        }

        .mission-icon svg {
            width: 25px;
            height: 25px;
            fill: currentColor;
        }

        .mission-item h3 {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .mission-item p {
            color: var(--mission-text);
            font-size: 12px;
            line-height: 1.7;
        }

        body.dark-mode .about-card,
        body.dark-mode .team-card {
            background:
                linear-gradient(
                    145deg,
                    rgba(25, 20, 39, 0.98),
                    rgba(14, 12, 25, 0.98)
                );
            box-shadow:
                0 15px 40px rgba(0, 0, 0, 0.25),
                0 0 25px rgba(113, 56, 200, 0.05);
        }

        body.dark-mode .about-card.highlight {
            background:
                linear-gradient(
                    145deg,
                    rgba(38, 25, 58, 0.98),
                    rgba(24, 17, 39, 0.98)
                );
        }

        footer {
            position: relative;
            overflow: hidden;
            padding: 42px 36px 16px;
            background:
                radial-gradient(
                    circle at 12% 20%,
                    rgba(125, 65, 210, 0.8),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 82% 18%,
                    rgba(45, 95, 210, 0.7),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 50% 85%,
                    rgba(255, 255, 255, 0.16),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    #5b279e 0%,
                    #252a82 38%,
                    #080817 72%,
                    #000000 100%
                );
            color: white;
        }

        body.dark-mode footer {
            background:
                radial-gradient(
                    circle at 12% 20%,
                    rgba(135, 67, 230, 0.48),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 82% 18%,
                    rgba(48, 80, 210, 0.4),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 50% 85%,
                    rgba(165, 95, 255, 0.12),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    #251047 0%,
                    #121442 38%,
                    #070711 72%,
                    #020207 100%
                );
        }

        footer::before,
        footer::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(90px);
        }

        footer::before {
            width: 500px;
            height: 500px;
            top: -280px;
            right: -120px;
            background: rgba(255, 255, 255, 0.1);
        }

        footer::after {
            width: 450px;
            height: 450px;
            bottom: -300px;
            left: 15%;
            background: rgba(76, 86, 220, 0.3);
        }

        .footer-content,
        .footer-bottom {
            position: relative;
            z-index: 2;
        }

        .footer-content {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.45fr 0.8fr 1fr 1.05fr;
            gap: 55px;
            padding-bottom: 30px;
            border-bottom: 1px solid #ffffff25;
        }

        .footer-logo {
            margin-bottom: 7px;
        }

        .footer-logo img {
            width: 78px;
            height: 78px;
            object-fit: contain;
        }

        .footer-description {
            max-width: 270px;
            color: #d3d0df;
            font-size: 11px;
            line-height: 1.7;
            margin-bottom: 14px;
        }

        .footer h4 {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .social-icons {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .social-icon {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff30;
            border-radius: 5px;
            background: #ffffff10;
            color: #d0ccdc;
            transition: 0.2s ease;
        }

        .social-icon:hover {
            color: white;
            background: #7138c8;
            border-color: #a86be8;
            transform: translateY(-2px);
        }

        .social-icon:active {
            transform: scale(0.9);
        }

        .social-icon svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 8px;
        }

        .footer-links a {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #d0ccdc;
            font-size: 11px;
            transition: 0.2s;
        }

        .footer-links a:hover {
            color: white;
            transform: translateX(2px);
        }

        .footer-links svg {
            width: 13px;
            height: 13px;
            fill: currentColor;
            flex-shrink: 0;
        }

        .contact {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-bottom: 12px;
            color: #d0ccdc;
            font-size: 11px;
        }

        .contact-icon {
            width: 14px;
            height: 14px;
