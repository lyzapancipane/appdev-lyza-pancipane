<!DOCTYPE html>
<html>
<head>
	<title>EduBridge | Student Portal</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<style>
		*
		{
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		:root
		{
			--background: #f3f3f3;
			--surface: #ffffff;
			--surface-soft: #faf9fc;
			--text: #17152d;
			--text-soft: #696774;
			--text-muted: #77737e;
			--border: #e1e1e1;
			--purple: #7138c8;
			--purple-light: #eee5ff;
			--purple-soft: #eadcff;
			--shadow: rgba(40, 24, 75, 0.08);
		}

		body.dark-mode
		{
			--background: #090817;
			--surface: #131124;
			--surface-soft: #18162b;
			--text: #f7f3ff;
			--text-soft: #c4bfd2;
			--text-muted: #9e99ae;
			--border: #2d2941;
			--purple: #a970ff;
			--purple-light: #251b3b;
			--purple-soft: #241934;
			--shadow: rgba(0, 0, 0, 0.35);
		}

		html
		{
			scroll-behavior: smooth;
			scroll-padding-top: 78px;
		}

		body
		{
			overflow-x: hidden;
			background: var(--background);
			color: var(--text);
			font-family: Poppins, Arial, sans-serif;
			transition: background 0.45s ease, color 0.45s ease;
		}

		body.dark-mode
		{
			background:
				radial-gradient(circle at 12% 10%, rgba(113, 56, 200, 0.12), transparent 28%),
				radial-gradient(circle at 88% 45%, rgba(68, 72, 190, 0.08), transparent 30%),
				#090817;
		}

		a
		{
			color: inherit;
			text-decoration: none;
		}

		button
		{
			font: inherit;
			cursor: pointer;
		}

		.cursor-gradient
		{
			position: fixed;
			z-index: 9998;
			top: 0;
			left: 0;
			width: 500px;
			height: 500px;
			border-radius: 50%;
			transform: translate(-50%, -50%);
			pointer-events: none;
			opacity: 0;
			background: radial-gradient(circle, rgba(185, 120, 255, 0.16) 0%, rgba(86, 105, 255, 0.10) 28%, rgba(225, 80, 160, 0.06) 48%, transparent 72%);
			filter: blur(32px);
			transition: opacity 0.35s ease;
		}

		body.cursor-ready .cursor-gradient
		{
			opacity: 1;
		}

		body.dark-mode .cursor-gradient
		{
			background: radial-gradient(circle, rgba(174, 112, 255, 0.23) 0%, rgba(88, 103, 255, 0.14) 30%, rgba(228, 78, 173, 0.08) 50%, transparent 73%);
		}

		body.theme-changing::before
		{
			position: fixed;
			z-index: 9999;
			top: var(--theme-y);
			left: var(--theme-x);
			width: 30px;
			height: 30px;
			border-radius: 50%;
			background: var(--theme-circle);
			content: "";
			pointer-events: none;
			transform: translate(-50%, -50%) scale(0);
			animation: themeReveal 0.65s ease-out forwards;
		}

		@keyframes themeReveal
		{
			0%
			{
				opacity: 0.35;
				transform: translate(-50%, -50%) scale(0);
			}

			100%
			{
				opacity: 0;
				transform: translate(-50%, -50%) scale(100);
			}
		}

		.navbar
		{
			position: fixed;
			z-index: 1000;
			top: 0;
			left: 0;
			display: flex;
			width: 100%;
			height: 88px;
			align-items: center;
			justify-content: space-between;
			padding: 0 36px;
			color: white;
			transition: height 0.35s ease, background 0.35s ease, box-shadow 0.35s ease, backdrop-filter 0.35s ease;
		}

		.navbar.scrolled
		{
			height: 72px;
			background: rgba(8, 5, 29, 0.82);
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
			backdrop-filter: blur(14px);
		}

		.logo
		{
			display: flex;
			align-items: center;
			gap: 2px;
			font-size: 18px;
			font-weight: 600;
			white-space: nowrap;
		}

		.logo img
		{
			width: 90px;
			height: 90px;
			flex-shrink: 0;
			object-fit: contain;
			transition: transform 0.3s ease;
		}

		.logo:hover img
		{
			transform: rotate(-4deg) scale(1.04);
		}

		.brand-bridge
		{
			color: #7339c2;
		}

		.brand-name
		{
			display: flex;
			align-items: center;
			margin-left: -3px;
			letter-spacing: -0.4px;
		}

		.brand-edu
		{
			color: white;
		}

		.nav-links
		{
			display: flex;
			align-items: center;
			gap: 28px;
			font-size: 13px;
		}

		.nav-links a
		{
			position: relative;
			color: #ffffffdd;
			transition: color 0.2s ease;
		}

		.nav-links a::after
		{
			position: absolute;
			right: 50%;
			bottom: -7px;
			left: 50%;
			height: 2px;
			border-radius: 10px;
			background: #b77aff;
			content: "";
			transition: left 0.25s ease, right 0.25s ease;
		}

		.nav-links a:hover,
		.nav-links a:focus-visible,
		.nav-links .active
		{
			color: #c58cff;
		}

		.nav-links a:hover::after,
		.nav-links a:focus-visible::after,
		.nav-links .active::after
		{
			right: 0;
			left: 0;
		}

		.nav-actions
		{
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.theme-button,
		.menu-button
		{
			display: inline-flex;
			width: 34px;
			height: 34px;
			align-items: center;
			justify-content: center;
			border: 1px solid #ffffff55;
			border-radius: 5px;
			background: #ffffff12;
			color: white;
			transition: 0.25s ease;
		}

		.theme-button:hover,
		.menu-button:hover
		{
			transform: translateY(-2px);
			border-color: #ffffff88;
			background: #ffffff20;
		}

		.theme-button svg,
		.menu-button svg
		{
			width: 15px;
			height: 15px;
			fill: currentColor;
		}

		.login-link
		{
			display: inline-flex;
			height: 34px;
			align-items: center;
			padding: 0 15px;
			border: 1px solid #ffffff55;
			border-radius: 5px;
			background: #ffffff12;
			color: white;
			font-size: 12px;
			transition: 0.25s ease;
		}

		.login-link:hover
		{
			transform: translateY(-2px);
			border-color: #a970ff;
			background: var(--purple);
		}

		.menu-button
		{
			display: none;
		}

		.hero
		{
			position: relative;
			display: flex;
			min-height: 470px;
			align-items: center;
			overflow: hidden;
			isolation: isolate;
			padding: 130px 36px 70px;
			background: #08051d;
		}

		.hero-image,
		.hero-base,
		.gradient-layer,
		.hero-overlay
		{
			position: absolute;
			inset: 0;
			pointer-events: none;
		}

		.hero-image
		{
			z-index: -10;
			background-image: url("Edubridge-Hero-About.png");
			background-position: center 45%;
			background-size: cover;
			opacity: 0.62;
			transform: scale(1.04);
			transition: transform 0.8s ease, opacity 0.8s ease;
		}

		.hero-base
		{
			z-index: -9;
			background: linear-gradient(135deg, rgba(5, 5, 35, 0.76), rgba(14, 4, 40, 0.34), rgba(5, 5, 30, 0.68));
		}

		.gradient-layer
		{
			z-index: -8;
			overflow: hidden;
		}

		.gradient
		{
			position: absolute;
			border-radius: 50%;
			mix-blend-mode: screen;
			opacity: 0.72;
			filter: blur(65px);
			transform: translate(-50%, -50%);
		}

		.gradient-purple
		{
			top: var(--purple-y, 5%);
			left: var(--purple-x, 4%);
			width: 430px;
			height: 430px;
			background: #7138c8;
			animation: purpleFloat 12s ease-in-out infinite alternate;
		}

		.gradient-blue
		{
			top: var(--blue-y, 8%);
			left: var(--blue-x, 93%);
			width: 390px;
			height: 390px;
			background: #315ee8;
			animation: blueFloat 14s ease-in-out infinite alternate;
		}

		.gradient-pink
		{
			top: var(--pink-y, 57%);
			left: var(--pink-x, 15%);
			width: 360px;
			height: 360px;
			background: #d94f91;
			animation: pinkFloat 13s ease-in-out infinite alternate;
		}

		.gradient-violet
		{
			top: var(--violet-y, 38%);
			left: var(--violet-x, 55%);
			width: 430px;
			height: 430px;
			background: #933cff;
			animation: violetFloat 15s ease-in-out infinite alternate;
		}

		.gradient-orange
		{
			top: var(--orange-y, 88%);
			left: var(--orange-x, 94%);
			width: 400px;
			height: 400px;
			background: #e69a42;
			animation: orangeFloat 11s ease-in-out infinite alternate;
		}

		.gradient-cyan
		{
			top: var(--cyan-y, 93%);
			left: var(--cyan-x, 5%);
			width: 340px;
			height: 340px;
			background: #387ee8;
			animation: cyanFloat 16s ease-in-out infinite alternate;
		}

		.gradient-pink-small
		{
			top: var(--pink-small-y, 67%);
			left: var(--pink-small-x, 78%);
			width: 270px;
			height: 270px;
			background: #b73fbd;
			animation: smallPinkFloat 12s ease-in-out infinite alternate;
		}

		.hero-overlay
		{
			z-index: -6;
			background: linear-gradient(90deg, rgba(5, 5, 35, 0.5), rgba(10, 5, 35, 0.08), rgba(5, 5, 35, 0.42));
		}

		.hero-content
		{
			position: relative;
			z-index: 2;
			display: grid;
			width: 100%;
			max-width: 1180px;
			grid-template-columns: minmax(0, 1fr) 330px;
			align-items: center;
			gap: 45px;
			margin: 0 auto;
		}

		.hero-copy
		{
			max-width: 620px;
		}

		.hero-label
		{
			margin-bottom: 12px;
			color: #c18cff;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 1px;
		}

		.hero h1
		{
			margin-bottom: 18px;
			color: white;
			font-size: 52px;
			font-weight: 600;
			line-height: 1.1;
		}

		.hero h1 span
		{
			color: #b77aff;
		}

		.hero-copy > p
		{
			max-width: 650px;
			color: #d5d1df;
			font-size: 15px;
			line-height: 1.8;
		}

		.hero-actions
		{
			display: flex;
			flex-wrap: wrap;
			gap: 9px;
			margin-top: 15px;
		}

		.button-primary,
		.button-secondary
		{
			display: inline-flex;
			min-height: 35px;
			align-items: center;
			justify-content: center;
			gap: 7px;
			padding: 0 13px;
			border: 1px solid transparent;
			border-radius: 5px;
			font-size: 11px;
			font-weight: 600;
			transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.button-primary
		{
			background: var(--purple);
			color: white;
		}

		.button-primary:hover
		{
			transform: translateY(-2px);
			background: #8c50df;
			box-shadow: 0 8px 18px rgba(113, 56, 200, 0.22);
		}

		.button-primary:active,
		.button-secondary:active
		{
			transform: scale(0.97);
		}

		.button-secondary
		{
			border-color: #ffffff55;
			background: #ffffff10;
			color: white;
		}

		.button-secondary:hover
		{
			transform: translateY(-2px);
			border-color: #c18cff;
			background: #ffffff1c;
		}

		.hero-notice
		{
			display: grid;
			grid-template-columns: 42px minmax(0, 1fr) 18px;
			align-items: center;
			gap: 10px;
			padding: 11px;
			border: 1px solid #ffffff35;
			border-radius: 5px;
			background: var(--surface);
			color: var(--text);
			box-shadow: 0 16px 40px rgba(2, 2, 22, 0.2);
			backdrop-filter: blur(12px);
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		.hero-notice:hover
		{
			transform: translateY(-4px);
			box-shadow: 0 20px 45px rgba(2, 2, 22, 0.28);
		}

		.notice-icon
		{
			display: flex;
			width: 42px;
			height: 42px;
			align-items: center;
			justify-content: center;
			border-radius: 5px;
			background: var(--purple);
			color: white;
		}

		.notice-icon svg
		{
			width: 20px;
			height: 20px;
			fill: currentColor;
		}

		.notice-copy small
		{
			display: block;
			margin-bottom: 4px;
			color: var(--purple);
			font-size: 9px;
			font-weight: 600;
		}

		.notice-copy strong
		{
			display: block;
			margin-bottom: 3px;
			font-size: 12px;
		}

		.notice-copy p
		{
			color: var(--text-soft);
			font-size: 10px;
			line-height: 1.5;
		}

		.notice-arrow
		{
			color: var(--purple);
			font-size: 18px;
			text-align: center;
		}

		.container
		{
			width: 100%;
			max-width: 1180px;
			margin: 0 auto;
		}

		.section-heading
		{
			margin-bottom: 15px;
			text-align: center;
		}

		.section-heading h2
		{
			margin-bottom: 4px;
			color: var(--text);
			font-size: 32px;
			font-weight: 600;
		}

		.section-heading p
		{
			color: var(--text-muted);
			font-size: 13px;
			line-height: 1.6;
		}

		.quick-section
		{
			padding: 45px 0 55px;
		}

		.quick-grid
		{
			display: grid;
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 18px;
		}

		.quick-card
		{
			min-height: 185px;
			padding: 22px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			box-shadow: 0 5px 20px var(--shadow);
			transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.quick-card:hover,
		.quick-card:focus-visible
		{
			transform: translateY(-4px);
			border-color: #b77aff;
			box-shadow: 0 12px 24px var(--shadow), 0 0 18px rgba(113, 56, 200, 0.08);
		}

		.quick-icon
		{
			display: flex;
			width: 45px;
			height: 45px;
			align-items: center;
			justify-content: center;
			margin-bottom: 15px;
			border-radius: 50%;
			background: var(--purple-light);
			color: var(--purple);
			transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
		}

		.quick-card:hover .quick-icon
		{
			transform: rotate(-5deg) scale(1.08);
			background: var(--purple);
			color: white;
		}

		.quick-icon svg
		{
			width: 20px;
			height: 20px;
			fill: currentColor;
		}

		.quick-card strong
		{
			display: block;
			margin-bottom: 9px;
			color: var(--text);
			font-size: 16px;
			font-weight: 600;
		}

		.quick-card p
		{
			color: var(--text-muted);
			font-size: 13px;
			line-height: 1.7;
		}

		.announcements-section
		{
			padding: 45px 0 55px;
		}

		.heading-row
		{
			position: relative;
			display: flex;
			align-items: end;
			justify-content: center;
		}

		.heading-row .section-heading
		{
			margin-bottom: 15px;
		}

		.text-link
		{
			display: inline-flex;
			min-height: 30px;
			align-items: center;
			gap: 4px;
			border: 0;
			background: transparent;
			color: var(--purple);
			font-size: 11px;
			font-weight: 600;
			transition: transform 0.2s ease, color 0.2s ease;
		}

		.text-link:hover
		{
			transform: translateX(2px);
			color: var(--purple);
		}

		.heading-actions
		{
			position: absolute;
			right: 0;
			bottom: 15px;
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.announcement-list
		{
			display: grid;
			gap: 12px;
		}

		.announcement-card
		{
			display: grid;
			min-height: 150px;
			grid-template-columns: 66px minmax(0, 1fr) auto;
			align-items: center;
			gap: 18px;
			padding: 18px 22px;
			border: 1px solid var(--border);
			border-radius: 5px;
			background: var(--surface);
			box-shadow: 0 5px 20px var(--shadow);
			transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.announcement-card:hover
		{
			transform: translateY(-2px);
			border-color: #c6a6f2;
			box-shadow: 0 9px 20px var(--shadow);
		}

		.announcement-card.extra-announcement
		{
			display: none;
		}

		.announcement-icon
		{
			display: flex;
			width: 66px;
			height: 66px;
			align-items: center;
			justify-content: center;
			border-radius: 4px;
			background: var(--purple-light);
			color: var(--purple);
		}

		.announcement-card:nth-child(2) .announcement-icon
		{
			background: var(--surface-soft);
			color: #3470dc;
		}

		body.dark-mode .announcement-card:nth-child(2) .announcement-icon
		{
			color: #8db4ff;
		}

		.announcement-card:nth-child(3) .announcement-icon
		{
			background: var(--purple-light);
			color: var(--purple);
		}

		.announcement-icon svg
		{
			width: 30px;
			height: 30px;
			fill: currentColor;
		}

		.announcement-copy
		{
			min-width: 0;
		}

		.announcement-meta
		{
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 6px;
			margin-bottom: 3px;
		}

		.category
		{
			color: var(--text-muted);
			font-size: 10px;
			font-weight: 600;
		}

		.new-label
		{
			padding: 2px 5px;
			border-radius: 3px;
			background: var(--purple-light);
			color: var(--purple);
			font-size: 9px;
			font-weight: 700;
		}

		.announcement-copy h3
		{
			overflow: hidden;
			margin-bottom: 3px;
			color: var(--text);
			font-size: 16px;
			font-weight: 600;
			text-overflow: ellipsis;
		}

		.announcement-copy h3 a
		{
			transition: color 0.2s ease;
		}

		.announcement-copy h3 a:hover
		{
			color: var(--purple);
		}

		.announcement-copy p
		{
			color: var(--text-soft);
			font-size: 12px;
			line-height: 1.7;
		}

		.announcement-date
		{
			align-self: start;
			padding-top: 4px;
			color: var(--text-muted);
			font-size: 10px;
			white-space: nowrap;
		}

		.faq-section
		{
			padding: 45px 0 55px;
		}

		.faq-list
		{
			display: grid;
			gap: 7px;
		}

		.faq-item
		{
			border: 1px solid var(--border);
			border-radius: 4px;
			background: var(--surface);
			box-shadow: 0 2px 10px var(--shadow);
			transition: border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.faq-item[open]
		{
			border-color: var(--purple);
			box-shadow: 0 7px 18px var(--shadow);
		}

		.faq-item summary
		{
			display: flex;
			min-height: 52px;
			align-items: center;
			justify-content: space-between;
			gap: 15px;
			padding: 12px 18px;
			color: var(--purple);
			cursor: pointer;
			font-size: 13px;
			font-weight: 600;
			list-style: none;
		}

		.faq-item summary::-webkit-details-marker
		{
