<script>


    /* =====================================================
       PROFILE DROPDOWN
    ====================================================== */

    function toggleProfileDropdown() {

        const dropdown =
            document.getElementById(
                "profileDropdown"
            );

        dropdown.classList.toggle("show");
    }


    /* =====================================================
       CLOSE DROPDOWN WHEN CLICKING OUTSIDE
    ====================================================== */

    document.addEventListener(
        "click",
        function(event) {

            const profileWrapper =
                document.querySelector(
                    ".profile-wrapper"
                );

            const dropdown =
                document.getElementById(
                    "profileDropdown"
                );

            if (
                profileWrapper &&
                !profileWrapper.contains(
                    event.target
                )
            ) {

                dropdown.classList.remove("show");
            }

        }
    );


    /* =====================================================
       MODAL
    ====================================================== */

    function openModal(id) {

        document
            .getElementById(id)
            .classList.add("show");
    }


    function closeModal(id) {

        document
            .getElementById(id)
            .classList.remove("show");
    }


    function closeModalOutside(
        event,
        id
    ) {

        if (event.target.id === id) {
            closeModal(id);
        }
    }


    /* =====================================================
       PROFILE
    ====================================================== */

    function openProfile() {

        document
            .getElementById("profileDropdown")
            .classList.remove("show");

        openModal("profileModal");
    }


    /* =====================================================
       SETTINGS
    ====================================================== */

    function openSettings() {

        document
            .getElementById("profileDropdown")
            .classList.remove("show");

        openModal("settingsModal");
    }


    function toggleSetting(button) {

        button.classList.toggle("active");
    }


    function saveSettings() {

        closeModal("settingsModal");

        showComingSoon(
            "Your account settings will be connected to the database next."
        );
    }


    /* =====================================================
       GENERAL MESSAGE
    ====================================================== */

    function showComingSoon(message) {

        document.getElementById(
            "messageModalText"
        ).textContent = message;

        openModal("messageModal");
    }


    /* =====================================================
       SCHOOL REQUEST DETAILS
    ====================================================== */

    function viewRequest(request) {

        document.getElementById(
            "detailSchoolName"
        ).textContent =
            request.school_name || "—";


        document.getElementById(
            "detailSchoolCode"
        ).textContent =
            request.school_code || "—";


        document.getElementById(
            "detailSchoolEmail"
        ).textContent =
            request.school_email || "—";


        document.getElementById(
            "detailContact"
        ).textContent =
            request.contact_number || "—";


        document.getElementById(
            "detailAddress"
        ).textContent =
            request.address || "—";


        document.getElementById(
            "detailAdminName"
        ).textContent =
            request.admin_name || "—";


        document.getElementById(
            "detailAdminEmail"
        ).textContent =
            request.admin_email || "—";


        document.getElementById(
            "detailAdminStatus"
        ).textContent =
            request.admin_status
                ?
                request.admin_status.charAt(0).toUpperCase()
                +
                request.admin_status.slice(1)
                :
                "—";


        document.getElementById(
            "detailRemarks"
        ).textContent =
            request.remarks || "—";


        document.getElementById(
            "detailStatus"
        ).textContent =
            request.status
                ?
                request.status.charAt(0).toUpperCase()
                +
                request.status.slice(1)
                :
                "—";


        if (request.requested_at) {

            const date =
                new Date(
                    request.requested_at.replace(
                        " ",
                        "T"
                    )
                );


            if (!isNaN(date.getTime())) {

                document.getElementById(
                    "detailDate"
                ).textContent =
                    date.toLocaleDateString(
                        "en-US",
                        {
                            month: "short",
                            day: "numeric",
                            year: "numeric"
                        }
                    );

            } else {

                document.getElementById(
                    "detailDate"
                ).textContent =
                    request.requested_at;
            }

        } else {

            document.getElementById(
                "detailDate"
            ).textContent = "—";
        }


        if (request.reviewed_at) {

            const reviewedDate =
                new Date(
                    request.reviewed_at.replace(
                        " ",
                        "T"
                    )
                );


            if (!isNaN(reviewedDate.getTime())) {

                document.getElementById(
                    "detailReviewedDate"
                ).textContent =
                    reviewedDate.toLocaleDateString(
                        "en-US",
                        {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                            hour: "numeric",
                            minute: "2-digit"
                        }
                    );

            } else {

                document.getElementById(
                    "detailReviewedDate"
                ).textContent =
                    request.reviewed_at;
            }

        } else {

            document.getElementById(
                "detailReviewedDate"
            ).textContent = "—";
        }


        openModal("requestModal");
    }


    /* =====================================================
       SEARCH SCHOOLS
    ====================================================== */

    function searchSchools() {

        const input =
            document
                .getElementById("schoolSearch")
                .value
                .toLowerCase();


        const table =
            document.getElementById(
                "requestsTable"
            );


        if (!table) {
            return;
        }


        const tbody =
            table.getElementsByTagName(
                "tbody"
            )[0];


        const rows =
            tbody.getElementsByTagName(
                "tr"
            );


        for (
            let i = 0;
            i < rows.length;
            i++
        ) {

            const text =
                rows[i]
                    .textContent
                    .toLowerCase();


            rows[i].style.display =
                text.includes(input)
                    ?
                    ""
                    :
                    "none";
        }
    }


    /* =====================================================
       ESC KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Escape") {

                document
                    .querySelectorAll(
                        ".modal-overlay"
                    )
                    .forEach(
                        function(modal) {

                            modal.classList.remove(
                                "show"
                            );

                        }
                    );


                document
                    .getElementById(
                        "profileDropdown"
                    )
                    .classList.remove(
                        "show"
                    );
            }

        }
    );

</script>


