/* =========================================================
   SCHOOL VERIFICATION REQUESTS
========================================================= */

$requests = [];

$requestQuery = "
    SELECT
        svr.request_id,
        svr.school_id,
        svr.system_admin_id,
        svr.status,
        svr.remarks,
        svr.requested_at,
        svr.reviewed_at,

        s.school_name,
        s.school_code,
        s.school_email,
        s.contact_number,
        s.address,

        (
            SELECT CONCAT(u.first_name, ' ', u.last_name)
            FROM users u
            WHERE u.school_id = s.school_id
              AND u.role = 'school_admin'
            ORDER BY
                CASE
                    WHEN u.status = 'active' THEN 1
                    ELSE 2
                END,
                u.user_id ASC
            LIMIT 1
        ) AS admin_name,

        (
            SELECT u.email
            FROM users u
            WHERE u.school_id = s.school_id
              AND u.role = 'school_admin'
            ORDER BY
                CASE
                    WHEN u.status = 'active' THEN 1
                    ELSE 2
                END,
                u.user_id ASC
            LIMIT 1
        ) AS admin_email,

        (
            SELECT u.status
            FROM users u
            WHERE u.school_id = s.school_id
              AND u.role = 'school_admin'
            ORDER BY
                CASE
                    WHEN u.status = 'active' THEN 1
                    ELSE 2
                END,
                u.user_id ASC
            LIMIT 1
        ) AS admin_status

    FROM school_verification_requests svr

    INNER JOIN schools s
        ON svr.school_id = s.school_id

    ORDER BY
        CASE
            WHEN svr.status = 'pending' THEN 1
            WHEN svr.status = 'approved' THEN 2
            WHEN svr.status = 'rejected' THEN 3
            ELSE 4
        END,

        svr.requested_at DESC

    LIMIT 6
";

$requestResult = $conn->query($requestQuery);

if ($requestResult) {

    while ($row = $requestResult->fetch_assoc()) {
        $requests[] = $row;
    }
}


/* =========================================================
   RECENT ACTIVITY
========================================================= */

$activities = [];

$activityQuery = "
    SELECT
        svr.request_id,
        svr.status,
        svr.requested_at,
        svr.reviewed_at,
        s.school_name

    FROM school_verification_requests svr

    INNER JOIN schools s
        ON svr.school_id = s.school_id

    ORDER BY
        COALESCE(
            svr.reviewed_at,
            svr.requested_at
        ) DESC

    LIMIT 4
";

$activityResult = $conn->query($activityQuery);

if ($activityResult) {

    while ($row = $activityResult->fetch_assoc()) {
        $activities[] = $row;
    }
}


/* =========================================================
   PROFILE INITIALS
========================================================= */

$nameParts = preg_split(
    '/\s+/',
    trim($adminName)
);

$initials = "";

if (!empty($nameParts[0])) {

    $initials .= strtoupper(
        substr(
            $nameParts[0],
            0,
            1
        )
    );
}

if (count($nameParts) > 1) {

    $initials .= strtoupper(
        substr(
            $nameParts[count($nameParts) - 1],
            0,
            1
        )
    );
}

if ($initials === "") {
    $initials = "SA";
}


/* =========================================================
   STATUS HELPERS
========================================================= */

function statusClass($status)
{
    switch ($status) {

        case "approved":
            return "status-approved";

        case "rejected":
            return "status-rejected";

        case "pending":
        default:
            return "status-pending";
    }
}


function statusText($status)
{
    switch ($status) {

        case "approved":
            return "Approved";

        case "rejected":
            return "Rejected";

        case "pending":
        default:
            return "Pending";
    }
}

