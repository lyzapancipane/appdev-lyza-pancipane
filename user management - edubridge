<!DOCTYPE html>
<head>
    <title>User Management | EduBridge</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        *
        {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root
        {
            --background: #f3f3f3;
            --surface: #ffffff;
            --surface-soft: #faf9fc;
            --text: #17152d;
            --text-soft: #696774;
            --text-muted: #77737e;
            --border: #e1e1e1;
            --purple: #7138c8;
            --purple-light: #eee5ff;
            --purple-soft: #eadcff;
            --green: #1f9d63;
            --green-soft: #e7f6ee;
            --red: #d64550;
            --red-soft: #fdeced;
            --shadow: rgba(40, 24, 75, 0.08);
        }

        body.dark-mode
        {
            --background: #090817;
            --surface: #131124;
            --surface-soft: #18162b;
            --text: #f7f3ff;
            --text-soft: #c4bfd2;
            --text-muted: #9e99ae;
            --border: #2d2941;
            --purple: #a970ff;
            --purple-light: #251b3b;
            --purple-soft: #241934;
            --green: #4cd08d;
            --green-soft: #16301f;
            --red: #ff7b85;
            --red-soft: #331a1e;
            --shadow: rgba(0, 0, 0, 0.35);
        }

        html
        {
            scroll-behavior: smooth;
        }

        body
        {
            font-family: Poppins, Arial, sans-serif;
            color: var(--text);
            background: var(--background);
            overflow-x: hidden;
            transition: background 0.45s ease, color 0.45s ease;
        }

        body.dark-mode
        {
            background:
                radial-gradient(
                    circle at 12% 10%,
                    rgba(113, 56, 200, 0.12),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 88% 45%,
                    rgba(68, 72, 190, 0.08),
                    transparent 30%
                ),
                #090817;
        }

        a
        {
            color: inherit;
            text-decoration: none;
        }

        button
        {
            font-family: inherit;
            cursor: pointer;
        }

        body [hidden]
        {
            display: none;
        }

        body.theme-changing::before
        {
            content: "";
            position: fixed;
            width: 30px;
            height: 30px;
            left: var(--theme-x);
            top: var(--theme-y);
            transform: translate(-50%, -50%) scale(0);
            border-radius: 50%;
            background: var(--theme-circle);
            z-index: 9999;
            pointer-events: none;
            animation: themeReveal 0.65s ease-out forwards;
        }

        @keyframes themeReveal
        {
            0%
            {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0.35;
            }

            100%
            {
                transform: translate(-50%, -50%) scale(100);
                opacity: 0;
            }
        }

        .cursor-gradient
        {
            position: fixed;
            width: 500px;
            height: 500px;
            left: 0;
            top: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9998;
            opacity: 0;
            background:
                radial-gradient(
                    circle,
                    rgba(185, 120, 255, 0.16) 0%,
                    rgba(86, 105, 255, 0.10) 28%,
                    rgba(225, 80, 160, 0.06) 48%,
                    transparent 72%
                );
            filter: blur(32px);
            transition: opacity 0.35s ease;
        }

        body.cursor-ready .cursor-gradient
        {
            opacity: 1;
        }

        body.dark-mode .cursor-gradient
        {
            background:
                radial-gradient(
                    circle,
                    rgba(174, 112, 255, 0.23) 0%,
                    rgba(88, 103, 255, 0.14) 30%,
                    rgba(228, 78, 173, 0.08) 50%,
                    transparent 73%
                );
        }

        .navbar
        {
            height: 88px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 20;
            color: white;
            transition:
                height 0.3s ease,
                background 0.3s ease,
                box-shadow 0.3s ease,
                backdrop-filter 0.3s ease;
        }

        .navbar.scrolled
        {
            height: 72px;
            background: rgba(8, 5, 29, 0.82);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
            backdrop-filter: blur(14px);
        }

        .logo
        {
            display: flex;
            align-items: center;
            gap: 2px;
            font-size: 18px;
            font-weight: 600;
            white-space: nowrap;
        }

        .logo img
        {
            width: 90px;
            height: 90px;
            object-fit: contain;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .logo:hover img
        {
            transform: rotate(-4deg) scale(1.04);
        }

        .brand-name
        {
            display: flex;
            align-items: center;
            margin-left: -3px;
            letter-spacing: -0.4px;
        }

        .brand-edu
        {
            color: white;
        }

        .brand-bridge
        {
            color: #7339c2;
        }

        .nav-links
        {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 13px;
        }

        .nav-links a
        {
            position: relative;
            color: #ffffffdd;
            transition: 0.2s;
        }

        .nav-links a::after
        {
            position: absolute;
            right: 50%;
            bottom: -7px;
            left: 50%;
            height: 2px;
            border-radius: 10px;
            background: #b77aff;
            content: "";
            transition: left 0.25s ease, right 0.25s ease;
        }

        .nav-links a:hover,
        .nav-links .active
        {
            color: #c58cff;
        }

        .nav-links a:hover::after,
        .nav-links a:focus-visible::after,
        .nav-links .active::after
        {
            right: 0;
            left: 0;
        }

        .account-menu
        {
            position: absolute;
            top: calc(100% - 1px);
            right: 36px;
            width: 264px;
            display: none;
            flex-direction: column;
            gap: 2px;
            padding: 8px;
            border: 1px solid #ffffff25;
            border-radius: 6px;
            background: rgba(8, 5, 29, 0.97);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
            z-index: 1001;
        }

        .navbar.menu-open .account-menu
        {
            display: flex;
        }

        .account-menu-label
        {
            padding: 6px 10px;
            color: #ffffff80;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .account-menu-item
        {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 10px;
            border: 0;
            border-radius: 4px;
            background: none;
            color: #ffffffdd;
            font-family: inherit;
            font-size: 13px;
            text-align: left;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }

        .account-menu-item:hover,
        .account-menu-item:focus-visible
        {
            background: #ffffff10;
            color: #c58cff;
        }

        .account-menu-item[aria-disabled="true"]
        {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .account-menu-item[aria-disabled="true"]:hover
        {
            background: none;
            color: #ffffffdd;
        }

        .account-menu-divider
        {
            height: 1px;
            margin: 4px 0;
            background: #ffffff25;
        }

        .submenu-parent
        {
            justify-content: space-between;
        }

        .submenu-caret
        {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            transition: transform 0.2s ease;
        }

        .submenu-caret svg
        {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .submenu-parent[aria-expanded="true"] .submenu-caret
        {
            transform: rotate(180deg);
        }

        .account-submenu
        {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin: 2px 0;
            padding-left: 14px;
            border-left: 1px solid #ffffff2d;
        }

        .account-submenu[hidden]
        {
            display: none;
        }

        .account-submenu .account-menu-item
        {
            padding: 8px 10px;
            font-size: 12px;
        }

        .nav-buttons
        {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .theme-button
        {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff55;
            border-radius: 5px;
            background: #ffffff12;
            color: white;
            transition: 0.25s ease;
        }

        .menu-button
        {
            display: inline-flex;
            width: 34px;
            height: 34px;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff55;
            border-radius: 5px;
            background: #ffffff12;
            color: white;
            transition: 0.25s ease;
        }

        .theme-button:hover,
        .menu-button:hover
        {
            background: #ffffff20;
            border-color: #ffffff88;
            transform: translateY(-2px) rotate(8deg);
        }

        .theme-button:active,
        .menu-button:active
        {
            transform: scale(0.88);
        }

        .theme-button svg,
        .menu-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .nav-profile
        {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #ffffffdd;
            font-size: 12px;
            white-space: nowrap;
        }

        .nav-profile img
        {
            width: 34px;
            height: 34px;
            border: 1px solid #ffffff55;
            border-radius: 50%;
            object-fit: cover;
        }

        .nav-profile:hover img
        {
            border-color: #c58cff;
        }

        .nav-profile-text
        {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

        .nav-profile-text strong
        {
            color: white;
            font-size: 12px;
            font-weight: 600;
        }

        .nav-profile-text small
        {
            color: #ffffff99;
            font-size: 10px;
        }

        .nav-bell
        {
            display: flex;
            width: 34px;
            height: 34px;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff55;
            border-radius: 5px;
            background: #ffffff12;
            color: white;
            transition: 0.25s ease;
        }

        .nav-bell:hover,
        .nav-bell:focus-visible
        {
            background: #7138c8;
            border-color: #a970ff;
            transform: translateY(-2px);
        }

        .nav-bell:active
        {
            transform: scale(0.88);
        }

        .nav-bell svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .hero
        {
            min-height: 420px;
            padding: 130px 36px 70px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background: #08051d;
        }

        .hero-image
        {
            position: absolute;
            inset: 0;
            z-index: -10;
            background-image: url("Edubridge-Hero-About.png");
            background-size: cover;
            background-position: center;
            opacity: 0.62;
            transform: scale(1.04);
            transition: transform 0.25s ease-out;
        }

        .hero-base
        {
            position: absolute;
            inset: 0;
            z-index: -9;
            background:
                linear-gradient(
                    135deg,
                    rgba(5, 5, 35, 0.7),
                    rgba(14, 4, 40, 0.32),
                    rgba(5, 5, 30, 0.65)
                );
        }

        .gradient-layer
        {
            position: absolute;
            inset: 0;
            z-index: -8;
            overflow: hidden;
            pointer-events: none;
        }

        .gradient
        {
            position: absolute;
            border-radius: 50%;
            filter: blur(65px);
            mix-blend-mode: screen;
            opacity: 0.72;
        }

        .gradient-purple
        {
            width: 430px;
            height: 430px;
            background: #7138c8;
            left: var(--purple-x, 4%);
            top: var(--purple-y, 5%);
            animation: purpleFloat 12s ease-in-out infinite alternate;
        }

        .gradient-blue
        {
            width: 390px;
            height: 390px;
            background: #315ee8;
            left: var(--blue-x, 93%);
            top: var(--blue-y, 8%);
            animation: blueFloat 14s ease-in-out infinite alternate;
        }

        .gradient-pink
        {
            width: 360px;
            height: 360px;
            background: #d94f91;
            left: var(--pink-x, 15%);
            top: var(--pink-y, 57%);
            animation: pinkFloat 13s ease-in-out infinite alternate;
        }

        .gradient-violet
        {
            width: 430px;
            height: 430px;
            background: #933cff;
            left: var(--violet-x, 55%);
            top: var(--violet-y, 38%);
            animation: violetFloat 15s ease-in-out infinite alternate;
        }

        .gradient-orange
        {
            width: 400px;
            height: 400px;
            background: #e69a42;
            left: var(--orange-x, 94%);
            top: var(--orange-y, 88%);
            animation: orangeFloat 11s ease-in-out infinite alternate;
        }

        .gradient-cyan
        {
            width: 340px;
            height: 340px;
            background: #387ee8;
            left: var(--cyan-x, 5%);
            top: var(--cyan-y, 93%);
            animation: cyanFloat 16s ease-in-out infinite alternate;
        }

        .gradient-pink-small
        {
            width: 270px;
            height: 270px;
            background: #b73fbd;
            left: var(--pink-small-x, 78%);
            top: var(--pink-small-y, 67%);
            animation: smallPinkFloat 12s ease-in-out infinite alternate;
        }

        .hero-overlay
        {
            position: absolute;
            inset: 0;
            z-index: -6;
            pointer-events: none;
            background:
                linear-gradient(
                    90deg,
                    rgba(5, 5, 35, 0.58),
                    rgba(10, 5, 35, 0.12),
                    rgba(5, 5, 35, 0.52)
                );
        }

        .hero-content
        {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            position: relative;
            z-index: 5;
        }

        .hero-label
        {
            color: #c18cff;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .hero h1
        {
            color: white;
            font-size: 52px;
            line-height: 1.1;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .hero h1 span
        {
            color: #b77aff;
        }

        .hero p
        {
            max-width: 650px;
            color: #d5d1df;
            font-size: 15px;
            line-height: 1.8;
        }
        .admin-section
        {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 45px 0 55px;
        }

        .admin-card
        {
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface);
            box-shadow: 0 5px 20px var(--shadow);
            transition: 0.3s ease;
        }

        .toolbar-card
        {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: 12px;
            padding: 16px 18px;
            margin-bottom: 18px;
        }

        .toolbar-field
        {
            flex: 1 1 200px;
            min-width: 0;
        }

        .toolbar-field label
        {
            display: block;
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .search-shell
        {
            position: relative;
        }

        .search-shell svg
        {
            position: absolute;
            top: 50%;
            left: 12px;
            width: 15px;
            height: 15px;
            fill: var(--text-muted);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .toolbar-field input,
        .toolbar-field select
        {
            width: 100%;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface-soft);
            color: var(--text);
            font-family: inherit;
            font-size: 12px;
            outline: none;
            transition: 0.2s ease;
        }

        .toolbar-field input
        {
            padding: 0 12px 0 36px;
        }

        .toolbar-field input::placeholder
        {
            color: var(--text-muted);
        }

        .toolbar-field input:focus,
        .toolbar-field select:focus
        {
            border-color: var(--purple);
            box-shadow: 0 0 0 3px var(--purple-light);
        }

        .toolbar-select
        {
            position: relative;
        }

        .toolbar-select select
        {
            padding: 0 34px 0 12px;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
        }

        .toolbar-select .select-chevron
        {
            position: absolute;
            top: 50%;
            right: 12px;
            width: 13px;
            height: 13px;
            fill: var(--text-muted);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .create-button
        {
            flex: 0 0 auto;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 16px;
            margin-left: auto;
            border: none;
            border-radius: 5px;
            background: #7138c8;
            color: white;
            font-size: 11.5px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .create-button:hover
        {
            background: #5f2fb0;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(113, 56, 200, 0.22);
        }

        .create-button:active
        {
            transform: scale(0.97);
        }

        .create-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .list-card
        {
            padding: 20px 22px 22px;
        }

        .list-head
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .list-head h2
        {
            color: var(--text);
            font-size: 18px;
            font-weight: 600;
        }

        .demo-badge
        {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--purple);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .demo-badge svg
        {
            width: 11px;
            height: 11px;
            fill: currentColor;
        }

        .table-wrap
        {
            overflow-x: auto;
        }

        .user-table
        {
            width: 100%;
            min-width: 760px;
            border-collapse: collapse;
        }

        .user-table th
        {
            padding: 10px 12px;
            text-align: left;
            color: var(--text-muted);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .user-table td
        {
            padding: 12px;
            color: var(--text);
            font-size: 12px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .user-table tbody tr:last-child td
        {
            border-bottom: none;
        }

        .user-table tbody tr
        {
            transition: background 0.2s ease;
        }

        .user-table tbody tr:hover
        {
            background: var(--surface-soft);
        }

        .user-cell
        {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar
        {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--purple);
            font-size: 11px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .user-name
        {
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .email-cell
        {
            white-space: nowrap;
        }

        .cell-muted
        {
            color: var(--text-muted);
        }

        .role-badge,
        .status-badge
        {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .role-badge--student
        {
            background: var(--purple-light);
            color: var(--purple);
        }

        .role-badge--teacher
        {
            background: #e7effb;
            color: #315ee8;
        }

        body.dark-mode .role-badge--teacher
        {
            background: #1a2140;
            color: #8fa8ff;
        }

        .role-badge--admin
        {
            background: #f4e9fb;
            color: #a13dc2;
        }

        body.dark-mode .role-badge--admin
        {
            background: #2a1740;
            color: #d48cf0;
        }

        .status-badge--active
        {
            background: var(--green-soft);
            color: var(--green);
        }

        .status-badge--inactive
        {
            background: #f1eef2;
            color: var(--text-muted);
        }

        body.dark-mode .status-badge--inactive
        {
            background: #221f2e;
            color: #9e99ae;
        }

        .action-buttons
        {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .action-button
        {
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 12px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface-soft);
            color: var(--text-soft);
            font-size: 10.5px;
            font-weight: 600;
            transition: 0.2s ease;
        }

        .action-button:hover
        {
            border-color: var(--purple);
            color: var(--purple);
        }

        .action-button--activate:hover
        {
            border-color: var(--green);
            color: var(--green);
        }

        .action-button--deactivate:hover
        {
