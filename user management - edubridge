        const revealItems = document.querySelectorAll(".reveal");

        const revealObserver = new IntersectionObserver(
            function(entries)
            {
                entries.forEach(function(entry)
                {
                    if (entry.isIntersecting)
                    {
                        entry.target.classList.add("visible");
                        revealObserver.unobserve(entry.target);
                    }
                });
            },
            {
                threshold: 0.12
            }
        );

        revealItems.forEach(function(item)
        {
            revealObserver.observe(item);
        });

        const cursorGradient = document.querySelector(".cursor-gradient");

        let cursorMouseX = window.innerWidth / 2;
        let cursorMouseY = window.innerHeight / 2;
        let gradientX = cursorMouseX;
        let gradientY = cursorMouseY;

        document.addEventListener("mousemove", function(event)
        {
            cursorMouseX = event.clientX;
            cursorMouseY = event.clientY;

            document.body.classList.add("cursor-ready");
        });

        function moveCursorGradient()
        {
            gradientX += (cursorMouseX - gradientX) * 0.12;
            gradientY += (cursorMouseY - gradientY) * 0.12;

            cursorGradient.style.left = gradientX + "px";
            cursorGradient.style.top = gradientY + "px";

            requestAnimationFrame(moveCursorGradient);
        }

        moveCursorGradient();

        window.addEventListener("scroll", function()
        {
            if (window.scrollY > 450)
            {
                backToTop.classList.add("show");
            }
            else
            {
                backToTop.classList.remove("show");
            }
        });

        backToTop.addEventListener("click", function()
        {
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        });

        const demoUsers =
        [
            {
                name: "Maria Santos",
                studentId: "2026-0001",
                email: "maria.santos@example.com",
                role: "student",
                status: "active"
            },
            {
                name: "Juan Dela Cruz",
                studentId: "2026-0002",
                email: "juan.delacruz@example.com",
                role: "student",
                status: "inactive"
            },
            {
                name: "Angela Reyes",
                studentId: "",
                email: "angela.reyes@example.com",
                role: "teacher",
                status: "active"
            },
            {
                name: "Mark Villanueva",
                studentId: "",
                email: "mark.villanueva@example.com",
                role: "teacher",
                status: "inactive"
            },
            {
                name: "Sofia Lim",
                studentId: "",
                email: "sofia.lim@example.com",
                role: "admin",
                status: "active"
            },
            {
                name: "Carlo Mendoza",
                studentId: "2026-0003",
                email: "carlo.mendoza@example.com",
                role: "student",
                status: "active"
            }
        ];

        const roleLabels =
        {
            student: "Student",
            teacher: "Teacher",
            admin: "Admin"
        };

        const userSearch = document.getElementById("userSearch");
        const roleFilter = document.getElementById("roleFilter");
        const statusFilter = document.getElementById("statusFilter");
        const userTableBody = document.getElementById("userTableBody");
        const emptyState = document.getElementById("emptyState");
        const clearFiltersButton = document.getElementById("clearFiltersButton");

        const listView = document.getElementById("listView");
        const createView = document.getElementById("createView");
        const createAccountButton = document.getElementById("createAccountButton");
        const cancelCreateButton = document.getElementById("cancelCreateButton");
        const createForm = document.getElementById("createForm");

        const createStudentSection = document.getElementById("createStudentSection");
        const createStudentId = document.getElementById("createStudentId");
        const createFullName = document.getElementById("createFullName");
        const createEmail = document.getElementById("createEmail");
        const createRole = document.getElementById("createRole");
        const createCourse = document.getElementById("createCourse");
        const createYear = document.getElementById("createYear");
        const createSection = document.getElementById("createSection");
        const createKey = document.getElementById("createKey");
        const createKeyToggle = document.getElementById("createKeyToggle");

        const viewModal = document.getElementById("viewModal");
        const viewModalList = document.getElementById("viewModalList");
        const viewModalClose = document.getElementById("viewModalClose");

        const editModal = document.getElementById("editModal");
        const editForm = document.getElementById("editForm");
        const editFullName = document.getElementById("editFullName");
        const editEmail = document.getElementById("editEmail");
        const editRole = document.getElementById("editRole");
        const editModalClose = document.getElementById("editModalClose");
        const editCancelButton = document.getElementById("editCancelButton");

        let activeModal = null;
        let lastFocusedElement = null;

        function capitalize(value)
        {
            return value.charAt(0).toUpperCase() + value.slice(1);
        }

        function getInitials(name)
        {
            return name
                .split(" ")
                .map(function(part)
                {
                    return part.charAt(0);
                })
                .join("")
                .slice(0, 2)
                .toUpperCase();
        }

        function getFilteredUsers()
        {
            const query = userSearch.value.trim().toLowerCase();
            const roleValue = roleFilter.value;
            const statusValue = statusFilter.value;

            return demoUsers.filter(function(user)
            {
                const matchesQuery =
                    query === "" ||
                    user.name.toLowerCase().includes(query) ||
                    user.email.toLowerCase().includes(query) ||
                    user.studentId.toLowerCase().includes(query);

                const matchesRole =
                    roleValue === "all" || user.role === roleValue;

                const matchesStatus =
                    statusValue === "all" || user.status === statusValue;

                return matchesQuery && matchesRole && matchesStatus;
            });
        }

        function createBadge(className, text)
        {
            const badge = document.createElement("span");
            badge.className = className;
            badge.textContent = text;
            return badge;
        }

        function createActionButton(label, action, index, extraClass)
        {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "action-button" + extraClass;
            button.dataset.action = action;
            button.dataset.index = String(index);
            button.textContent = label;
            return button;
        }

        function renderUsers()
        {
            const users = getFilteredUsers();

            while (userTableBody.firstChild)
            {
                userTableBody.firstChild.remove();
            }

            emptyState.hidden = users.length > 0;

            users.forEach(function(user)
            {
                const index = demoUsers.indexOf(user);

                const row = document.createElement("tr");

                const userCell = document.createElement("td");
                const userWrap = document.createElement("div");
                userWrap.className = "user-cell";

                const avatar = document.createElement("span");
                avatar.className = "user-avatar";
                avatar.setAttribute("aria-hidden", "true");
                avatar.textContent = getInitials(user.name);

                const nameText = document.createElement("span");
                nameText.className = "user-name";
                nameText.textContent = user.name;

                userWrap.append(avatar, nameText);
                userCell.append(userWrap);

                const idCell = document.createElement("td");

                if (user.studentId === "")
                {
                    idCell.className = "cell-muted";
                    idCell.textContent = "Not applicable";
                }
                else
                {
                    idCell.textContent = user.studentId;
                }

                const emailCell = document.createElement("td");
                emailCell.className = "email-cell";
                emailCell.textContent = user.email;

                const roleCell = document.createElement("td");
                roleCell.append(
                    createBadge(
                        "role-badge role-badge--" + user.role,
                        roleLabels[user.role]
                    )
                );

                const statusCell = document.createElement("td");
                statusCell.append(
                    createBadge(
                        "status-badge status-badge--" + user.status,
                        capitalize(user.status)
                    )
                );

                const actionsCell = document.createElement("td");
                const actionsWrap = document.createElement("div");
                actionsWrap.className = "action-buttons";

                const statusLabel =
                    user.status === "active" ? "Deactivate" : "Activate";

                const statusClass =
                    user.status === "active"
                        ? " action-button--deactivate"
                        : " action-button--activate";

                actionsWrap.append(
                    createActionButton("View", "view", index, ""),
                    createActionButton("Edit", "edit", index, ""),
                    createActionButton(statusLabel, "status", index, statusClass)
                );

                actionsCell.append(actionsWrap);

                row.append(
                    userCell,
                    idCell,
                    emailCell,
                    roleCell,
                    statusCell,
                    actionsCell
                );

                userTableBody.append(row);
            });
        }

        userSearch.addEventListener("input", renderUsers);
        roleFilter.addEventListener("change", renderUsers);
        statusFilter.addEventListener("change", renderUsers);

        clearFiltersButton.addEventListener("click", function()
        {
            userSearch.value = "";
            roleFilter.value = "all";
            statusFilter.value = "all";

            renderUsers();
            userSearch.focus();
        });

        function setError(inputField, errorId, message)
        {
            const errorElement = document.getElementById(errorId);
            const isInvalid = message !== "";

            errorElement.textContent = message;
            inputField.classList.toggle("is-invalid", isInvalid);
            inputField.setAttribute("aria-invalid", String(isInvalid));
        }

        function clearError(inputField, errorId)
        {
            const errorElement = document.getElementById(errorId);

            errorElement.textContent = "";
            inputField.classList.remove("is-invalid");
            inputField.removeAttribute("aria-invalid");
        }

        function revalidateWhileInvalid(inputField, validator)
        {
            inputField.addEventListener("input", function()
            {
                if (inputField.classList.contains("is-invalid"))
                {
                    validator();
                }
            });
        }

        function focusFirstInvalid(form)
        {
            const firstInvalid = form.querySelector(".is-invalid");

            if (firstInvalid)
            {
                firstInvalid.focus();
            }
        }

        function openModal(modal, focusTarget)
        {
            lastFocusedElement = document.activeElement;
            activeModal = modal;
            modal.hidden = false;
            focusTarget.focus();
        }

        function closeModal(modal)
        {
            modal.hidden = true;

            if (activeModal === modal)
            {
                activeModal = null;
            }

            if (lastFocusedElement)
            {
                lastFocusedElement.focus();
                lastFocusedElement = null;
            }
        }

        document.addEventListener("keydown", function(event)
        {
            if (!activeModal)
            {
                return;
            }

            if (event.key === "Escape")
            {
                closeModal(activeModal);
                return;
            }

            if (event.key === "Tab")
            {
                const focusables = activeModal.querySelectorAll(
                    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled])'
                );

                if (focusables.length === 0)
                {
                    return;
                }

                const first = focusables[0];
                const last = focusables[focusables.length - 1];

                if (event.shiftKey && document.activeElement === first)
                {
                    event.preventDefault();
                    last.focus();
                }
                else if (!event.shiftKey && document.activeElement === last)
                {
                    event.preventDefault();
                    first.focus();
                }
            }
        });

        viewModal.addEventListener("click", function(event)
        {
            if (event.target === viewModal)
            {
                closeModal(viewModal);
            }
        });

        editModal.addEventListener("click", function(event)
        {
            if (event.target === editModal)
            {
                closeModal(editModal);
            }
        });

        function openViewModal(user)
        {
            while (viewModalList.firstChild)
            {
                viewModalList.firstChild.remove();
            }

            const details =
                [
                    ["Name", user.name],
                    [
                        "Student ID",
                        user.studentId === ""
                            ? "Not applicable"
                            : user.studentId
                    ]
                ];

            if (user.role === "student")
            {
                if (user.course)
                {
                    details.push(["Course / Program", user.course]);
                }

                if (user.year)
                {
                    details.push(["Year Level", user.year]);
                }

                if (user.section)
                {
                    details.push(["Section / Block", user.section]);
                }
            }

            details.push(
                ["Email Address", user.email],
                ["Role", roleLabels[user.role]],
                ["Account Status", capitalize(user.status)]
            );

            details.forEach(function(pair)
            {
                const item = document.createElement("div");
                item.className = "detail-item";

                const label = document.createElement("dt");
                label.textContent = pair[0];

                const value = document.createElement("dd");
                value.textContent = pair[1];

                item.append(label, value);
                viewModalList.append(item);
            });

            openModal(viewModal, viewModalClose);
        }

        function openEditModal(user)
        {
            clearError(editFullName, "editFullNameError");
            clearError(editEmail, "editEmailError");

            editFullName.value = user.name;
            editEmail.value = user.email;
            editRole.value = user.role;

            openModal(editModal, editFullName);
        }

        function validateEditFullName()
        {
            const message = editFullName.value.trim() === ""
                ? "Full name is required."
                : "";

            setError(editFullName, "editFullNameError", message);
            return message === "";
        }

        function validateEditEmail()
        {
            const value = editEmail.value.trim();
            let message = "";

            if (value === "")
            {
                message = "Email address is required.";
            }
            else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value))
            {
                message = "Enter a valid email address.";
            }

            setError(editEmail, "editEmailError", message);
            return message === "";
        }

        revalidateWhileInvalid(editFullName, validateEditFullName);
        revalidateWhileInvalid(editEmail, validateEditEmail);

        editForm.addEventListener("submit", function(event)
        {
            event.preventDefault();

            const checks =
                [
                    validateEditFullName(),
                    validateEditEmail()
                ];

            if (checks.includes(false))
            {
                focusFirstInvalid(editForm);
                return;
            }

            closeModal(editModal);

            showToast("Account updated.", "info");
        });

        viewModalClose.addEventListener("click", function()
        {
            closeModal(viewModal);
        });

        editModalClose.addEventListener("click", function()
        {
            closeModal(editModal);
        });

        editCancelButton.addEventListener("click", function()
        {
            closeModal(editModal);
        });

        userTableBody.addEventListener("click", function(event)
        {
            const button = event.target.closest("button[data-action]");

            if (!button)
            {
                return;
            }

            const index = Number(button.dataset.index);
            const user = demoUsers[index];

            if (!user)
            {
                return;
            }

            if (button.dataset.action === "view")
            {
                openViewModal(user);
            }
            else if (button.dataset.action === "edit")
            {
                openEditModal(user);
            }
            else
            {
                showToast("Account status updated.", "info");
            }
        });

        function validateCreateStudentId()
        {
            if (createStudentSection.hidden)
            {
                clearError(createStudentId, "createStudentIdError");
                return true;
            }

            const message = createStudentId.value.trim() === ""
                ? "Student ID is required for Student accounts."
                : "";

            setError(createStudentId, "createStudentIdError", message);
            return message === "";
        }

        function validateCreateFullName()
        {
            const message = createFullName.value.trim() === ""
                ? "Full name is required."
                : "";

            setError(createFullName, "createFullNameError", message);
            return message === "";
        }

        function validateCreateEmail()
        {
            const value = createEmail.value.trim();
            let message = "";

            if (value === "")
            {
                message = "Email address is required.";
            }
            else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value))
            {
                message = "Enter a valid email address.";
            }

            setError(createEmail, "createEmailError", message);
            return message === "";
        }

        function validateCreateRole()
        {
            const message = createRole.value === ""
                ? "Select a role."
                : "";

            setError(createRole, "createRoleError", message);
            return message === "";
        }

        function validateCreateKey()
        {
            const message = createKey.value.trim() === ""
                ? "Admin verification key is required."
                : "";

            setError(createKey, "createKeyError", message);
            return message === "";
        }

        revalidateWhileInvalid(createStudentId, validateCreateStudentId);
        revalidateWhileInvalid(createFullName, validateCreateFullName);
        revalidateWhileInvalid(createEmail, validateCreateEmail);
        revalidateWhileInvalid(createKey, validateCreateKey);

        createRole.addEventListener("change", function()
        {
            const isStudent = createRole.value === "student";

            createStudentSection.hidden = !isStudent;
            createStudentId.required = isStudent;

            validateCreateRole();

            if (!isStudent)
            {
                clearError(createStudentId, "createStudentIdError");
            }
        });

        createKeyToggle.addEventListener("click", function()
        {
            const isShowing =
                createKeyToggle.classList.toggle("is-showing");

            createKey.type = isShowing ? "text" : "password";

            createKeyToggle.setAttribute(
                "aria-label",
                isShowing ? "Hide verification key" : "Show verification key"
            );

            createKeyToggle.setAttribute(
                "aria-pressed",
                String(isShowing)
            );
        });

        function resetCreateForm()
        {
            createForm.reset();

            clearError(createStudentId, "createStudentIdError");
            clearError(createFullName, "createFullNameError");
            clearError(createEmail, "createEmailError");
            clearError(createRole, "createRoleError");
            clearError(createKey, "createKeyError");

            createStudentSection.hidden = true;
            createStudentId.required = false;

            createKeyToggle.classList.remove("is-showing");
            createKey.type = "password";
            createKeyToggle.setAttribute("aria-label", "Show verification key");
            createKeyToggle.setAttribute("aria-pressed", "false");
        }

        createAccountButton.addEventListener("click", function()
        {
            listView.hidden = true;
            createView.hidden = false;

            const firstField = createStudentSection.hidden
                ? createFullName
                : createStudentId;

            firstField.focus();
        });

        cancelCreateButton.addEventListener("click", function()
        {
            resetCreateForm();

            createView.hidden = true;
            listView.hidden = false;

            createAccountButton.focus();
        });

        createForm.addEventListener("submit", function(event)
        {
            event.preventDefault();

            const checks =
                [
                    validateCreateStudentId(),
                    validateCreateFullName(),
                    validateCreateEmail(),
                    validateCreateRole(),
                    validateCreateKey()
                ];

            if (checks.includes(false))
            {
                focusFirstInvalid(createForm);
                return;
            }

            const isStudent = createRole.value === "student";

            demoUsers.push(
                {
                    name: createFullName.value.trim(),
                    studentId: isStudent ? createStudentId.value.trim() : "",
                    email: createEmail.value.trim(),
                    role: createRole.value,
                    status: "active",
                    course: isStudent ? createCourse.value.trim() : "",
                    year: isStudent ? createYear.value : "",
                    section: isStudent ? createSection.value.trim() : ""
                });

            userSearch.value = "";
            roleFilter.value = "all";
            statusFilter.value = "all";

            renderUsers();

            resetCreateForm();

            createView.hidden = true;
            listView.hidden = false;

            createAccountButton.focus();

            showToast("Account created.", "info");
        });

        renderUsers();
    </script>

</body>
