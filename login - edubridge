<!DOCTYPE html>
<head>
    <title>Login | EduBridge</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        *
        {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root
        {
            --background: #f3f3f3;
            --surface: #ffffff;
            --surface-soft: #faf9fc;
            --text: #17152d;
            --text-soft: #696774;
            --text-muted: #77737e;
            --border: #e1e1e1;
            --purple: #7138c8;
            --purple-light: #eee5ff;
            --purple-soft: #eadcff;
            --green: #1f9d63;
            --green-soft: #e7f6ee;
            --red: #d64550;
            --red-soft: #fdeced;
            --shadow: rgba(40, 24, 75, 0.08);
        }

        body
        {
            font-family: Poppins, Arial, sans-serif;
            color: var(--text);
            background: #08051d;
            overflow-x: hidden;
        }

        a
        {
            color: inherit;
            text-decoration: none;
        }

        button
        {
            font-family: inherit;
            cursor: pointer;
        }

        .cursor-gradient
        {
            position: fixed;
            width: 500px;
            height: 500px;
            left: 0;
            top: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9998;
            opacity: 0;
            background:
                radial-gradient(
                    circle,
                    rgba(185, 120, 255, 0.16) 0%,
                    rgba(86, 105, 255, 0.10) 28%,
                    rgba(225, 80, 160, 0.06) 48%,
                    transparent 72%
                );
            filter: blur(32px);
            transition: opacity 0.35s ease;
        }

        body.cursor-ready .cursor-gradient
        {
            opacity: 1;
        }

        .reveal
        {
            opacity: 1;
            transform: translateY(0);
        }

        body.js .reveal
        {
            opacity: 0;
            transform: translateY(28px);
            transition:
                opacity 0.7s ease,
                transform 0.7s ease;
        }

        body.js .reveal.visible
        {
            opacity: 1;
            transform: translateY(0);
        }

        @keyframes purpleFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-20px, -15px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(45px, 35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(10px, 70px);
            }
        }

        @keyframes blueFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(20px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(-55px, 35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-15px, -30px);
            }
        }

        @keyframes violetFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-25px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(55px, -35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-40px, 45px);
            }
        }

        @keyframes cyanFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(25px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(-45px, -30px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(35px, -55px);
            }
        }

        @keyframes smallPinkFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-15px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(35px, -35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-30px, 45px);
            }
        }

        .login-page
        {
            display: flex;
            min-height: 100vh;
            background: #08051d;
        }

        .brand-panel
        {
            position: relative;
            flex: 1.25;
            min-width: 0;
            display: flex;
            isolation: isolate;
            overflow: hidden;
            padding: 44px 136px 48px 64px;
            background: #08051d;
        }

        .brand-image
        {
            position: absolute;
            inset: 0;
            z-index: -10;
            pointer-events: none;
            background-image: url("Edubridge-Hero-About.png");
            background-size: cover;
            background-position: center;
            opacity: 0.62;
            transform: scale(1.04);
            transition: transform 0.25s ease-out;
        }

        .brand-shade
        {
            position: absolute;
            inset: 0;
            z-index: -9;
            pointer-events: none;
            background:
                linear-gradient(
                    135deg,
                    rgba(5, 5, 35, 0.7),
                    rgba(14, 4, 40, 0.32),
                    rgba(5, 5, 30, 0.65)
                );
        }

        .gradient-layer
        {
            position: absolute;
            inset: 0;
            z-index: -8;
            overflow: hidden;
            pointer-events: none;
        }

        .gradient
        {
            position: absolute;
            border-radius: 50%;
            filter: blur(65px);
            mix-blend-mode: screen;
            opacity: 0.72;
        }

        .gradient-purple
        {
            width: 430px;
            height: 430px;
            background: #7138c8;
            left: var(--purple-x, 4%);
            top: var(--purple-y, 5%);
            animation: purpleFloat 12s ease-in-out infinite alternate;
        }

        .gradient-blue
        {
            width: 390px;
            height: 390px;
            background: #315ee8;
            left: var(--blue-x, 93%);
            top: var(--blue-y, 8%);
            animation: blueFloat 14s ease-in-out infinite alternate;
        }

        .gradient-violet
        {
            width: 430px;
            height: 430px;
            background: #933cff;
            left: var(--violet-x, 55%);
            top: var(--violet-y, 38%);
            animation: violetFloat 15s ease-in-out infinite alternate;
        }

        .gradient-cyan
        {
            width: 340px;
            height: 340px;
            background: #387ee8;
            left: var(--cyan-x, 5%);
            top: var(--cyan-y, 93%);
            animation: cyanFloat 16s ease-in-out infinite alternate;
        }

        .gradient-pink-small
        {
            width: 270px;
            height: 270px;
            background: #b73fbd;
            left: var(--pink-small-x, 78%);
            top: var(--pink-small-y, 67%);
            animation: smallPinkFloat 12s ease-in-out infinite alternate;
        }

        .brand-content
        {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 24px;
        }

        .logo
        {
            display: flex;
            width: fit-content;
            align-items: center;
            gap: 2px;
            font-size: 18px;
            font-weight: 600;
            white-space: nowrap;
        }

        .logo img
        {
            width: 90px;
            height: 90px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .brand-name
        {
            display: flex;
            align-items: center;
            margin-left: -3px;
            letter-spacing: -0.4px;
        }

        .brand-edu
        {
            color: white;
        }

        .brand-bridge
        {
            color: #7339c2;
        }

        .brand-intro h1
        {
            max-width: 640px;
            color: white;
            font-size: 52px;
            line-height: 1.1;
            font-weight: 600;
            text-wrap: balance;
        }

        .brand-intro h1 span
        {
            color: #b77aff;
        }

        .brand-intro p
        {
            max-width: 620px;
            margin-top: 16px;
            color: #d5d1df;
            font-size: 15px;
            line-height: 1.8;
        }

        .accent-line
        {
            display: block;
            width: 64px;
            height: 4px;
            margin-top: 22px;
            border-radius: 4px;
            background: linear-gradient(90deg, #7138c8, #b77aff);
        }

        .feature-list
        {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100px, 100%), 1fr));
            gap: 26px 18px;
            list-style: none;
        }

        .feature-item
        {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            text-align: center;
        }

        .feature-icon
        {
            display: flex;
            width: 45px;
            height: 45px;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(183, 122, 255, 0.4);
            border-radius: 50%;
            background:
                linear-gradient(
                    135deg,
                    rgba(113, 56, 200, 0.5),
                    rgba(113, 56, 200, 0.16)
                );
            box-shadow: 0 10px 24px rgba(5, 5, 30, 0.4);
            color: #c58cff;
            transition: 0.25s ease;
        }

        .feature-icon svg
        {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        .feature-item:hover .feature-icon
        {
            border-color: #b77aff;
            background: #7138c8;
            color: white;
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(113, 56, 200, 0.45);
        }

        .feature-item:hover .feature-text h3
        {
            color: #c58cff;
        }

        .feature-text h3
        {
            margin-bottom: 4px;
            color: white;
            font-size: 14px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .feature-text p
        {
            color: #d5d1df;
            font-size: 11px;
            line-height: 1.7;
        }

        body.js .feature-list .feature-item
        {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        body.js .feature-list .feature-item:nth-child(2)
        {
            transition-delay: 0.07s;
        }

        body.js .feature-list .feature-item:nth-child(3)
        {
            transition-delay: 0.14s;
        }

        body.js .feature-list .feature-item:nth-child(4)
        {
            transition-delay: 0.21s;
        }

        body.js .feature-list .feature-item:nth-child(5)
        {
            transition-delay: 0.28s;
        }

        body.js .feature-list.visible .feature-item
        {
            opacity: 1;
            transform: translateY(0);
        }

        .form-panel
        {
            position: relative;
            width: clamp(460px, 46%, 760px);
            display: flex;
            flex-direction: column;
            margin-left: -96px;
            padding: 44px 60px 26px;
            border-radius: 96px 0 0 96px;
            background: var(--surface);
            box-shadow: -22px 0 55px rgba(5, 5, 30, 0.45);
        }

        .form-top
        {
            display: flex;
            min-height: 90px;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
        }

        .form-top p
        {
            color: var(--text-soft);
            font-size: 13px;
        }

        .form-top a
        {
            color: var(--purple);
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 2px;
            transition: 0.2s ease;
        }

        .form-top a:hover
        {
            color: #5f2fb0;
        }

        .login-card
        {
            width: min(440px, 100%);
            margin: auto;
            padding: 32px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface);
            box-shadow: 0 5px 20px var(--shadow);
        }

        .login-card h2
        {
            color: var(--text);
            font-size: 26px;
            font-weight: 600;
            text-align: center;
        }

        .card-subtitle
        {
            margin-top: 6px;
            margin-bottom: 22px;
            color: var(--text-soft);
            font-size: 12.5px;
            line-height: 1.6;
            text-align: center;
        }

        .form-group
        {
            margin-bottom: 15px;
        }

        .form-group label
        {
            display: block;
            margin-bottom: 7px;
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
        }

        .form-group input,
        .form-group select
        {
            width: 100%;
            height: 40px;
            padding: 0 12px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface-soft);
            color: var(--text);
            font-family: inherit;
            font-size: 12px;
            outline: none;
            transition: 0.2s ease;
        }

        .form-group input::placeholder
        {
            color: var(--text-muted);
        }

        .form-group input:focus,
        .form-group select:focus
        {
            border-color: var(--purple);
            box-shadow: 0 0 0 3px var(--purple-light);
        }

        .form-group input:user-invalid,
        .form-group select:user-invalid
        {
            border-color: var(--red);
            box-shadow: 0 0 0 3px var(--red-soft);
        }

        .input-shell
        {
            position: relative;
        }

        .input-icon
        {
            position: absolute;
            top: 50%;
            left: 12px;
            width: 15px;
            height: 15px;
            fill: var(--text-muted);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .input-shell input
        {
            padding-left: 36px;
        }

        .password-field input
        {
            padding-right: 40px;
        }

        .password-toggle
        {
            position: absolute;
            top: 50%;
            right: 8px;
            display: inline-flex;
            width: 26px;
            height: 26px;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 4px;
            background: transparent;
            color: var(--text-muted);
            transform: translateY(-50%);
            transition: 0.2s ease;
        }

        .password-toggle:hover
        {
            background: var(--purple-light);
            color: var(--purple);
        }

        .password-toggle svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .password-toggle .eye-open
        {
            display: none;
        }

        .password-toggle.is-showing .eye-open
        {
            display: block;
        }

        .password-toggle.is-showing .eye-off
        {
            display: none;
        }

        .select-shell select
        {
            padding-right: 34px;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
        }

        .select-chevron
        {
            position: absolute;
            top: 50%;
            right: 12px;
            width: 13px;
            height: 13px;
            fill: var(--text-muted);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .form-actions
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 15px;
        }

        .remember-row
        {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-soft);
            font-size: 12px;
            cursor: pointer;
        }

        .remember-checkbox
        {
            width: 15px;
            height: 15px;
            accent-color: var(--purple);
            cursor: pointer;
        }

        .forgot-button
        {
            display: inline-flex;
            height: 40px;
            align-items: center;
            padding: 0 4px;
            border: none;
            background: transparent;
            color: var(--purple);
            font-size: 12px;
            font-weight: 600;
            transition: 0.2s ease;
        }

        .forgot-button:hover
        {
            text-decoration: underline;
        }

        .login-button
        {
            display: inline-flex;
            width: 100%;
            height: 44px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            border-radius: 5px;
            background: #7138c8;
            color: white;
            font-size: 12.5px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .login-button:hover
        {
            background: #5f2fb0;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(113, 56, 200, 0.22);
        }

        .login-button:active
        {
            transform: scale(0.97);
        }

        .login-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .google-section
        {
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transition:
                max-height 0.3s ease,
                opacity 0.3s ease,
                visibility 0.3s ease;
        }

        .google-section.is-visible
        {
            max-height: 140px;
            opacity: 1;
            visibility: visible;
            padding: 0 4px 4px;
            margin: 0 -4px -4px;
        }

        .google-divider
        {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-top: 18px;
            color: var(--text-muted);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .google-divider::before,
        .google-divider::after
        {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .google-button
        {
            display: inline-flex;
            width: 100%;
            height: 44px;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface);
            color: var(--text);
            font-size: 12.5px;
            font-weight: 600;
            transition:
                border-color 0.25s ease,
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .google-button:hover
        {
            border-color: #a970ff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px var(--shadow);
        }

        .google-button:active
        {
            transform: scale(0.97);
        }

        .google-icon
        {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .login-button:focus-visible,
        .form-top a:focus-visible,
        .forgot-button:focus-visible,
        .password-toggle:focus-visible,
        .google-button:focus-visible,
        .remember-checkbox:focus-visible,
        .toast-close:focus-visible
        {
            outline: 2px solid var(--purple);
            outline-offset: 2px;
        }

        .login-button:focus-visible
        {
            background: #5f2fb0;
            box-shadow: 0 8px 18px rgba(113, 56, 200, 0.22);
        }

        .copyright
        {
            margin-top: 26px;
            color: var(--text-muted);
            font-size: 11px;
            text-align: center;
        }

        .toast-container
        {
            position: fixed;
            top: 96px;
            right: 24px;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: min(340px, calc(100vw - 48px));
            pointer-events: none;
        }

        .toast
        {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-left: 3px solid var(--purple);
            border-radius: 6px;
            background: var(--surface);
            box-shadow: 0 10px 28px var(--shadow);
            opacity: 0;
            pointer-events: auto;
            transform: translateX(24px);
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        .toast--visible
        {
            opacity: 1;
            transform: translateX(0);
        }

        .toast--leaving
        {
            opacity: 0;
            transform: translateX(24px);
        }

        .toast--success
        {
            border-left-color: var(--green);
        }

        .toast--error
        {
            border-left-color: var(--red);
        }

        .toast--info
        {
            border-left-color: var(--purple);
        }

        .toast-icon
        {
            display: flex;
            width: 26px;
            height: 26px;
            min-width: 26px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--purple-light);
            color: var(--purple);
        }

        .toast--success .toast-icon
        {
            background: var(--green-soft);
            color: var(--green);
        }

        .toast--error .toast-icon
        {
            background: var(--red-soft);
            color: var(--red);
        }

        .toast-icon svg
        {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .toast-body
        {
            flex: 1;
            min-width: 0;
        }

        .toast-message
        {
            margin: 2px 0 0;
            color: var(--text);
            font-size: 12px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .toast-close
        {
            display: inline-flex;
            width: 20px;
            height: 20px;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 4px;
            background: transparent;
            color: var(--text-muted);
            transition: 0.2s ease;
        }

        .toast-close:hover
        {
            background: var(--surface-soft);
            color: var(--text);
        }

        .toast-close svg
        {
            width: 10px;
            height: 10px;
            fill: currentColor;
        }

        @media (max-width: 1100px)
        {
            .brand-panel
            {
                padding: 40px 128px 44px 48px;
            }

            .brand-intro h1
            {
                font-size: 44px;
            }

            .form-panel
            {
                width: clamp(440px, 44%, 720px);
                padding: 40px 44px 24px;
            }
        }

        @media (max-width: 980px)
        {
            .login-page
            {
                flex-direction: column;
            }

            .brand-panel
            {
                padding: 36px 40px 44px;
            }

            .form-top
            {
                min-height: 0;
            }

            .form-panel
            {
                flex: 1;
                width: 100%;
                margin-left: 0;
                padding: 24px 40px 22px;
                border-radius: 44px 44px 0 0;
                box-shadow: 0 -18px 45px rgba(5, 5, 30, 0.35);
            }
        }

        @media (max-width: 760px)
        {
            .brand-panel
            {
                padding: 32px 26px 40px;
            }

            .gradient
            {
                filter: blur(50px);
            }

            .gradient-purple,
            .gradient-violet
            {
                width: 330px;
                height: 330px;
            }

            .gradient-blue
            {
                width: 300px;
                height: 300px;
            }

            .gradient-cyan
            {
                width: 260px;
                height: 260px;
            }

            .gradient-pink-small
            {
                width: 220px;
                height: 220px;
            }

            .form-panel
            {
                padding: 24px 26px 22px;
            }
        }

        @media (max-width: 600px)
        {
            .brand-panel
            {
                padding: 28px 22px 36px;
