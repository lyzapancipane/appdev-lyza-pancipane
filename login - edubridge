    <script>
        document.body.classList.add("js");

        const toastContainer = document.createElement("div");
        toastContainer.className = "toast-container";
        document.body.append(toastContainer);

        const toastDurations =
        {
            success: 2000,
            info: 2000,
            error: 3000
        };

        const toastIcons =
        {
            success:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.1 14.9-4.2-4.2 1.4-1.4 2.8 2.8 6.6-6.6 1.4 1.4-8 8z"></path></svg>',
            error:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.3 12.9-1.4 1.4-2.9-2.9-2.9 2.9-1.4-1.4 2.9-2.9-2.9-2.9 1.4-1.4 2.9 2.9 2.9-2.9 1.4 1.4-2.9 2.9 2.9 2.9z"></path></svg>',
            info:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"></path></svg>'
        };

        function showToast(message, type)
        {

            const kind = toastIcons[type] ? type : "info";

            while (toastContainer.children.length >= 3)
            {
                toastContainer.firstElementChild.remove();
            }

            const toast = document.createElement("div");
            toast.className = "toast toast--" + kind;
            toast.setAttribute("role", kind === "error" ? "alert" : "status");

            const icon = document.createElement("span");
            icon.className = "toast-icon";
            icon.setAttribute("aria-hidden", "true");
            icon.innerHTML = toastIcons[kind];

            const body = document.createElement("div");
            body.className = "toast-body";

            const text = document.createElement("p");
            text.className = "toast-message";
            text.textContent = message;

            body.append(text);

            const closeButton = document.createElement("button");
            closeButton.className = "toast-close";
            closeButton.type = "button";
            closeButton.setAttribute("aria-label", "Dismiss notification");
            closeButton.innerHTML =
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"></path></svg>';

            toast.append(icon, body, closeButton);
            toastContainer.append(toast);

            let dismissTimer = null;

            function dismissToast()
            {

                if (dismissTimer === null)
                {
                    return;
                }

                window.clearTimeout(dismissTimer);
                dismissTimer = null;

                toast.classList.add("toast--leaving");

                window.setTimeout(function()
                {
                    toast.remove();
                }, 250);

            }

            closeButton.addEventListener("click", dismissToast);

            window.requestAnimationFrame(function()
            {
                toast.classList.add("toast--visible");
            });

            dismissTimer = window.setTimeout(dismissToast, toastDurations[kind]);

        }

        const loginForm = document.getElementById("loginForm");
        const identifierLabel = document.getElementById("identifierLabel");
        const identifierInput = document.getElementById("identifier");
        const passwordInput = document.getElementById("password");
        const passwordToggle = document.getElementById("passwordToggle");
        const roleSelect = document.getElementById("roleSelect");
        const googleSection = document.getElementById("googleSection");
        const googleButton = document.getElementById("googleButton");

        roleSelect.addEventListener("change", function()
        {
            const useEmail = roleSelect.value !== "student";

            identifierLabel.textContent = useEmail ? "Email Address" : "Student ID";
            identifierInput.placeholder = useEmail
                ? "Enter your email address"
                : "Enter your Student ID";

            googleSection.classList.toggle("is-visible", useEmail);
        });

        passwordToggle.addEventListener("click", function()
        {
            const isHidden = passwordInput.type === "password";

            passwordInput.type = isHidden ? "text" : "password";
            passwordToggle.classList.toggle("is-showing", isHidden);
            passwordToggle.setAttribute("aria-pressed", String(isHidden));
            passwordToggle.setAttribute(
                "aria-label",
                isHidden ? "Hide password" : "Show password"
            );
        });

        googleButton.addEventListener("click", function()
        {
            showToast(
                "Google sign-in will be available once the backend is connected.",
                "info"
            );
        });

        loginForm.addEventListener("submit", function(event)
        {
            event.preventDefault();

            if (!loginForm.checkValidity())
            {
                return;
            }

            showToast(
                "Sign-in will be available once the backend is connected.",
                "info"
            );
        });

        const revealItems = document.querySelectorAll(".reveal");

        const revealObserver = new IntersectionObserver(
            function(entries)
            {
                entries.forEach(function(entry)
                {
                    if (entry.isIntersecting)
                    {
                        entry.target.classList.add("visible");
                        revealObserver.unobserve(entry.target);
                    }
                });
            },
            {
                threshold: 0.12
            }
        );

        revealItems.forEach(function(item)
        {
            revealObserver.observe(item);
        });

        const brandPanel = document.querySelector(".brand-panel");
        const brandImage = document.querySelector(".brand-image");
        const gradientLayer = document.querySelector(".gradient-layer");

        const motionAllowed =
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let panelTargetX = 50;
        let panelTargetY = 50;
        let panelCursorX = 50;
        let panelCursorY = 50;

        if (motionAllowed)
        {
            brandPanel.addEventListener("mousemove", function(event)
            {
                const rect = brandPanel.getBoundingClientRect();

                const moveX = (event.clientX - rect.left) / rect.width - 0.5;
                const moveY = (event.clientY - rect.top) / rect.height - 0.5;

                brandImage.style.transform =
                    "scale(1.04) translate(" +
                    moveX * -10 + "px, " +
                    moveY * -7 + "px)";

                panelTargetX =
                    ((event.clientX - rect.left) / rect.width) * 100;

                panelTargetY =
                    ((event.clientY - rect.top) / rect.height) * 100;
            });

            brandPanel.addEventListener("mouseleave", function()
            {
                panelTargetX = 50;
                panelTargetY = 50;

                brandImage.style.transform =
                    "scale(1.04) translate(0, 0)";
            });
        }

        const cursorGradient = document.querySelector(".cursor-gradient");

        let cursorMouseX = window.innerWidth / 2;
        let cursorMouseY = window.innerHeight / 2;
        let gradientX = cursorMouseX;
        let gradientY = cursorMouseY;

        document.addEventListener("mousemove", function(event)
        {
            cursorMouseX = event.clientX;
            cursorMouseY = event.clientY;
            document.body.classList.add("cursor-ready");
        });

        function moveCursorGradient()
        {
            gradientX += (cursorMouseX - gradientX) * 0.12;
            gradientY += (cursorMouseY - gradientY) * 0.12;
            cursorGradient.style.left = gradientX + "px";
            cursorGradient.style.top = gradientY + "px";

            if (motionAllowed)
            {
                panelCursorX += (panelTargetX - panelCursorX) * 0.04;
                panelCursorY += (panelTargetY - panelCursorY) * 0.04;

                gradientLayer.style.setProperty(
                    "--purple-x",
                    4 + (panelCursorX - 50) * 0.35 + "%"
                );

                gradientLayer.style.setProperty(
                    "--purple-y",
                    5 + (panelCursorY - 50) * 0.25 + "%"
                );

                gradientLayer.style.setProperty(
                    "--blue-x",
                    93 + (panelCursorX - 50) * 0.3 + "%"
                );

                gradientLayer.style.setProperty(
                    "--blue-y",
                    8 + (panelCursorY - 50) * 0.25 + "%"
                );

                gradientLayer.style.setProperty(
                    "--violet-x",
                    55 + (panelCursorX - 50) * 0.65 + "%"
                );

                gradientLayer.style.setProperty(
                    "--violet-y",
                    38 + (panelCursorY - 50) * 0.55 + "%"
                );

                gradientLayer.style.setProperty(
                    "--cyan-x",
                    5 + (panelCursorX - 50) * 0.3 + "%"
                );

                gradientLayer.style.setProperty(
                    "--cyan-y",
                    93 + (panelCursorY - 50) * 0.35 + "%"
                );

                gradientLayer.style.setProperty(
                    "--pink-small-x",
                    78 + (panelCursorX - 50) * 0.55 + "%"
                );

                gradientLayer.style.setProperty(
                    "--pink-small-y",
                    67 + (panelCursorY - 50) * 0.5 + "%"
                );
            }

            window.requestAnimationFrame(moveCursorGradient);
        }

        moveCursorGradient();

        let audioContext;

        function playClickSound()
        {
            try
            {
                if (!audioContext)
                {
                    audioContext =
                        new (window.AudioContext || window.webkitAudioContext)();
                }

                if (audioContext.state === "suspended")
                {
                    audioContext.resume();
                }

                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();

                oscillator.type = "sine";

                oscillator.frequency.setValueAtTime(
                    520,
                    audioContext.currentTime
                );

                oscillator.frequency.exponentialRampToValueAtTime(
                    300,
                    audioContext.currentTime + 0.045
                );

                gain.gain.setValueAtTime(
                    0.045,
                    audioContext.currentTime
                );

                gain.gain.exponentialRampToValueAtTime(
                    0.001,
                    audioContext.currentTime + 0.06
                );

                oscillator.connect(gain);
                gain.connect(audioContext.destination);

                oscillator.start();

                oscillator.stop(audioContext.currentTime + 0.06);
            }
            catch (error)
            {
            }
        }

        document.addEventListener("click", function(event)
        {
            const clickable = event.target.closest("button, a");

            if (clickable)
            {
                playClickSound();
            }
        });
    </script>
