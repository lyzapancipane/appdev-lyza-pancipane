	<script>
		try
		{
			document.body.classList.add("js");

			const themeButton = document.getElementById("themeButton");
			const themeIcon = document.getElementById("themeIcon");
			const backToTop = document.getElementById("backToTop");

			function updateThemeIcon()
			{
				if (document.body.classList.contains("dark-mode"))
				{
					themeIcon.innerHTML = "<path d=\"M21 12.8A9 9 0 0 1 11.2 3 7 7 0 1 0 21 12.8z\"></path>";
				}
				else
				{
					themeIcon.innerHTML = "<path d=\"M12 3V1m0 22v-2M4.22 4.22 2.81 2.81m18.38 18.38-1.41-1.41M3 12H1m22 0h-2M4.22 19.78l-1.41 1.41M21.19 2.81l-1.41-1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z\"></path>";
				}
			}

			const savedTheme = localStorage.getItem("edubridge-theme");

			if (savedTheme === "dark")
			{
				document.body.classList.add("dark-mode");
			}

			updateThemeIcon();

			themeButton.addEventListener("click", function()
			{
				const rect = themeButton.getBoundingClientRect();

				document.body.style.setProperty("--theme-x", rect.left + rect.width / 2 + "px");
				document.body.style.setProperty("--theme-y", rect.top + rect.height / 2 + "px");

				const isCurrentlyDark = document.body.classList.contains("dark-mode");
				document.body.style.setProperty("--theme-circle", isCurrentlyDark ? "#f3f3f3" : "#090817");
				document.body.classList.add("theme-changing");

				setTimeout(function()
				{
					document.body.classList.toggle("dark-mode");
					const isDark = document.body.classList.contains("dark-mode");
					localStorage.setItem("edubridge-theme", isDark ? "dark" : "light");
					updateThemeIcon();
				}, 100);

				setTimeout(function()
				{
					document.body.classList.remove("theme-changing");
				}, 750);
			});

			const toastElement = document.getElementById("pageToast");
			let toastTimer = null;

			function showToast(message)
			{
				toastElement.textContent = message;
				toastElement.hidden = false;

				if (toastTimer)
				{
					clearTimeout(toastTimer);
				}

				toastTimer = setTimeout(function()
				{
					toastElement.hidden = true;
				}, 4200);
			}

			function applyNavProfile()
			{
				const profile = document.querySelector(".nav-profile");

				if (!profile)
				{
					return;
				}

				const role = (localStorage.getItem("edubridge-role") || "").toLowerCase();
				const img = profile.querySelector("img");
				const name = profile.querySelector(".nav-profile-text strong");
				const roleText = profile.querySelector(".nav-profile-text small");

				if (role === "student" || role === "teacher")
				{
					img.src = EduBridgeProfile.savedPicture(role) || "junior.jpg";
					img.alt = "Junior Slickback";
					name.textContent = "Junior Slickback";
					roleText.textContent = "Student";
					profile.setAttribute("href", "inquiries.html");
				}
				else
				{
					img.src = EduBridgeProfile.savedPicture(role) || "resume.jpg";
					img.alt = "Lyza Camille Pancipane";
					name.textContent = "Lyza Camille Pancipane";
					roleText.textContent = "Administrator";
					profile.setAttribute("href", "admin-profile.html");
				}
			}

			applyNavProfile();

			const navbar = document.querySelector(".navbar");
			const menuButton = document.getElementById("menuButton");

			menuButton.addEventListener("click", function()
			{
				const isOpen = navbar.classList.toggle("menu-open");

				menuButton.setAttribute("aria-expanded", String(isOpen));
