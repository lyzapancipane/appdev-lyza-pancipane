					{
						attachments.splice(index, 1);
						renderFileList();
						updateSummary();
					});

					row.appendChild(label);
					row.appendChild(meta);
					row.appendChild(removeButton);
					fileList.appendChild(row);
				});

				updateSummary();
			}

			function addFiles(fileCollection)
			{
				Array.prototype.forEach.call(fileCollection, function(file)
				{
					const allowed = /\.(jpe?g|png|pdf)$/i.test(file.name);

					if (!allowed)
					{
						showToast("Skipped " + file.name + " - only JPG, PNG, and PDF files are allowed.");
						return;
					}

					if (file.size > maxFileSize)
					{
						showToast("Skipped " + file.name + " - the file exceeds the 5MB limit.");
						return;
					}

					attachments.push(file);
				});

				renderFileList();
			}

