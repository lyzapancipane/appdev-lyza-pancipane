			function normalizeLinkUrl(raw)
			{
				const value = raw.trim();

				if (!value || /\s/.test(value))
				{
					return null;
				}

				if (/^(javascript|data|vbscript|file):/i.test(value))
				{
					return null;
				}

				if (/^https?:\/\//i.test(value))
				{
					return value;
				}

				if (/^[a-z][a-z0-9+.-]*:/i.test(value))
				{
					return null;
				}

				return "https://" + value;
			}

