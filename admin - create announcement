			const previewModal = document.getElementById("previewModal");
			const previewMeta = document.getElementById("previewMeta");
			const previewBody = document.getElementById("previewBody");

			function closePreview()
			{
				previewModal.hidden = true;
			}

			document.getElementById("previewBtn").addEventListener("click", function()
			{
				if (!titleInput.value.trim() || editorEmpty())
				{
					showToast("Add a title and content before previewing.");
					return;
				}

				previewBody.innerHTML = "";

				const heading = document.createElement("h3");
				heading.textContent = titleInput.value.trim();
				previewBody.appendChild(heading);

				const content = document.createElement("div");
				content.innerHTML = editor.innerHTML;
				previewBody.appendChild(content);

				previewMeta.innerHTML = "";

				const chips = [
					titleInput.value.trim() ? "Category: " + (categorySelect.value || "Not selected") : "",
					"Visibility: " + visibilitySelect.value
				];

				const audience = selectedAudience();

				if (audience === "year")
				{
					chips.push("Audience: " + (yearSelect.value || "Not selected"));
				}
				else if (audience === "program")
				{
					chips.push("Audience: " + (programInput.value.trim() || "Not selected"));
				}
				else
				{
					chips.push("Audience: All Students");
				}

				chips.push("Scheduled: " + (scheduleDate.value ? summarySchedule.textContent : "Not Yet"));
				chips.push("Attachments: " + attachments.length + " File(s)");

				chips.forEach(function(text)
				{
					if (!text)
					{
						return;
					}

					const chip = document.createElement("span");
					chip.className = "preview-chip";
					chip.textContent = text;
					previewMeta.appendChild(chip);
				});

				previewModal.hidden = false;
				document.getElementById("previewClose").focus();
			});

			document.getElementById("previewClose").addEventListener("click", closePreview);

			previewModal.addEventListener("click", function(event)
			{
				if (event.target === previewModal)
				{
					closePreview();
				}
			});

			document.addEventListener("keydown", function(event)
			{
				if (event.key === "Escape" && !previewModal.hidden)
				{
					closePreview();
				}
			});

			document.getElementById("publishBtn").addEventListener("click", function()
			{
				let firstInvalid = null;

				if (!titleInput.value.trim())
				{
					document.getElementById("titleField").classList.add("is-invalid");
					firstInvalid = firstInvalid || titleInput;
				}

				if (!categorySelect.value)
				{
					document.getElementById("categoryField").classList.add("is-invalid");
					firstInvalid = firstInvalid || categorySelect;
				}

				if (editorEmpty())
				{
					document.getElementById("contentField").classList.add("is-invalid");
					firstInvalid = firstInvalid || editor;
				}

				const audience = selectedAudience();

				if (audience === "year" && !yearSelect.value)
				{
					document.getElementById("audienceField").classList.add("is-invalid");
					firstInvalid = firstInvalid || yearSelect;
				}

				if (audience === "program" && !programInput.value.trim())
				{
					document.getElementById("audienceField").classList.add("is-invalid");
					firstInvalid = firstInvalid || programInput;
				}

				if (firstInvalid)
				{
					firstInvalid.focus();
					showToast("Please complete the required fields before publishing.");
					return;
				}

				saveAnnouncement("published").then(function(data)
				{
					if (data.status === "scheduled")
					{
						showToast("Announcement scheduled.");
					}
					else
					{
						showToast("Announcement published.");
					}

					window.location.href = "announcedetails.html?id=" + encodeURIComponent(data.id);
				}).catch(function(error)
				{
					showToast(error.message || "The announcement could not be published.");
				});
			});

			let editingId = 0;

			function reflectEditingId()
			{
				if (editingId > 0)
				{
					const target = "admin-createannounce.html?id=" + encodeURIComponent(editingId);

					if (window.location.search.indexOf("id=") === -1)
					{
						window.history.replaceState({}, "", target);
					}
				}
			}

			function audienceValue()
			{
				const audience = selectedAudience();

				if (audience === "year")
				{
					return yearSelect.value;
				}

				if (audience === "program")
				{
					return programInput.value.trim();
				}

				return "";
			}

			function scheduledValue()
			{
				if (!scheduleDate.value)
				{
					return "";
				}

				return scheduleDate.value + (scheduleTime.value ? "T" + scheduleTime.value : "");
			}

			function announcementSummary()
			{
				const plain = String(editor.innerText || "").replace(/\s+/g, " ").trim();

				return plain.length > 220 ? plain.slice(0, 217) + "..." : plain;
			}

			function readAttachmentPayload()
			{
				return Promise.all(attachments.map(function(file)
				{
					return new Promise(function(resolve)
					{
						const reader = new FileReader();

						reader.onload = function()
						{
							resolve(
							{
								name: file.name,
								mime: file.type || "application/octet-stream",
								data: reader.result
							});
						};

						reader.onerror = function()
						{
							resolve(null);
						};

						reader.readAsDataURL(file);
					});
				})).then(function(files)
				{
					return files.filter(Boolean);
				});
			}

			function saveAnnouncement(status)
			{
				const prepare = editingId > 0 ? Promise.resolve([]) : readAttachmentPayload();

				return prepare.then(function(files)
				{
					return EduAPI.post("/backend/api/announcements.php?action=save",
					{
						id: editingId,
						title: titleInput.value.trim(),
						category: categorySelect.value || "General",
						summary: announcementSummary(),
						content: editor.innerHTML,
						status: status,
						visibility: visibilitySelect.value,
						audience: selectedAudience(),
						audienceValue: audienceValue(),
						scheduledAt: scheduledValue(),
						attachments: files
					});
				});
			}

			function loadExistingAnnouncement(id)
			{
				return EduAPI.get("/backend/api/announcements.php?action=get&id=" + encodeURIComponent(id))
					.then(function(data)
					{
						const record = data.announcement;

						editingId = record.id;
						titleInput.value = record.title;

						if (record.category)
						{
							categorySelect.value = record.category;
						}

						editor.innerHTML = record.content || "";
						updateEditorState();

						if (record.visibility)
						{
							visibilitySelect.value = record.visibility;
						}

						const audienceRadio = document.querySelector("input[name=\"audience\"][value=\"" + (record.audience || "all") + "\"]");

						if (audienceRadio)
						{
							audienceRadio.checked = true;
						}

						if (record.audience === "year")
						{
							yearSelect.value = record.audienceValue || "";
						}
						else if (record.audience === "program")
						{
							programInput.value = record.audienceValue || "";
						}

						if (record.scheduledAt)
						{
							const stamp = String(record.scheduledAt).replace(" ", "T");

							scheduleDate.value = stamp.slice(0, 10);
							scheduleTime.value = stamp.slice(11, 16);
						}

						document.querySelector(".hero-content h1").innerHTML = "Edit <span>Announcement</span>";
						document.title = "Edit Announcement | EduBridge";

						updateSummary();
					})
					.catch(function(error)
					{
						showToast(error.message || "That announcement could not be loaded.");
					});
			}

			const initialId = new URLSearchParams(window.location.search).get("id");

			if (initialId)
			{
				loadExistingAnnouncement(initialId);
			}

			updateSummary();

			const hero = document.querySelector(".hero");
			const heroImage = document.querySelector(".hero-image");

			let targetX = 50;
			let targetY = 50;
			let cursorX = 50;
			let cursorY = 50;
			let purpleX = 4;
			let purpleY = 5;
			let blueX = 93;
			let blueY = 8;
			let pinkX = 15;
			let pinkY = 57;
			let violetX = 55;
			let violetY = 38;
			let orangeX = 94;
			let orangeY = 88;
			let cyanX = 5;
			let cyanY = 93;
			let pinkSmallX = 78;
			let pinkSmallY = 67;

			if (hero && heroImage)
			{
				hero.addEventListener("mousemove", function(event)
				{
					const rect = hero.getBoundingClientRect();

					targetX = ((event.clientX - rect.left) / rect.width) * 100;
					targetY = ((event.clientY - rect.top) / rect.height) * 100;

					const moveX = (event.clientX - rect.left) / rect.width - 0.5;
					const moveY = (event.clientY - rect.top) / rect.height - 0.5;

					heroImage.style.transform = "scale(1.04) translate(" + (moveX * -10) + "px, " + (moveY * -7) + "px)";
				});

				hero.addEventListener("mouseleave", function()
				{
					targetX = 50;
					targetY = 50;

					heroImage.style.transform = "scale(1.04) translate(0, 0)";
				});
			}

			function animateGradient()
			{
				if (hero)
				{
					cursorX += (targetX - cursorX) * 0.04;
					cursorY += (targetY - cursorY) * 0.04;

					const purpleTargetX = 4 + (cursorX - 50) * 0.35;
					const purpleTargetY = 5 + (cursorY - 50) * 0.25;
					const blueTargetX = 93 + (cursorX - 50) * 0.3;
					const blueTargetY = 8 + (cursorY - 50) * 0.25;
					const pinkTargetX = 15 + (cursorX - 50) * 0.5;
					const pinkTargetY = 57 + (cursorY - 50) * 0.45;
					const violetTargetX = 55 + (cursorX - 50) * 0.65;
					const violetTargetY = 38 + (cursorY - 50) * 0.55;
					const orangeTargetX = 94 + (cursorX - 50) * 0.3;
					const orangeTargetY = 88 + (cursorY - 50) * 0.35;
					const cyanTargetX = 5 + (cursorX - 50) * 0.28;
					const cyanTargetY = 93 + (cursorY - 50) * 0.25;
					const pinkSmallTargetX = 78 + (cursorX - 50) * 0.48;
					const pinkSmallTargetY = 67 + (cursorY - 50) * 0.42;

					purpleX += (purpleTargetX - purpleX) * 0.025;
					purpleY += (purpleTargetY - purpleY) * 0.025;
					blueX += (blueTargetX - blueX) * 0.02;
					blueY += (blueTargetY - blueY) * 0.02;
					pinkX += (pinkTargetX - pinkX) * 0.022;
					pinkY += (pinkTargetY - pinkY) * 0.022;
					violetX += (violetTargetX - violetX) * 0.018;
					violetY += (violetTargetY - violetY) * 0.018;
					orangeX += (orangeTargetX - orangeX) * 0.021;
					orangeY += (orangeTargetY - orangeY) * 0.021;
					cyanX += (cyanTargetX - cyanX) * 0.019;
					cyanY += (cyanTargetY - cyanY) * 0.019;
					pinkSmallX += (pinkSmallTargetX - pinkSmallX) * 0.023;
					pinkSmallY += (pinkSmallTargetY - pinkSmallY) * 0.023;

					hero.style.setProperty("--purple-x", purpleX + "%");
					hero.style.setProperty("--purple-y", purpleY + "%");
					hero.style.setProperty("--blue-x", blueX + "%");
					hero.style.setProperty("--blue-y", blueY + "%");
					hero.style.setProperty("--pink-x", pinkX + "%");
					hero.style.setProperty("--pink-y", pinkY + "%");
					hero.style.setProperty("--violet-x", violetX + "%");
					hero.style.setProperty("--violet-y", violetY + "%");
					hero.style.setProperty("--orange-x", orangeX + "%");
					hero.style.setProperty("--orange-y", orangeY + "%");
					hero.style.setProperty("--cyan-x", cyanX + "%");
					hero.style.setProperty("--cyan-y", cyanY + "%");
					hero.style.setProperty("--pink-small-x", pinkSmallX + "%");
					hero.style.setProperty("--pink-small-y", pinkSmallY + "%");
				}

				requestAnimationFrame(animateGradient);
			}

			animateGradient();

			let audioContext;

			function playClickSound()
			{
				try
				{
					if (!audioContext)
					{
						audioContext = new (window.AudioContext || window.webkitAudioContext)();
					}

					if (audioContext.state === "suspended")
					{
						audioContext.resume();
					}

					const oscillator = audioContext.createOscillator();
					const gain = audioContext.createGain();

					oscillator.type = "sine";
					oscillator.frequency.setValueAtTime(520, audioContext.currentTime);
					oscillator.frequency.exponentialRampToValueAtTime(300, audioContext.currentTime + 0.045);
					gain.gain.setValueAtTime(0.045, audioContext.currentTime);
					gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.06);

					oscillator.connect(gain);
					gain.connect(audioContext.destination);

					oscillator.start();
					oscillator.stop(audioContext.currentTime + 0.06);
				}
				catch (error)
				{
				}
			}

			document.addEventListener("click", function(event)
			{
				const clickable = event.target.closest("button, a");

				if (clickable)
				{
					playClickSound();
				}
			});

			const revealItems = document.querySelectorAll(".reveal");

			const revealObserver = new IntersectionObserver(function(entries)
			{
				entries.forEach(function(entry)
				{
					if (entry.isIntersecting)
					{
						entry.target.classList.add("visible");
						revealObserver.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.12
			});

			revealItems.forEach(function(item)
			{
				revealObserver.observe(item);
			});

			const cursorGradient = document.querySelector(".cursor-gradient");

			let cursorMouseX = window.innerWidth / 2;
			let cursorMouseY = window.innerHeight / 2;
			let gradientX = cursorMouseX;
			let gradientY = cursorMouseY;

			document.addEventListener("mousemove", function(event)
			{
				cursorMouseX = event.clientX;
				cursorMouseY = event.clientY;
				document.body.classList.add("cursor-ready");
			});

			function moveCursorGradient()
			{
				if (cursorGradient)
				{
					gradientX += (cursorMouseX - gradientX) * 0.12;
					gradientY += (cursorMouseY - gradientY) * 0.12;

					cursorGradient.style.left = gradientX + "px";
					cursorGradient.style.top = gradientY + "px";
				}

				requestAnimationFrame(moveCursorGradient);
			}

			moveCursorGradient();

			window.addEventListener("scroll", function()
			{
				if (window.scrollY > 450)
				{
					backToTop.classList.add("show");
				}
				else
				{
					backToTop.classList.remove("show");
				}
			});

			backToTop.addEventListener("click", function()
			{
				window.scrollTo({ top: 0, behavior: "smooth" });
			});

			try
			{
				const storedDefaults = JSON.parse(localStorage.getItem("edubridge-announce-defaults") || "null");

				if (storedDefaults)
				{
					const defaultsVisibility = document.getElementById("visibilitySelect");
					const defaultsYear = document.getElementById("yearSelect");
					const defaultsProgram = document.getElementById("programInput");
					const defaultsDate = document.getElementById("scheduleDate");
					const defaultsTime = document.getElementById("scheduleTime");

					if (storedDefaults.visibility === "Public" || storedDefaults.visibility === "Private")
					{
						defaultsVisibility.value = storedDefaults.visibility;
					}

					if (storedDefaults.audience === "year" || storedDefaults.audience === "program")
					{
						const defaultsRadio = document.querySelector("input[name=\"audience\"][value=\"" + storedDefaults.audience + "\"]");

						if (defaultsRadio)
						{
							defaultsRadio.checked = true;
						}
					}

					if (typeof storedDefaults.year === "string" && storedDefaults.year)
					{
						defaultsYear.value = storedDefaults.year;
					}

					if (typeof storedDefaults.program === "string" && storedDefaults.program)
					{
						defaultsProgram.value = storedDefaults.program;
					}

					if (storedDefaults.timing === "scheduled" && storedDefaults.date)
					{
						defaultsDate.value = storedDefaults.date;

						if (typeof storedDefaults.time === "string")
						{
							defaultsTime.value = storedDefaults.time;
						}
					}

					const defaultsChecked = document.querySelector("input[name=\"audience\"]:checked");

					if (defaultsChecked)
					{
						document.getElementById("yearField").hidden = defaultsChecked.value !== "year";
						document.getElementById("programField").hidden = defaultsChecked.value !== "program";
					}

					if (typeof updateSummary === "function")
					{
						updateSummary();
					}
				}
			}
			catch (error)
			{
			}
		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>

</body>
