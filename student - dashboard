		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
	</button>

	<script>
		try
		{
			document.body.classList.add("js");

			const reduceMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)"
			).matches;

			const themeButton = document.getElementById("themeButton");
			const themeIcon = document.getElementById("themeIcon");
			const navbar = document.querySelector(".navbar");
			const menuButton = document.getElementById("menuButton");
			const hero = document.querySelector(".hero");
			const heroImage = document.querySelector(".hero-image");
			const backToTop = document.getElementById("backToTop");

			function updateThemeIcon()
			{
				if (document.body.classList.contains("dark-mode"))
				{
					themeIcon.innerHTML = `
						<path d="M21 12.8A9 9 0 0 1 11.2 3 7 7 0 1 0 21 12.8z">
						</path>
					`;
				}
				else
				{
					themeIcon.innerHTML = `
						<path d="M12 3V1m0 22v-2M4.22 4.22 2.81 2.81m18.38 18.38-1.41-1.41M3 12H1m22 0h-2M4.22 19.78l-1.41 1.41M21.19 2.81l-1.41 1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z">
						</path>
					`;
				}
			}

			let savedTheme = null;

			try
			{
				savedTheme = localStorage.getItem("edubridge-theme");
			}
			catch (error)
			{
			}

			if (savedTheme === "dark")
			{
				document.body.classList.add("dark-mode");
			}

			updateThemeIcon();

			themeButton.addEventListener("click", function()
			{
				const rect = themeButton.getBoundingClientRect();

				document.body.style.setProperty(
					"--theme-x",
					rect.left + rect.width / 2 + "px"
				);
				document.body.style.setProperty(
					"--theme-y",
					rect.top + rect.height / 2 + "px"
				);

				const isCurrentlyDark = document.body.classList.contains("dark-mode");

				document.body.style.setProperty(
					"--theme-circle",
					isCurrentlyDark ? "#f3f3f3" : "#090817"
				);
				document.body.classList.add("theme-changing");

				setTimeout(function()
				{
					document.body.classList.toggle("dark-mode");

					const isDark = document.body.classList.contains("dark-mode");

					try
					{
						localStorage.setItem("edubridge-theme", isDark ? "dark" : "light");
					}
					catch (error)
					{
					}

					updateThemeIcon();
				}, 100);

				setTimeout(function()
				{
					document.body.classList.remove("theme-changing");
				}, 750);
			});

			menuButton.addEventListener("click", function()
			{
				const isOpen = navbar.classList.toggle("menu-open");

				menuButton.setAttribute("aria-expanded", String(isOpen));
				menuButton.setAttribute(
					"aria-label",
					isOpen ? "Close navigation menu" : "Open navigation menu"
				);
			});

			function closeMenu()
			{
				navbar.classList.remove("menu-open");
				menuButton.setAttribute("aria-expanded", "false");
				menuButton.setAttribute("aria-label", "Open navigation menu");
			}

			document.querySelectorAll(".nav-links a").forEach(function(link)
			{
				link.addEventListener("click", closeMenu);
			});

			document.addEventListener("keydown", function(event)
			{
				if (event.key === "Escape")
				{
					closeMenu();
				}
			});

			document.addEventListener("click", function(event)
			{
				if (!navbar.contains(event.target))
				{
					closeMenu();
				}
			});

			function updateScrollState()
			{
				if (window.scrollY > 40)
				{
					navbar.classList.add("scrolled");
				}
				else
				{
					navbar.classList.remove("scrolled");
				}

				if (backToTop)
				{
					if (window.scrollY > 450)
					{
						backToTop.classList.add("show");
					}
					else
					{
						backToTop.classList.remove("show");
					}
				}
			}

			updateScrollState();
			window.addEventListener("scroll", updateScrollState, { passive: true });

			if (backToTop)
			{
				backToTop.addEventListener("click", function()
				{
					window.scrollTo({
						top: 0,
						behavior: reduceMotion ? "auto" : "smooth"
					});
				});
			}

			const revealItems = document.querySelectorAll(".reveal");

			if ("IntersectionObserver" in window && !reduceMotion)
			{
				const revealObserver = new IntersectionObserver(
					function(entries)
					{
						entries.forEach(function(entry)
						{
							if (entry.isIntersecting)
							{
								const delay = parseInt(
									entry.target.getAttribute("data-reveal-delay") || "0",
									10
								);

								setTimeout(function()
								{
									entry.target.classList.add("visible");
								}, delay);

								revealObserver.unobserve(entry.target);
							}
						});
					},
					{
						threshold: 0.12
					}
				);

				revealItems.forEach(function(item)
				{
					revealObserver.observe(item);
				});
			}
			else
			{
				revealItems.forEach(function(item)
				{
					item.classList.add("visible");
				});
			}

			const statItems = document.querySelectorAll("[data-count-to]");

			function animateStat(element)
			{
				const target = parseInt(element.getAttribute("data-count-to"), 10);
				const suffix = element.getAttribute("data-suffix") || "";

				if (reduceMotion)
				{
					element.textContent = target.toLocaleString() + suffix;
					return;
				}

				let startTime = null;
				const duration = 1600;

				function step(timestamp)
				{
					if (!startTime)
					{
						startTime = timestamp;
					}

					const progress = Math.min((timestamp - startTime) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);

					element.textContent =
						Math.round(target * eased).toLocaleString() + suffix;

					if (progress < 1)
					{
						requestAnimationFrame(step);
					}
				}

				requestAnimationFrame(step);
			}

			if (statItems.length)
			{
				if ("IntersectionObserver" in window)
				{
					const statObserver = new IntersectionObserver(
						function(entries)
						{
							entries.forEach(function(entry)
							{
								if (entry.isIntersecting)
								{
									animateStat(entry.target);
									statObserver.unobserve(entry.target);
								}
							});
						},
						{
							threshold: 0.4
						}
					);

					statItems.forEach(function(item)
					{
						statObserver.observe(item);
					});
				}
				else
				{
					statItems.forEach(animateStat);
				}
			}

			if (hero && heroImage && !reduceMotion)
			{
				let targetX = 50;
				let targetY = 50;
				let cursorX = 50;
				let cursorY = 50;
				let purpleX = 4;
				let purpleY = 5;
				let blueX = 93;
				let blueY = 8;
				let pinkX = 15;
				let pinkY = 57;
				let violetX = 55;
				let violetY = 38;
				let orangeX = 94;
				let orangeY = 88;
				let cyanX = 5;
				let cyanY = 93;
				let pinkSmallX = 78;
				let pinkSmallY = 67;

				hero.addEventListener("mousemove", function(event)
				{
					const rect = hero.getBoundingClientRect();

					targetX = ((event.clientX - rect.left) / rect.width) * 100;
					targetY = ((event.clientY - rect.top) / rect.height) * 100;

					const moveX = (event.clientX - rect.left) / rect.width - 0.5;
					const moveY = (event.clientY - rect.top) / rect.height - 0.5;

					heroImage.style.transform =
						`scale(1.04) translate(${moveX * -10}px, ${moveY * -7}px)`;
				});

				hero.addEventListener("mouseleave", function()
				{
					targetX = 50;
					targetY = 50;
					heroImage.style.transform = "scale(1.04) translate(0, 0)";
				});

				function animateGradient()
				{
					cursorX += (targetX - cursorX) * 0.04;
					cursorY += (targetY - cursorY) * 0.04;

					const purpleTargetX = 4 + (cursorX - 50) * 0.35;
					const purpleTargetY = 5 + (cursorY - 50) * 0.25;
					const blueTargetX = 93 + (cursorX - 50) * 0.3;
					const blueTargetY = 8 + (cursorY - 50) * 0.25;
					const pinkTargetX = 15 + (cursorX - 50) * 0.5;
					const pinkTargetY = 57 + (cursorY - 50) * 0.45;
					const violetTargetX = 55 + (cursorX - 50) * 0.65;
					const violetTargetY = 38 + (cursorY - 50) * 0.55;
					const orangeTargetX = 94 + (cursorX - 50) * 0.3;
					const orangeTargetY = 88 + (cursorY - 50) * 0.35;
					const cyanTargetX = 5 + (cursorX - 50) * 0.28;
					const cyanTargetY = 93 + (cursorY - 50) * 0.25;
					const pinkSmallTargetX = 78 + (cursorX - 50) * 0.48;
					const pinkSmallTargetY = 67 + (cursorY - 50) * 0.42;

					purpleX += (purpleTargetX - purpleX) * 0.025;
					purpleY += (purpleTargetY - purpleY) * 0.025;
					blueX += (blueTargetX - blueX) * 0.02;
					blueY += (blueTargetY - blueY) * 0.02;
					pinkX += (pinkTargetX - pinkX) * 0.022;
					pinkY += (pinkTargetY - pinkY) * 0.022;
					violetX += (violetTargetX - violetX) * 0.018;
					violetY += (violetTargetY - violetY) * 0.018;
					orangeX += (orangeTargetX - orangeX) * 0.021;
					orangeY += (orangeTargetY - orangeY) * 0.021;
					cyanX += (cyanTargetX - cyanX) * 0.019;
					cyanY += (cyanTargetY - cyanY) * 0.019;
					pinkSmallX += (pinkSmallTargetX - pinkSmallX) * 0.023;
					pinkSmallY += (pinkSmallTargetY - pinkSmallY) * 0.023;

					hero.style.setProperty("--purple-x", purpleX + "%");
					hero.style.setProperty("--purple-y", purpleY + "%");
					hero.style.setProperty("--blue-x", blueX + "%");
					hero.style.setProperty("--blue-y", blueY + "%");
					hero.style.setProperty("--pink-x", pinkX + "%");
					hero.style.setProperty("--pink-y", pinkY + "%");
					hero.style.setProperty("--violet-x", violetX + "%");
					hero.style.setProperty("--violet-y", violetY + "%");
					hero.style.setProperty("--orange-x", orangeX + "%");
					hero.style.setProperty("--orange-y", orangeY + "%");
					hero.style.setProperty("--cyan-x", cyanX + "%");
					hero.style.setProperty("--cyan-y", cyanY + "%");
					hero.style.setProperty("--pink-small-x", pinkSmallX + "%");
					hero.style.setProperty("--pink-small-y", pinkSmallY + "%");

					requestAnimationFrame(animateGradient);
				}

				animateGradient();
			}

			const cursorGradient = document.querySelector(".cursor-gradient");

			if (cursorGradient && !reduceMotion)
			{
				let cursorMouseX = window.innerWidth / 2;
				let cursorMouseY = window.innerHeight / 2;
				let gradientX = cursorMouseX;
				let gradientY = cursorMouseY;

				document.addEventListener("mousemove", function(event)
				{
					cursorMouseX = event.clientX;
					cursorMouseY = event.clientY;
					document.body.classList.add("cursor-ready");
				}, { passive: true });

				function moveCursorGradient()
				{
					gradientX += (cursorMouseX - gradientX) * 0.12;
					gradientY += (cursorMouseY - gradientY) * 0.12;
					cursorGradient.style.left = gradientX + "px";
					cursorGradient.style.top = gradientY + "px";
					requestAnimationFrame(moveCursorGradient);
				}

				moveCursorGradient();
			}
			else if (cursorGradient)
			{
				cursorGradient.style.display = "none";
			}

			let audioContext;

			function playClickSound()
			{
				try
				{
					if (!audioContext)
					{
						audioContext = new (
							window.AudioContext ||
							window.webkitAudioContext
						)();
					}

					if (audioContext.state === "suspended")
					{
						audioContext.resume();
					}

					const oscillator = audioContext.createOscillator();
					const gain = audioContext.createGain();

					oscillator.type = "sine";
					oscillator.frequency.setValueAtTime(520, audioContext.currentTime);
					oscillator.frequency.exponentialRampToValueAtTime(
						300,
						audioContext.currentTime + 0.045
					);
					gain.gain.setValueAtTime(0.045, audioContext.currentTime);
					gain.gain.exponentialRampToValueAtTime(
						0.001,
						audioContext.currentTime + 0.06
					);

					oscillator.connect(gain);
					gain.connect(audioContext.destination);
					oscillator.start();
					oscillator.stop(audioContext.currentTime + 0.06);
				}
				catch (error)
				{
				}
			}

			if (!reduceMotion)
			{
				document.addEventListener("click", function(event)
				{
					const clickable = event.target.closest("button, a, summary");

					if (clickable)
					{
						playClickSound();
					}
				});
			}
		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>
<script>
(function () {
	const trigger = document.getElementById("profileMenuButton");
	const menu = document.getElementById("profileMenu");
	const logout = document.getElementById("logoutButton");
	if (!trigger || !menu) return;
	const nameLabel = trigger.querySelector('.profile-label');
	try { const savedProfile = JSON.parse(localStorage.getItem('edubridge-profile') || '{}'); const savedName = typeof savedProfile.fullName === 'string' ? savedProfile.fullName.trim() : ''; if (savedName && nameLabel) nameLabel.textContent = savedName; } catch (_) {}
	function closeMenu() { menu.hidden = true; trigger.setAttribute("aria-expanded", "false"); trigger.setAttribute("aria-label", "Open account menu"); }
	trigger.addEventListener("click", function () {
		const open = menu.hidden;
		menu.hidden = !open;
		trigger.setAttribute("aria-expanded", String(open) );
		trigger.setAttribute("aria-label", open ? "Close account menu" : "Open account menu");
	});
	document.addEventListener("click", function (event) {
		if (!event.target.closest(".profile-menu-wrap")) closeMenu();
	});
	document.addEventListener("keydown", function (event) {
		if (event.key === "Escape") { closeMenu(); trigger.focus(); }
	});
	if (logout) logout.addEventListener("click", function () {
		if (!window.confirm("Are you sure you want to log out?")) return;
		sessionStorage.removeItem("edubridge-session");
		sessionStorage.removeItem("edubridge-auth");
		localStorage.removeItem("edubridge-session");
		localStorage.removeItem("edubridge-auth");
		window.location.href = "about.html";
	});
})();
</script>
