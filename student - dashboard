		/* ------------------------------------------------------------------
		   BACK TO TOP + REVEAL
		------------------------------------------------------------------ */

		.back-to-top
		{
			position: fixed;
			z-index: 999;
			right: 24px;
			bottom: 24px;
			display: flex;
			width: 38px;
			height: 38px;
			align-items: center;
			justify-content: center;
			border: 0;
			border-radius: 6px;
			background: var(--purple);
			color: white;
			opacity: 0;
			visibility: hidden;
			transform: translateY(15px);
			transition: 0.3s ease;
			box-shadow: 0 8px 20px rgba(113, 56, 200, 0.25);
		}

		.back-to-top.show
		{
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.back-to-top:hover
		{
			transform: translateY(-3px);
			background: #8c50df;
		}

		.back-to-top svg
		{
			width: 17px;
			height: 17px;
			fill: currentColor;
		}

		.reveal
		{
			opacity: 1;
			transform: translateY(0);
		}

		body.js .reveal
		{
			opacity: 0;
			transform: translateY(28px);
			transition: opacity 0.7s ease, transform 0.7s ease;
		}

		body.js .reveal.visible
		{
			opacity: 1;
			transform: translateY(0);
		}

		/* ------------------------------------------------------------------
		   KEYFRAMES
		------------------------------------------------------------------ */

		@keyframes purpleFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(-20px, -15px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(45px, 35px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(10px, 70px);
			}
		}

		@keyframes blueFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(20px, 20px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(-55px, 35px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(-15px, -30px);
			}
		}

		@keyframes pinkFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(15px, -20px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(-40px, 35px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(35px, 55px);
			}
		}

		@keyframes violetFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(-25px, 20px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(55px, -35px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(-40px, 45px);
			}
		}

		@keyframes orangeFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(-20px, -25px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(45px, -55px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(-35px, 35px);
			}
		}

		@keyframes cyanFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(25px, 20px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(-45px, -30px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(35px, -55px);
			}
		}

		@keyframes smallPinkFloat
		{
			0%
			{
				transform: translate(-50%, -50%) translate(-15px, 20px);
			}

			50%
			{
				transform: translate(-50%, -50%) translate(35px, -35px);
			}

			100%
			{
				transform: translate(-50%, -50%) translate(-30px, 45px);
			}
		}

		@keyframes helpFloat
		{
			0%,
			100%
			{
				transform: translateY(0);
			}

			50%
			{
				transform: translateY(-8px);
			}
		}

		@keyframes orbitSpin
		{
			0%
			{
				transform: rotate(0deg);
			}

			100%
			{
				transform: rotate(360deg);
			}
		}

