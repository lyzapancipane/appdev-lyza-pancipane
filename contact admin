<!DOCTYPE html>
<head>
    <title>Contact Your School Administrator | EduBridge</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        *
        {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root
        {
            --background: #f3f3f3;
            --surface: #ffffff;
            --surface-soft: #faf9fc;
            --text: #17152d;
            --text-soft: #696774;
            --text-muted: #77737e;
            --border: #e1e1e1;
            --purple: #7138c8;
            --purple-light: #eee5ff;
            --purple-soft: #eadcff;
            --green: #1f9d63;
            --green-soft: #e7f6ee;
            --red: #d64550;
            --red-soft: #fdeced;
            --shadow: rgba(40, 24, 75, 0.08);
        }

        body.dark-mode
        {
            --background: #090817;
            --surface: #131124;
            --surface-soft: #18162b;
            --text: #f7f3ff;
            --text-soft: #c4bfd2;
            --text-muted: #9e99ae;
            --border: #2d2941;
            --purple: #a970ff;
            --purple-light: #251b3b;
            --purple-soft: #241934;
            --green: #4cd08d;
            --green-soft: #16301f;
            --red: #ff7b85;
            --red-soft: #331a1e;
            --shadow: rgba(0, 0, 0, 0.35);
        }

        html
        {
            scroll-behavior: smooth;
        }

        body
        {
            font-family: Poppins, Arial, sans-serif;
            color: var(--text);
            background: var(--background);
            overflow-x: hidden;
            transition: background 0.45s ease, color 0.45s ease;
        }

        body.dark-mode
        {
            background:
                radial-gradient(
                    circle at 12% 10%,
                    rgba(113, 56, 200, 0.12),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 88% 45%,
                    rgba(68, 72, 190, 0.08),
                    transparent 30%
                ),
                #090817;
        }

        a
        {
            color: inherit;
            text-decoration: none;
        }

        button
        {
            font-family: inherit;
            cursor: pointer;
        }

        body [hidden]
        {
            display: none;
        }

        body.theme-changing::before
        {
            content: "";
            position: fixed;
            width: 30px;
            height: 30px;
            left: var(--theme-x);
            top: var(--theme-y);
            transform: translate(-50%, -50%) scale(0);
            border-radius: 50%;
            background: var(--theme-circle);
            z-index: 9999;
            pointer-events: none;
            animation: themeReveal 0.65s ease-out forwards;
        }

        @keyframes themeReveal
        {
            0%
            {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0.35;
            }

            100%
            {
                transform: translate(-50%, -50%) scale(100);
                opacity: 0;
            }
        }

        .cursor-gradient
        {
            position: fixed;
            width: 500px;
            height: 500px;
            left: 0;
            top: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9998;
            opacity: 0;
            background:
                radial-gradient(
                    circle,
                    rgba(185, 120, 255, 0.16) 0%,
                    rgba(86, 105, 255, 0.10) 28%,
                    rgba(225, 80, 160, 0.06) 48%,
                    transparent 72%
                );
            filter: blur(32px);
            transition: opacity 0.35s ease;
        }

        body.cursor-ready .cursor-gradient
        {
            opacity: 1;
        }

        body.dark-mode .cursor-gradient
        {
            background:
                radial-gradient(
                    circle,
                    rgba(174, 112, 255, 0.23) 0%,
                    rgba(88, 103, 255, 0.14) 30%,
                    rgba(228, 78, 173, 0.08) 50%,
                    transparent 73%
                );
        }

        .theme-button
        {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 100;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff30;
            border-radius: 5px;
            background: #7138c8;
            color: white;
            box-shadow: 0 8px 25px rgba(55, 25, 100, 0.3);
            transition: 0.25s ease;
        }

        .theme-button:hover
        {
            background: #8c50df;
            border-color: #a970ff;
            transform: translateY(-2px) rotate(8deg);
        }

        .theme-button:active
        {
            transform: scale(0.88);
        }

        .theme-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .hero
        {
            min-height: 470px;
            padding: 90px 36px 70px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background: #08051d;
        }

        .hero-image
        {
            position: absolute;
            inset: 0;
            z-index: -10;
            background-image: url("Edubridge-Hero-About.png");
            background-size: cover;
            background-position: center;
            opacity: 0.62;
            transform: scale(1.04);
            transition: transform 0.25s ease-out;
        }

        .hero-base
        {
            position: absolute;
            inset: 0;
            z-index: -9;
            background:
                linear-gradient(
                    135deg,
                    rgba(5, 5, 35, 0.7),
                    rgba(14, 4, 40, 0.32),
                    rgba(5, 5, 30, 0.65)
                );
        }

        .gradient-layer
        {
            position: absolute;
            inset: 0;
            z-index: -8;
            overflow: hidden;
            pointer-events: none;
        }

        .gradient
        {
            position: absolute;
            border-radius: 50%;
            filter: blur(65px);
            mix-blend-mode: screen;
            opacity: 0.72;
        }

        .gradient-purple
        {
            width: 430px;
            height: 430px;
            background: #7138c8;
            left: var(--purple-x, 4%);
            top: var(--purple-y, 5%);
            animation: purpleFloat 12s ease-in-out infinite alternate;
        }

        .gradient-blue
        {
            width: 390px;
            height: 390px;
            background: #315ee8;
            left: var(--blue-x, 93%);
            top: var(--blue-y, 8%);
            animation: blueFloat 14s ease-in-out infinite alternate;
        }

        .gradient-pink
        {
            width: 360px;
            height: 360px;
            background: #d94f91;
            left: var(--pink-x, 15%);
            top: var(--pink-y, 57%);
            animation: pinkFloat 13s ease-in-out infinite alternate;
        }

        .gradient-violet
        {
            width: 430px;
            height: 430px;
            background: #933cff;
            left: var(--violet-x, 55%);
            top: var(--violet-y, 38%);
            animation: violetFloat 15s ease-in-out infinite alternate;
        }

        .gradient-orange
        {
            width: 400px;
            height: 400px;
            background: #e69a42;
            left: var(--orange-x, 94%);
            top: var(--orange-y, 88%);
            animation: orangeFloat 11s ease-in-out infinite alternate;
        }

        .gradient-cyan
        {
            width: 340px;
            height: 340px;
            background: #387ee8;
            left: var(--cyan-x, 5%);
            top: var(--cyan-y, 93%);
            animation: cyanFloat 16s ease-in-out infinite alternate;
        }

        .gradient-pink-small
        {
            width: 270px;
            height: 270px;
            background: #b73fbd;
            left: var(--pink-small-x, 78%);
            top: var(--pink-small-y, 67%);
            animation: smallPinkFloat 12s ease-in-out infinite alternate;
        }

        .hero-overlay
        {
            position: absolute;
            inset: 0;
            z-index: -6;
            pointer-events: none;
            background:
                linear-gradient(
                    90deg,
                    rgba(5, 5, 35, 0.58),
                    rgba(10, 5, 35, 0.12),
                    rgba(5, 5, 35, 0.52)
                );
        }

        .hero-content
        {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            position: relative;
            z-index: 5;
        }

        .hero-label
        {
            color: #c18cff;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .hero h1
        {
            color: white;
            font-size: 52px;
            line-height: 1.1;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .hero h1 span
        {
            color: #b77aff;
        }

        .hero p
        {
            max-width: 650px;
            color: #d5d1df;
            font-size: 15px;
            line-height: 1.8;
        }

        .contact-section
        {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 45px 0 55px;
        }

        .contact-top
        {
            display: grid;
            grid-template-columns: 1.5fr 0.8fr;
            gap: 18px;
        }

        .contact-card
        {
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface);
            box-shadow: 0 5px 20px var(--shadow);
            transition: 0.3s ease;
        }

        .contact-card:hover
        {
            transform: translateY(-5px);
            border-color: #a970ff;
            box-shadow:
                0 15px 35px var(--shadow),
                0 0 22px rgba(113, 56, 200, 0.08);
        }

        .contact-form-card
        {
            padding: 25px;
        }

        .contact-form-card h2
        {
            color: var(--text);
            font-size: 21px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .contact-form-card > p
        {
            color: var(--text-soft);
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 22px;
        }

        .form-row
        {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .form-group
        {
            margin-bottom: 15px;
        }

        .form-group label
        {
            display: block;
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-group input,
        .form-group textarea,
        .form-group select
        {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: var(--surface-soft);
            color: var(--text);
            font-family: inherit;
            font-size: 12px;
            outline: none;
            transition: 0.2s ease;
        }

        .form-group input
        {
            height: 40px;
            padding: 0 12px;
        }

        .form-group textarea
        {
            min-height: 125px;
            padding: 11px 12px;
            resize: vertical;
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder
        {
            color: var(--text-muted);
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus
        {
            border-color: var(--purple);
            box-shadow: 0 0 0 3px var(--purple-light);
        }

        .form-group input.is-invalid,
        .form-group textarea.is-invalid,
        .form-group select.is-invalid
        {
            border-color: var(--red);
            box-shadow: 0 0 0 3px var(--red-soft);
        }

        .field-error
        {
            margin: 5px 0 0;
            color: var(--red);
            font-size: 11px;
            line-height: 1.4;
        }

        .field-error:empty
        {
            display: none;
        }

        .select-shell
        {
            position: relative;
        }

        .select-shell select
        {
            height: 40px;
            padding: 0 34px 0 12px;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
        }

        .select-chevron
        {
            position: absolute;
            top: 50%;
            right: 12px;
            width: 13px;
            height: 13px;
            fill: var(--text-muted);
            pointer-events: none;
            transform: translateY(-50%);
        }

        .form-note
        {
            margin: 0 0 15px;
            padding: 11px 13px;
            border-left: 3px solid var(--purple);
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--text-soft);
            font-size: 11.5px;
            line-height: 1.6;
        }

        .send-button
        {
            width: 100%;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            border-radius: 5px;
            background: #7138c8;
            color: white;
            font-size: 11.5px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .send-button:hover
        {
            background: #5f2fb0;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(113, 56, 200, 0.22);
        }

        .send-button:active
        {
            transform: scale(0.97);
        }

        .send-button svg
        {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .form-disclaimer
        {
            margin: 11px 0 0;
            color: var(--text-muted);
            font-size: 11px;
            line-height: 1.6;
            text-align: center;
        }

        .access-card
        {
            padding: 25px;
            align-self: start;
        }

        .access-icon
        {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            border-radius: 5px;
            background: var(--purple-light);
            color: var(--purple);
            font-size: 20px;
            font-weight: 600;
        }

        .access-card h3
        {
            color: var(--purple);
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .access-list
        {
            padding-left: 18px;
            color: var(--text-soft);
            font-size: 13px;
            line-height: 1.9;
            margin-bottom: 14px;
        }

        .access-note
        {
            color: var(--text-muted);
            font-size: 11px;
            line-height: 1.7;
            margin-bottom: 16px;
        }

        .access-link
        {
            display: inline-flex;
            height: 32px;
            align-items: center;
            justify-content: center;
            padding: 0 14px;
            border-radius: 5px;
            background: #7138c8;
            color: white;
            font-size: 10.5px;
            font-weight: 600;
            transition: 0.2s ease;
        }

        .access-link:hover
        {
            background: #8c50df;
            transform: translateY(-1px);
        }

        .access-link:active
        {
            transform: scale(0.95);
        }

        .send-button:focus-visible,
        .access-link:focus-visible,
        .theme-button:focus-visible,
        .toast-close:focus-visible
        {
            outline: 2px solid var(--purple);
            outline-offset: 2px;
        }

        .toast-container
        {
            position: fixed;
            top: 96px;
            right: 24px;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: min(340px, calc(100vw - 48px));
            pointer-events: none;
        }

        .toast
        {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-left: 3px solid var(--purple);
            border-radius: 6px;
            background: var(--surface);
            box-shadow: 0 10px 28px var(--shadow);
            opacity: 0;
            pointer-events: auto;
            transform: translateX(24px);
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        .toast--visible
        {
            opacity: 1;
            transform: translateX(0);
        }

        .toast--leaving
        {
            opacity: 0;
            transform: translateX(24px);
        }

        .toast--success
        {
            border-left-color: var(--green);
        }

        .toast--error
        {
            border-left-color: var(--red);
        }

        .toast--info
        {
            border-left-color: var(--purple);
        }

        .toast-icon
        {
            display: flex;
            width: 26px;
            height: 26px;
            min-width: 26px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--purple-light);
            color: var(--purple);
        }

        .toast--success .toast-icon
        {
            background: var(--green-soft);
            color: var(--green);
        }

        .toast--error .toast-icon
        {
            background: var(--red-soft);
            color: var(--red);
        }

        .toast-icon svg
        {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .toast-body
        {
            flex: 1;
            min-width: 0;
        }

        .toast-message
        {
            margin: 2px 0 0;
            color: var(--text);
            font-size: 12px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .toast-close
        {
            display: inline-flex;
            width: 20px;
            height: 20px;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 4px;
            background: transparent;
            color: var(--text-muted);
            transition: 0.2s ease;
        }

        .toast-close:hover
        {
            background: var(--surface-soft);
            color: var(--text);
        }

        .toast-close svg
        {
            width: 10px;
            height: 10px;
            fill: currentColor;
        }

        .back-to-top
        {
            position: fixed;
            right: 28px;
            bottom: 28px;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ffffff30;
            border-radius: 6px;
            background: #7138c8;
            color: white;
            z-index: 100;
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px);
            transition: 0.3s ease;
            box-shadow: 0 8px 25px rgba(55, 25, 100, 0.3);
        }

        .back-to-top.show
        {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .back-to-top:hover
        {
            background: #8c50df;
            transform: translateY(-3px);
        }

        .back-to-top:active
        {
            transform: scale(0.9);
        }

        .back-to-top svg
        {
            width: 17px;
            height: 17px;
            fill: currentColor;
        }

        .reveal
        {
            opacity: 1;
            transform: translateY(0);
        }

        body.js .reveal
        {
            opacity: 0;
            transform: translateY(28px);
            transition:
                opacity 0.7s ease,
                transform 0.7s ease;
        }

        body.js .reveal.visible
        {
            opacity: 1;
            transform: translateY(0);
        }

        @keyframes purpleFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-20px, -15px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(45px, 35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(10px, 70px);
            }
        }

        @keyframes blueFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(20px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(-55px, 35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-15px, -30px);
            }
        }

        @keyframes pinkFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(15px, -20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(-40px, 35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(35px, 55px);
            }
        }

        @keyframes violetFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-25px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(55px, -35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-40px, 45px);
            }
        }

        @keyframes orangeFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-20px, -25px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(45px, -55px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-35px, 35px);
            }
        }

        @keyframes cyanFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(25px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(-45px, -30px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(35px, -55px);
            }
        }

        @keyframes smallPinkFloat
        {
            0%
            {
                transform: translate(-50%, -50%) translate(-15px, 20px);
            }

            50%
            {
                transform: translate(-50%, -50%) translate(35px, -35px);
            }

            100%
            {
                transform: translate(-50%, -50%) translate(-30px, 45px);
            }
        }

        @media (max-width: 1200px)
        {
            .contact-section
            {
                width: calc(100% - 60px);
            }
        }

        @media (max-width: 900px)
        {
            .contact-top
            {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px)
        {
            .hero
            {
                padding: 90px 25px 55px;
            }

            .hero h1
            {
                font-size: 38px;
            }

            .hero p
            {
                font-size: 13px;
            }

            .gradient
            {
                filter: blur(50px);
            }

            .gradient-purple
            {
                width: 330px;
                height: 330px;
            }

            .gradient-blue
            {
                width: 300px;
                height: 300px;
            }

            .gradient-pink
            {
                width: 280px;
                height: 280px;
            }

            .gradient-violet
            {
                width: 330px;
                height: 330px;
            }

            .gradient-orange
            {
                width: 300px;
                height: 300px;
            }

            .gradient-cyan
            {
                width: 260px;
                height: 260px;
            }

            .gradient-pink-small
            {
                width: 220px;
                height: 220px;
            }

            .contact-section
            {
                width: calc(100% - 30px);
            }

            .form-row
            {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .contact-form-card,
            .access-card
            {
                padding: 20px;
            }

            .back-to-top
            {
                right: 18px;
                bottom: 18px;
            }

            .cursor-gradient
            {
                width: 300px;
                height: 300px;
                filter: blur(24px);
            }

            .toast-container
            {
                top: 84px;
                right: 16px;
                left: 16px;
                width: auto;
            }
        }

        @media (prefers-reduced-motion: reduce)
        {
            html
            {
                scroll-behavior: auto;
            }

            .gradient
            {
                animation: none;
            }

            .reveal,
            .contact-card,
            .hero-image,
            .toast
            {
                transition: none;
            }
        }
    </style>
</head>

<body>

    <div class="cursor-gradient">
    </div>

    <button class="theme-button" id="themeButton" type="button" aria-label="Toggle theme">

        <svg id="themeIcon" viewBox="0 0 24 24" aria-hidden="true">

            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z">
            </path>
        </svg>
    </button>

    <section class="hero">

        <div class="hero-image">
        </div>

        <div class="hero-base">
        </div>

        <div class="gradient-layer">

            <div class="gradient gradient-purple">
            </div>

            <div class="gradient gradient-blue">
            </div>

            <div class="gradient gradient-pink">
            </div>

            <div class="gradient gradient-violet">
            </div>

            <div class="gradient gradient-orange">
            </div>

            <div class="gradient gradient-cyan">
            </div>

            <div class="gradient gradient-pink-small">
            </div>
        </div>

        <div class="hero-overlay">
        </div>

        <div class="hero-content">

            <div class="hero-label">
                ACCOUNT ACCESS
            </div>

            <h1>
                Contact Your School<br>
                <span>Administrator</span>
            </h1>

            <p>
                Need an EduBridge account or help accessing your account?
                Send your request below so your school administrator can
                assist you.
            </p>
        </div>
    </section>


    <main class="contact-section reveal">

        <div class="contact-top">

            <div class="contact-card contact-form-card">

                <h2>
                    Send Your Request
                </h2>

                <p>
                    Choose a request type and provide your details below.
                    All fields marked here are required unless the field
                    is hidden for the selected request type.
                </p>

                <form id="adminRequestForm" novalidate>

                    <div class="form-row">

                        <div class="form-group">

                            <label for="fullName">
                                Full Name
                            </label>

                            <input type="text" id="fullName" placeholder="Enter your full name" autocomplete="name" aria-describedby="fullNameError" required>

                            <p class="field-error" id="fullNameError"></p>
                        </div>

                        <div class="form-group">

                            <label for="contactEmail">
                                Contact Email
                            </label>

                            <input type="email" id="contactEmail" placeholder="Enter your email address" autocomplete="email" aria-describedby="contactEmailError" required>

                            <p class="field-error" id="contactEmailError"></p>
