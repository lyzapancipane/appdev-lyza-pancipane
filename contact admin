                    </div>

                    <div class="form-group" id="studentIdGroup" hidden>

                        <label for="studentId">
                            Student ID
                        </label>

                        <input type="text" id="studentId" placeholder="Enter Student ID" autocomplete="off" aria-describedby="studentIdError" required>

                        <p class="field-error" id="studentIdError"></p>
                    </div>

                    <div class="form-group" id="roleGroup" hidden>

                        <label for="roleSelect">
                            Role or User Category
                        </label>

                        <div class="select-shell">

                            <select id="roleSelect" aria-describedby="roleError" required>

                                <option value="" selected disabled>
                                    Select a role
                                </option>

                                <option value="student">
                                    Student
                                </option>

                                <option value="teacher">
                                    Teacher
                                </option>

                                <option value="admin">
                                    Admin
                                </option>
                            </select>

                            <svg class="select-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 10l5 5 5-5z">
                                </path>
                            </svg>
                        </div>

                        <p class="field-error" id="roleError"></p>
                    </div>

                    <div class="form-group">

                        <label for="typeSelect">
                            Request Type
                        </label>

                        <div class="select-shell">

                            <select id="typeSelect">

                                <option value="account">
                                    Account Request
                                </option>

                                <option value="password">
                                    Password Assistance
                                </option>

                                <option value="general" selected>
                                    General Inquiry
                                </option>
                            </select>

                            <svg class="select-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 10l5 5 5-5z">
                                </path>
                            </svg>
                        </div>
                    </div>

                    <p class="form-note" id="requestNote" hidden></p>

                    <div class="form-group">

                        <label for="message" id="messageLabel">
                            Message
                        </label>

                        <textarea id="message" placeholder="Write your message here..." aria-describedby="messageError" required></textarea>

                        <p class="field-error" id="messageError"></p>
                    </div>

                    <button type="submit" class="send-button">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 3.8 22 12 2.5 20.2 5.2 13 15 12 5.2 11 2.5 3.8z">
                            </path>
                        </svg>

                        Submit Request
                    </button>

                </form>
            </div>

            <aside class="contact-card access-card">

                <div class="access-icon">
                    ✦
                </div>

                <h3>
                    Account &amp; Password Requests
                </h3>

                <ul class="access-list">

                    <li>
                        Accounts are created by an authorized administrator.
                    </li>

                    <li>
                        Password requests are handled by authorized administrators.
                    </li>

                    <li>
                        Public self-registration is not available.
                    </li>
                </ul>


                <a class="access-link" href="login.html">
                    Return to Login
                </a>
            </aside>
        </div>
    </main>


    <button class="back-to-top" id="backToTop" aria-label="Back to top" title="Back to top">

        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5l-7 7 1.4 1.4L11 8.8V20h2V8.8l4.6 4.6L19 12z">
            </path>
        </svg>
    </button>


    <script src="edubridge-api.js"></script>
    <script>
        document.body.classList.add("js");

        const toastContainer = document.createElement("div");
        toastContainer.className = "toast-container";
        document.body.append(toastContainer);

        const toastDurations =
        {
            success: 2000,
            info: 2000,
            error: 3000
        };

        const toastIcons =
        {
            success:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.1 14.9-4.2-4.2 1.4-1.4 2.8 2.8 6.6-6.6 1.4 1.4-8 8z"></path></svg>',
            error:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.3 12.9-1.4 1.4-2.9-2.9-2.9 2.9-1.4-1.4 2.9-2.9-2.9-2.9 1.4-1.4 2.9 2.9 2.9-2.9 1.4 1.4-2.9 2.9 2.9 2.9z"></path></svg>',
            info:
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"></path></svg>'
        };

        function showToast(message, type)
        {
            const kind = toastIcons[type] ? type : "info";

            while (toastContainer.children.length >= 3)
            {
                toastContainer.firstElementChild.remove();
            }

            const toast = document.createElement("div");
            toast.className = "toast toast--" + kind;
            toast.setAttribute("role", kind === "error" ? "alert" : "status");

            const icon = document.createElement("span");
            icon.className = "toast-icon";
            icon.setAttribute("aria-hidden", "true");
            icon.innerHTML = toastIcons[kind];

            const body = document.createElement("div");
            body.className = "toast-body";

            const text = document.createElement("p");
            text.className = "toast-message";
            text.textContent = message;

            body.append(text);

            const closeButton = document.createElement("button");
            closeButton.className = "toast-close";
            closeButton.type = "button";
            closeButton.setAttribute("aria-label", "Dismiss notification");
            closeButton.innerHTML =
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"></path></svg>';

            toast.append(icon, body, closeButton);
            toastContainer.append(toast);

            let dismissTimer = null;

            function dismissToast()
            {
                if (dismissTimer === null)
                {
                    return;
                }

                window.clearTimeout(dismissTimer);
                dismissTimer = null;

                toast.classList.add("toast--leaving");

                window.setTimeout(function()
                {
                    toast.remove();
                }, 250);
            }

            closeButton.addEventListener("click", dismissToast);

            window.requestAnimationFrame(function()
            {
                toast.classList.add("toast--visible");
            });

            dismissTimer = window.setTimeout(dismissToast, toastDurations[kind]);
        }

        const themeButton = document.getElementById("themeButton");
        const themeIcon = document.getElementById("themeIcon");
        const backToTop = document.getElementById("backToTop");

        function updateThemeIcon()
        {
            if (document.body.classList.contains("dark-mode"))
            {
                themeIcon.innerHTML =
                    '<path d="M21 12.8A9 9 0 0 1 11.2 3 7 7 0 1 0 21 12.8z"></path>';
            }
            else
            {
                themeIcon.innerHTML =
                    '<path d="M12 3V1m0 22v-2M4.22 4.22 2.81 2.81m18.38 18.38-1.41-1.41M3 12H1m22 0h-2M4.22 19.78l-1.41 1.41M21.19 2.81l-1.41 1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z"></path>';
            }
        }

        const savedTheme = localStorage.getItem("edubridge-theme");

        if (savedTheme === "dark")
        {
            document.body.classList.add("dark-mode");
        }

        updateThemeIcon();

        themeButton.addEventListener("click", function()
        {
            const rect = themeButton.getBoundingClientRect();

            document.body.style.setProperty(
                "--theme-x",
                rect.left + rect.width / 2 + "px"
            );

            document.body.style.setProperty(
                "--theme-y",
                rect.top + rect.height / 2 + "px"
            );

            const isCurrentlyDark =
                document.body.classList.contains("dark-mode");

            document.body.style.setProperty(
                "--theme-circle",
                isCurrentlyDark ? "#f3f3f3" : "#090817"
            );

            document.body.classList.add("theme-changing");

            setTimeout(function()
            {
                document.body.classList.toggle("dark-mode");

                const isDark =
                    document.body.classList.contains("dark-mode");

                localStorage.setItem(
                    "edubridge-theme",
                    isDark ? "dark" : "light"
                );

                updateThemeIcon();
            }, 100);

            setTimeout(function()
            {
                document.body.classList.remove("theme-changing");
            }, 750);
        });

        const hero = document.querySelector(".hero");
        const heroImage = document.querySelector(".hero-image");

        let targetX = 50;
        let targetY = 50;
        let cursorX = 50;
        let cursorY = 50;

        let purpleX = 4;
        let purpleY = 5;
        let blueX = 93;
        let blueY = 8;
        let pinkX = 15;
        let pinkY = 57;
        let violetX = 55;
        let violetY = 38;
        let orangeX = 94;
        let orangeY = 88;
        let cyanX = 5;
        let cyanY = 93;
        let pinkSmallX = 78;
        let pinkSmallY = 67;

        hero.addEventListener("mousemove", function(event)
        {
            const rect = hero.getBoundingClientRect();

            targetX =
                ((event.clientX - rect.left) / rect.width) * 100;

            targetY =
                ((event.clientY - rect.top) / rect.height) * 100;

            const moveX =
                (event.clientX - rect.left) / rect.width - 0.5;

            const moveY =
                (event.clientY - rect.top) / rect.height - 0.5;

            heroImage.style.transform =
                "scale(1.04) translate(" +
                moveX * -10 + "px, " +
                moveY * -7 + "px)";
        });

        hero.addEventListener("mouseleave", function()
        {
            targetX = 50;
            targetY = 50;

            heroImage.style.transform = "scale(1.04) translate(0, 0)";
        });

        function animateGradient()
        {
            cursorX += (targetX - cursorX) * 0.04;
            cursorY += (targetY - cursorY) * 0.04;

            const purpleTargetX = 4 + (cursorX - 50) * 0.35;
            const purpleTargetY = 5 + (cursorY - 50) * 0.25;
            const blueTargetX = 93 + (cursorX - 50) * 0.3;
            const blueTargetY = 8 + (cursorY - 50) * 0.25;
            const pinkTargetX = 15 + (cursorX - 50) * 0.5;
            const pinkTargetY = 57 + (cursorY - 50) * 0.45;
            const violetTargetX = 55 + (cursorX - 50) * 0.65;
            const violetTargetY = 38 + (cursorY - 50) * 0.55;
            const orangeTargetX = 94 + (cursorX - 50) * 0.3;
            const orangeTargetY = 88 + (cursorY - 50) * 0.35;
            const cyanTargetX = 5 + (cursorX - 50) * 0.28;
            const cyanTargetY = 93 + (cursorY - 50) * 0.25;
            const pinkSmallTargetX = 78 + (cursorX - 50) * 0.48;
            const pinkSmallTargetY = 67 + (cursorY - 50) * 0.42;

            purpleX += (purpleTargetX - purpleX) * 0.025;
            purpleY += (purpleTargetY - purpleY) * 0.025;
            blueX += (blueTargetX - blueX) * 0.02;
            blueY += (blueTargetY - blueY) * 0.02;
            pinkX += (pinkTargetX - pinkX) * 0.022;
            pinkY += (pinkTargetY - pinkY) * 0.022;
            violetX += (violetTargetX - violetX) * 0.018;
            violetY += (violetTargetY - violetY) * 0.018;
            orangeX += (orangeTargetX - orangeX) * 0.021;
            orangeY += (orangeTargetY - orangeY) * 0.021;
            cyanX += (cyanTargetX - cyanX) * 0.019;
            cyanY += (cyanTargetY - cyanY) * 0.019;
            pinkSmallX += (pinkSmallTargetX - pinkSmallX) * 0.023;
            pinkSmallY += (pinkSmallTargetY - pinkSmallY) * 0.023;

            hero.style.setProperty("--purple-x", purpleX + "%");
            hero.style.setProperty("--purple-y", purpleY + "%");
            hero.style.setProperty("--blue-x", blueX + "%");
            hero.style.setProperty("--blue-y", blueY + "%");
            hero.style.setProperty("--pink-x", pinkX + "%");
            hero.style.setProperty("--pink-y", pinkY + "%");
            hero.style.setProperty("--violet-x", violetX + "%");
            hero.style.setProperty("--violet-y", violetY + "%");
            hero.style.setProperty("--orange-x", orangeX + "%");
            hero.style.setProperty("--orange-y", orangeY + "%");
            hero.style.setProperty("--cyan-x", cyanX + "%");
            hero.style.setProperty("--cyan-y", cyanY + "%");
            hero.style.setProperty("--pink-small-x", pinkSmallX + "%");
            hero.style.setProperty("--pink-small-y", pinkSmallY + "%");

            requestAnimationFrame(animateGradient);
        }

        animateGradient();

        let audioContext;

        function playClickSound()
        {
            try
            {
                if (!audioContext)
                {
                    audioContext = new (
                        window.AudioContext ||
                        window.webkitAudioContext
                    )();
                }

                if (audioContext.state === "suspended")
                {
                    audioContext.resume();
                }

                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();

                oscillator.type = "sine";

                oscillator.frequency.setValueAtTime(
                    520,
                    audioContext.currentTime
                );

                oscillator.frequency.exponentialRampToValueAtTime(
                    300,
                    audioContext.currentTime + 0.045
                );

                gain.gain.setValueAtTime(
                    0.045,
                    audioContext.currentTime
                );

                gain.gain.exponentialRampToValueAtTime(
                    0.001,
                    audioContext.currentTime + 0.06
                );

                oscillator.connect(gain);
                gain.connect(audioContext.destination);

                oscillator.start();

                oscillator.stop(audioContext.currentTime + 0.06);
            }
            catch (error)
            {
            }
        }

        document.addEventListener("click", function(event)
        {
            const clickable =
                event.target.closest("button, a");

            if (clickable)
            {
                playClickSound();
            }
        });

        const revealItems = document.querySelectorAll(".reveal");

        const revealObserver = new IntersectionObserver(
            function(entries)
            {
                entries.forEach(function(entry)
                {
                    if (entry.isIntersecting)
                    {
                        entry.target.classList.add("visible");
                        revealObserver.unobserve(entry.target);
                    }
                });
            },
            {
                threshold: 0.12
            }
        );

        revealItems.forEach(function(item)
        {
            revealObserver.observe(item);
        });

        const cursorGradient = document.querySelector(".cursor-gradient");

        let cursorMouseX = window.innerWidth / 2;
        let cursorMouseY = window.innerHeight / 2;
        let gradientX = cursorMouseX;
        let gradientY = cursorMouseY;

        document.addEventListener("mousemove", function(event)
        {
            cursorMouseX = event.clientX;
            cursorMouseY = event.clientY;

            document.body.classList.add("cursor-ready");
        });

        function moveCursorGradient()
        {
            gradientX += (cursorMouseX - gradientX) * 0.12;
            gradientY += (cursorMouseY - gradientY) * 0.12;

            cursorGradient.style.left = gradientX + "px";
            cursorGradient.style.top = gradientY + "px";

            requestAnimationFrame(moveCursorGradient);
        }

        moveCursorGradient();

        window.addEventListener("scroll", function()
        {
            if (window.scrollY > 450)
            {
                backToTop.classList.add("show");
            }
            else
            {
                backToTop.classList.remove("show");
            }
        });

        backToTop.addEventListener("click", function()
        {
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        });

        const requestForm = document.getElementById("adminRequestForm");
        const fullNameInput = document.getElementById("fullName");
        const contactEmailInput = document.getElementById("contactEmail");
        const studentIdGroup = document.getElementById("studentIdGroup");
        const studentIdInput = document.getElementById("studentId");
        const roleGroup = document.getElementById("roleGroup");
        const roleSelect = document.getElementById("roleSelect");
        const typeSelect = document.getElementById("typeSelect");
        const requestNote = document.getElementById("requestNote");
        const messageLabel = document.getElementById("messageLabel");
        const messageInput = document.getElementById("message");

        const requestCopy =
        {
            account:
            {
                label: "Reason for Request",
                placeholder: "Tell your school administrator why you need an EduBridge account.",
                note: "An authorized administrator must create the account. Submitting this request does not create an account."
            },
            password:
            {
                label: "Issue Details",
                placeholder: "Describe the account access problem you need help with.",
                note: "Only an authorized administrator can handle password requests. Never include your password in this message."
            },
            general:
            {
                label: "Message",
                placeholder: "Write your message here...",
                note: ""
            }
        };

        function setError(inputField, errorId, message)
        {
            const errorElement = document.getElementById(errorId);
            const isInvalid = message !== "";

            errorElement.textContent = message;
            inputField.classList.toggle("is-invalid", isInvalid);
            inputField.setAttribute("aria-invalid", String(isInvalid));
        }

        function clearError(inputField, errorId)
        {
            const errorElement = document.getElementById(errorId);

            errorElement.textContent = "";
            inputField.classList.remove("is-invalid");
            inputField.removeAttribute("aria-invalid");
        }

        function isApplicable(fieldGroup)
        {
            return !fieldGroup.hidden;
        }

        function applyRequestType()
        {
            const type = typeSelect.value;
            const copy = requestCopy[type] || requestCopy.general;
            const isGeneral = type === "general";

            roleGroup.hidden = isGeneral;
            studentIdGroup.hidden =
                isGeneral || roleSelect.value !== "student";

            messageLabel.textContent = copy.label;
            messageInput.placeholder = copy.placeholder;

            if (copy.note === "")
            {
                requestNote.textContent = "";
                requestNote.hidden = true;
            }
            else
            {
                requestNote.textContent = copy.note;
                requestNote.hidden = false;
            }

            if (!isApplicable(roleGroup))
            {
                clearError(roleSelect, "roleError");
            }

            if (!isApplicable(studentIdGroup))
            {
                clearError(studentIdInput, "studentIdError");
            }
        }

        function validateFullName()
        {
            const message = fullNameInput.value.trim() === ""
                ? "Full name is required."
                : "";

            setError(fullNameInput, "fullNameError", message);
            return message === "";
        }

        function validateEmail()
        {
            const value = contactEmailInput.value.trim();
            let message = "";

            if (value === "")
            {
                message = "Contact email is required.";
            }
            else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value))
            {
                message = "Enter a valid email address.";
            }

            setError(contactEmailInput, "contactEmailError", message);
            return message === "";
        }

        function validateRole()
        {
            if (!isApplicable(roleGroup))
            {
                clearError(roleSelect, "roleError");
                return true;
            }

            const message = roleSelect.value === ""
                ? "Select a role."
                : "";

            setError(roleSelect, "roleError", message);
            return message === "";
        }

        function validateStudentId()
        {
            if (!isApplicable(studentIdGroup))
            {
                clearError(studentIdInput, "studentIdError");
                return true;
            }

            const message = studentIdInput.value.trim() === ""
                ? "Student ID is required."
                : "";

            setError(studentIdInput, "studentIdError", message);
            return message === "";
        }

        function validateMessage()
        {
            const message = messageInput.value.trim() === ""
                ? "Message is required."
                : "";

            setError(messageInput, "messageError", message);
            return message === "";
        }

        function revalidateWhileInvalid(inputField, validator)
        {
            inputField.addEventListener("input", function()
            {
                if (inputField.classList.contains("is-invalid"))
                {
                    validator();
                }
            });
        }

        fullNameInput.addEventListener("blur", validateFullName);
        contactEmailInput.addEventListener("blur", validateEmail);
        roleSelect.addEventListener("change", validateRole);
        studentIdInput.addEventListener("blur", validateStudentId);
        messageInput.addEventListener("blur", validateMessage);

        revalidateWhileInvalid(fullNameInput, validateFullName);
        revalidateWhileInvalid(contactEmailInput, validateEmail);
        revalidateWhileInvalid(studentIdInput, validateStudentId);
        revalidateWhileInvalid(messageInput, validateMessage);

        typeSelect.addEventListener("change", applyRequestType);

        roleSelect.addEventListener("change", function()
        {
            studentIdGroup.hidden =
                typeSelect.value === "general" ||
                roleSelect.value !== "student";

            if (!isApplicable(studentIdGroup))
            {
                clearError(studentIdInput, "studentIdError");
            }
        });

        requestForm.addEventListener("submit", function(event)
        {
            event.preventDefault();

            const checks =
                [
                    validateFullName(),
                    validateEmail(),
                    validateRole(),
                    validateStudentId(),
                    validateMessage()
                ];

            if (checks.includes(false))
            {
                const firstInvalid = requestForm.querySelector(".is-invalid");

                if (firstInvalid)
                {
                    firstInvalid.focus();
                }

                return;
            }

            const typeLabels =
            {
                account: "Account Request",
                password: "Password Assistance",
                general: "General Inquiry"
            };

            const requestType = typeSelect.value || "general";
            const extras = [];
            const roleField = document.getElementById("roleSelect");
            const studentIdField = document.getElementById("studentId");

            if (!document.getElementById("roleGroup").hidden && roleField.value)
            {
                extras.push("Role: " + roleField.options[roleField.selectedIndex].text);
            }

            if (!document.getElementById("studentIdGroup").hidden && studentIdField.value.trim())
            {
                extras.push("Student ID: " + studentIdField.value.trim());
            }

            let requestMessage = document.getElementById("message").value.trim();

            if (extras.length > 0)
            {
                requestMessage = extras.join("\n") + "\n\n" + requestMessage;
            }

            EduAPI.post("/backend/api/contact.php?action=submit",
            {
                type: requestType,
                name: document.getElementById("fullName").value.trim(),
                email: document.getElementById("contactEmail").value.trim(),
                subject: typeLabels[requestType] || "General Inquiry",
                message: requestMessage
            })
                .then(function(data)
                {
                    showToast(data.message || "Your request has been submitted.", "success");
                    requestForm.reset();
                    applyRequestType();
                })
                .catch(function(error)
                {
                    showToast(error.message || "Your request could not be submitted. Please try again.", "error");
                });
        });

        const requestedType =
            new URLSearchParams(window.location.search).get("type");

        if (requestedType === "account" || requestedType === "password")
        {
            typeSelect.value = requestedType;
        }

        applyRequestType();
    </script>

</body>
