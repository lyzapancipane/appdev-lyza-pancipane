			];


			const toastContainer = document.createElement("div");
			toastContainer.className = "toast-container";
			document.body.append(toastContainer);

			const toastDurations =
			{
				success: 2000,
				info: 2000,
				error: 3000
			};

			const toastIcons =
			{
				success:
					'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.1 14.9-4.2-4.2 1.4-1.4 2.8 2.8 6.6-6.6 1.4 1.4-8 8z"></path></svg>',
				error:
					'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.3 12.9-1.4 1.4-2.9-2.9-2.9 2.9-1.4-1.4 2.9-2.9-2.9-2.9 1.4-1.4 2.9 2.9 2.9-2.9 1.4 1.4-2.9 2.9 2.9 2.9z"></path></svg>',
				info:
					'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"></path></svg>'
			};

			function showToast(message, type)
			{

				const kind = toastIcons[type] ? type : "info";

				while (toastContainer.children.length >= 3)
				{
					toastContainer.firstElementChild.remove();
				}


				const toast = document.createElement("div");
				toast.className = "toast toast--" + kind;
				toast.setAttribute("role", kind === "error" ? "alert" : "status");


				const icon = document.createElement("span");
				icon.className = "toast-icon";
				icon.setAttribute("aria-hidden", "true");
				icon.innerHTML = toastIcons[kind];


				const body = document.createElement("div");
				body.className = "toast-body";

				const text = document.createElement("p");
				text.className = "toast-message";
				text.textContent = message;

				body.append(text);


				const closeButton = document.createElement("button");
				closeButton.className = "toast-close";
				closeButton.type = "button";
				closeButton.setAttribute("aria-label", "Dismiss notification");
				closeButton.innerHTML =
					'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"></path></svg>';


				toast.append(icon, body, closeButton);
				toastContainer.append(toast);


				let dismissTimer = null;

				function dismissToast()
				{

					if (dismissTimer === null)
					{
						return;
					}

					window.clearTimeout(dismissTimer);
					dismissTimer = null;

					toast.classList.add("toast--leaving");

					window.setTimeout(function()
					{
						toast.remove();
					}, 250);

				}

				closeButton.addEventListener("click", dismissToast);

				window.requestAnimationFrame(function()
				{
					toast.classList.add("toast--visible");
				});

				dismissTimer = window.setTimeout(dismissToast, toastDurations[kind]);

			}

			const faqList = document.getElementById("faqList");
			const faqStates = document.getElementById("faqStates");
			const faqCount = document.getElementById("faqCount");
			const faqSearch = document.getElementById("faqSearch");
			const faqSearchForm = document.getElementById("faqSearchForm");
			const popularSearches = document.getElementById("popularSearches");
			const categoryList = document.getElementById("categoryList");
			const sortSelect = document.getElementById("sortSelect");
			const faqPagination = document.getElementById("faqPagination");

			const pageSize = 6;

			let activeQuery = "";
			let activeCategory = "all";
			let activeSort = "relevant";
			let currentPage = 1;

			let storedFeedback = {};

			try
			{
				storedFeedback =
					JSON.parse(localStorage.getItem("edubridge-faq-feedback")) || {};
			}
			catch (error)
			{
				storedFeedback = {};
			}


			const cardIcons =
			{
				empty: "M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z",
				error: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm3.5-9.2-2.8 2.8 2.8 2.8-1.4 1.4-2.8-2.8-2.8 2.8-1.4-1.4 2.8-2.8-2.8-2.8 1.4-1.4 2.8 2.8 2.8-2.8 1.4 1.4z"
			};


			function createCard(modifier, title, text, buttonLabel, onButton)
			{

				const card =
					document.createElement("div");

				card.className =
					"state-card state-card--" + modifier;


				const icon =
					document.createElement("span");

				icon.className = "state-icon";
				icon.setAttribute("aria-hidden", "true");


				const svg =
					document.createElementNS("http://www.w3.org/2000/svg", "svg");

				svg.setAttribute("viewBox", "0 0 24 24");


				const path =
					document.createElementNS("http://www.w3.org/2000/svg", "path");

				path.setAttribute("d", cardIcons[modifier]);

				svg.append(path);
				icon.append(svg);


				const heading =
					document.createElement("h3");

				heading.className = "state-title";
				heading.textContent = title;


				const description =
					document.createElement("p");

				description.className = "state-text";
				description.textContent = text;

				card.append(icon, heading, description);


				if (buttonLabel && onButton)
				{

					const button =
						document.createElement("button");

					button.className = "state-button";
					button.type = "button";
					button.textContent = buttonLabel;

					button.addEventListener("click", onButton);

					card.append(button);

				}

				return card;

			}


			function getHaystack(faq)
			{

				const parts =
					[faq.question, faq.category, faq.keywords.join(" ")];

				faq.answer.forEach(function(segment)
				{
					parts.push(segment.text);
				});

				return parts.join(" ").toLowerCase();

			}


			function getScore(faq, query)
			{

				let score = 0;

				if (faq.question.toLowerCase().includes(query))
				{
					score += 10;
				}

				if (faq.keywords.some(function(keyword)
				{
					return keyword.toLowerCase().includes(query);
				}))
				{
					score += 5;
				}

				return score;

			}


			function getResults()
			{

				const query =
					activeQuery.trim().toLowerCase();

				let results =
					faqs.filter(function(faq)
					{

						const inCategory =
							activeCategory === "all" ||
							faq.category === activeCategory;

						if (!inCategory)
						{
							return false;
						}

						if (!query)
						{
							return true;
						}

						return getHaystack(faq).includes(query);

					});


				if (activeSort === "az")
				{

					results = results.slice().sort(function(a, b)
					{
						return a.question.localeCompare(b.question);
					});

				}
				else if (query)
				{

					results = results.slice().sort(function(a, b)
					{
						return getScore(b, query) - getScore(a, query);
					});

				}

				return results;

			}


			const feedbackIcons =
			{
				yes: "M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z",
				no: "M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
			};


			function createFeedback(faqId)
			{

				const box =
					document.createElement("div");

				box.className = "faq-feedback";


				const label =
					document.createElement("span");

				label.className = "feedback-label";
				label.textContent = "Was this answer helpful?";

				box.append(label);


				const buttons =
					{};


				[
					{ vote: "yes", text: "Yes", aria: "Yes, this answer was helpful" },
					{ vote: "no", text: "No", aria: "No, this answer was not helpful" }
				].forEach(function(config)
				{

					const button =
						document.createElement("button");

					button.className = "feedback-button";
					button.type = "button";
					button.setAttribute("aria-label", config.aria);
					button.setAttribute("aria-pressed", "false");


					const svg =
						document.createElementNS("http://www.w3.org/2000/svg", "svg");

					svg.setAttribute("viewBox", "0 0 24 24");
					svg.setAttribute("aria-hidden", "true");


					const path =
						document.createElementNS("http://www.w3.org/2000/svg", "path");

					path.setAttribute("d", feedbackIcons[config.vote]);

					svg.append(path);


					const text =
						document.createElement("span");

					text.textContent = config.text;

					button.append(svg, text);


					button.addEventListener("click", function()
					{

						const previousVote = storedFeedback[faqId];

						storedFeedback[faqId] = config.vote;

						try
						{
							localStorage.setItem(
								"edubridge-faq-feedback",
								JSON.stringify(storedFeedback)
							);
						}
						catch (error)
						{
							storedFeedback[faqId] = previousVote;
							showToast("Failed to save your feedback. Please try again.", "error");
							return;
						}

						buttons.yes.classList.remove("is-selected");
						buttons.no.classList.remove("is-selected");
						buttons.yes.setAttribute("aria-pressed", "false");
						buttons.no.setAttribute("aria-pressed", "false");

						button.classList.add("is-selected");
						button.setAttribute("aria-pressed", "true");

						thanks.hidden = false;

						showToast("Thanks for your feedback!", "success");

					});


					buttons[config.vote] = button;

					box.append(button);

				});


				const thanks =
					document.createElement("p");

				thanks.className = "feedback-thanks";
				thanks.setAttribute("aria-live", "polite");
				thanks.textContent = "Thanks for your feedback!";
				thanks.hidden = !storedFeedback[faqId];

				box.append(thanks);


				if (storedFeedback[faqId])
				{

					const selected =
						buttons[storedFeedback[faqId]];

					selected.classList.add("is-selected");
					selected.setAttribute("aria-pressed", "true");

				}

				return box;

			}


			function createFaqItem(faq, index)
			{

				const item =
					document.createElement("article");

				item.className = "faq-item";


				const heading =
					document.createElement("h3");


				const button =
					document.createElement("button");

				button.className = "faq-question";
				button.type = "button";
				button.id = "faq-question-" + index;

				button.setAttribute("aria-expanded", "false");
				button.setAttribute("aria-controls", "faq-answer-" + index);


				const label =
					document.createElement("span");

				label.textContent = faq.question;


				const toggle =
					document.createElement("span");

				toggle.className = "faq-toggle";
				toggle.setAttribute("aria-hidden", "true");

				button.append(label, toggle);
				heading.append(button);


				const wrap =
					document.createElement("div");

				wrap.className = "faq-answer-wrap";
				wrap.id = "faq-answer-" + index;

				wrap.setAttribute("role", "region");
				wrap.setAttribute("aria-labelledby", button.id);


				const inner =
					document.createElement("div");

				inner.className = "faq-answer-inner";


				const answer =
					document.createElement("div");

				answer.className = "faq-answer";


				const paragraph =
					document.createElement("p");

				faq.answer.forEach(function(segment)
				{

					if (segment.href)
					{

						const link =
							document.createElement("a");

						link.href = segment.href;
						link.textContent = segment.text;

						paragraph.append(link);

					}
					else
					{

						paragraph.append(
							document.createTextNode(segment.text)
						);

					}

				});


				const feedback =
					createFeedback(faq.id);

				answer.append(paragraph, feedback);
				inner.append(answer);
				wrap.append(inner);
				item.append(heading, wrap);


				button.addEventListener("click", function()
				{

					const open =
						item.classList.toggle("open");

					button.setAttribute(
						"aria-expanded",
						open ? "true" : "false"
					);

				});

				return item;

			}


			function renderPagination(totalPages)
			{

				faqPagination.replaceChildren();


				if (totalPages <= 1)
				{
					faqPagination.hidden = true;
					return;
				}

				faqPagination.hidden = false;


				const previous =
					document.createElement("button");

				previous.className = "page-button";
				previous.type = "button";
				previous.textContent = "Prev";

				previous.disabled = currentPage === 1;

				previous.addEventListener("click", function()
				{

					currentPage -= 1;

					renderFaqs();

				});

				faqPagination.append(previous);


				for (let page = 1; page <= totalPages; page += 1)
				{

					const number =
						document.createElement("button");

					number.className = "page-button";
					number.type = "button";
					number.textContent = String(page);

					number.setAttribute("aria-label", "Page " + page);

					if (page === currentPage)
					{
						number.classList.add("is-current");
						number.setAttribute("aria-current", "page");
					}

					number.addEventListener("click", function()
					{

						currentPage = page;

						renderFaqs();

					});

					faqPagination.append(number);

				}


				const next =
					document.createElement("button");

				next.className = "page-button";
				next.type = "button";
				next.textContent = "Next";

				next.disabled = currentPage === totalPages;

				next.addEventListener("click", function()
				{

					currentPage += 1;

					renderFaqs();

				});

				faqPagination.append(next);

			}


			function renderFaqs()
			{

				try
				{

					if (faqs.length === 0)
					{

						faqList.replaceChildren();
						faqList.hidden = true;

						faqPagination.hidden = true;
						faqCount.textContent = "0 questions";

						faqStates.hidden = false;
						faqStates.replaceChildren(
							createCard(
								"empty",
								"No Questions Yet",
								"There are no FAQ records available right now. Please check back later.",
								"Submit an Inquiry",
								function()
								{
									window.location.href = "inquiries.html";
								}
							)
						);

						return;

					}


					const results =
						getResults();

					const totalPages =
						Math.max(1, Math.ceil(results.length / pageSize));

					currentPage =
						Math.min(currentPage, totalPages);


					faqCount.textContent =
						results.length === 1
							? "1 question"
							: results.length + " questions";


					if (results.length === 0)
					{

						faqList.replaceChildren();
						faqList.hidden = true;

						faqPagination.hidden = true;

						faqStates.hidden = false;
						faqStates.replaceChildren(
							createCard(
								"empty",
								"No Matching Questions",
								"Try a different keyword or category, or clear the search to browse every question.",
								"Clear Search",
								clearSearch
							)
						);

						return;

					}


					faqStates.replaceChildren();
					faqStates.hidden = true;

					faqList.hidden = false;
					faqList.replaceChildren();


					const start =
						(currentPage - 1) * pageSize;

					results
						.slice(start, start + pageSize)
						.forEach(function(faq, offset)
						{
							faqList.append(
								createFaqItem(faq, start + offset)
							);
						});


					renderPagination(totalPages);

				}
				catch (error)
				{

					faqList.replaceChildren();
					faqList.hidden = true;

					faqPagination.hidden = true;

					faqStates.hidden = false;
					faqStates.replaceChildren(
						createCard(
							"error",
							"Unable to Load Data",
							"We can't load the FAQ list right now. Please refresh the page.",
							"Refresh Page",
							function()
							{
								window.location.reload();
							}
						)
					);

				}

			}


			function updateCategories()
			{

				const buttons =
					categoryList.querySelectorAll(".category-button");

				buttons.forEach(function(button)
				{

					const category =
						button.dataset.category;

					const count =
						category === "all"
							? faqs.length
							: faqs.filter(function(faq)
							{
								return faq.category === category;
							}).length;

					button.querySelector(".category-count").textContent =
						String(count);


					const active =
						category === activeCategory;

					button.classList.toggle("is-active", active);

					button.setAttribute(
						"aria-pressed",
						active ? "true" : "false"
					);

				});

			}


			function clearSearch()
			{

				faqSearch.value = "";

				activeQuery = "";
				activeCategory = "all";
				currentPage = 1;

				updateCategories();
				renderFaqs();

				faqSearch.focus();

			}


			faqSearchForm.addEventListener("submit", function(event)
			{

				event.preventDefault();

				activeQuery = faqSearch.value.trim();
				currentPage = 1;

				renderFaqs();

			});


			popularSearches.addEventListener("click", function(event)
			{

				const chip =
					event.target.closest(".search-chip");

				if (!chip)
				{
					return;
				}

				faqSearch.value = chip.dataset.query;

				activeQuery = chip.dataset.query.trim();
				currentPage = 1;

				renderFaqs();

			});


			categoryList.addEventListener("click", function(event)
			{

				const button =
					event.target.closest(".category-button");

				if (!button)
				{
					return;
				}

				activeCategory = button.dataset.category;
				currentPage = 1;

				updateCategories();
				renderFaqs();

			});


			sortSelect.addEventListener("change", function()
			{

				activeSort = sortSelect.value;
				currentPage = 1;

				renderFaqs();

			});


			updateCategories();
			renderFaqs();
		}
		catch (error)
		{
			document.body.classList.remove("js");
		}
	</script>
</body>
